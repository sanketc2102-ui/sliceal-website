---
// TODO(mobile): Review and adjust the legal page layout when mobile Figma frames are available.

import BaseLayout from "./BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import Breadcrumb from "../components/ui/Breadcrumb.astro";

const {
  title,
  description = "",
  lastUpdated = "",
  intro = "",
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
>
  <Header slot="header" />

  <!-- Legal page header -->
  <section
    data-reveal
    class="
      w-full
      border-b
      border-line
      bg-surface
      px-6
      pt-10
      pb-6

      lg:border-b-0
      lg:px-20
      lg:pt-14
      lg:pb-0
    "
  >
    <div
      class="
        mx-auto
        flex
        w-full
        max-w-[900px]
        flex-col
        items-center
        gap-4
        text-center
      "
    >
      <Breadcrumb trail={[{ label: title }]} />

      <h1
        class="
          text-4xl
          font-normal
          leading-tight
          tracking-tight
          text-ink

          lg:text-5xl
          lg:leading-[60px]
        "
      >
        {title}
      </h1>

      {
        lastUpdated && (
          <p class="text-sm font-normal leading-5 text-ink-muted">
            Last updated: {lastUpdated}
          </p>
        )
      }

      {
        intro && (
          <p
            class="
              w-full
              max-w-[680px]
              text-sm
              font-normal
              leading-5
              text-ink-secondary
            "
          >
            {intro}
          </p>
        )
      }
    </div>
  </section>

  <!-- Markdown content -->
  <slot />

  <Footer slot="footer" />
</BaseLayout>