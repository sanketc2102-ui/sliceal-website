---
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import Breadcrumb from "../components/ui/Breadcrumb.astro";

const {
  title,
  description = "",
  lastUpdated = "",
  intro = "",
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
>
  <Header slot="header" />

  <!-- Figma: mobile 30540:128559, tablet 30908:59398, desktop 30508:46886 -->
  <section
    class="
      w-full
      bg-surface
      px-4
      py-10

      md:p-15
      lg:p-20
    "
  >
    <div
      class="
        mx-auto
        flex
        w-full
        max-w-site
        flex-col
        gap-8

        md:gap-[50px]
      "
    >
      <!-- Legal page header -->
      <header
        data-reveal
        class="
          flex
          w-full
          flex-col
          items-center
          gap-8
          text-center

          md:gap-6
        "
      >
        <Breadcrumb trail={[{ label: title }]} />

        <div
          class="
            flex
            w-full
            flex-col
            items-center
            gap-4

            md:gap-6
          "
        >
          <h1
            class="
              text-xl
              font-semibold
              leading-xl
              tracking-normal
              text-ink

              md:text-display-sm
              md:leading-display-sm
              lg:text-display-xl
              lg:font-medium
              lg:leading-display-xl
              lg:tracking-tight
            "
          >
            {title}
          </h1>

          {
            lastUpdated && (
              <p class="text-sm font-normal leading-normal text-ink-secondary">
                Last updated: {lastUpdated}
              </p>
            )
          }

          {
            intro && (
              <p
                class="
                  w-full
                  max-w-[680px]
                  text-sm
                  font-normal
                  leading-normal
                  text-ink-secondary
                "
              >
                {intro}
              </p>
            )
          }
        </div>
      </header>

      <!-- Markdown content -->
      <slot />
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>