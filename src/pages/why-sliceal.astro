---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import WhySlicealHero from "../components/sections/WhySlicealHero.astro";
import KpiProofBar from "../components/sections/KpiProofBar.astro";
import HowSlicealWorksSteps from "../components/sections/HowSlicealWorksSteps.astro";
import BenefitsSection from "../components/sections/BenefitsSection.astro";
import PartnersSection   from "../components/sections/PartnersSection.astro";
import ConcludingCTA   from "../components/sections/ConcludingCTA.astro";
import TestimonialsSection   from "../components/sections/TestimonialsSection.astro";
import  Faq  from "../components/sections/Faq.astro";
import  OwnYouSliceSection  from "../components/sections/OwnYouSliceSection.astro";
import Footer from "../components/layout/Footer.astro";


const title = "Why Sliceal";
const description =
  "Build premium wealth with fractional real estate. Diversify across Dubai’s most sought-after properties from just AED 2,000 on a VARA-regulated platform.";
import PageUnderDevelopment from "../components/sections/PageUnderDevelopment.astro";
---

<BaseLayout title={title} description={description}>
  <Header slot="header" />
  <WhySlicealHero />
  <KpiProofBar />
  <HowSlicealWorksSteps />
  <BenefitsSection />
  <PartnersSection />
  <ConcludingCTA 
    layout="centered"
    heading="Start Your Investment Journey Today"
    subtext="Build your Dubai property portfolio in under four minutes Regulated by VARA. Verified by DLD."
    buttons={[
      { 
      label: "Start Investing", 
      href: "/start-investing", 
      variant: "primary" 
      },
       { 
          label: "Download the App", href: "#download", variant: "secondary" 
        }, 
      ]
    }
   />
  <TestimonialsSection />
  <Faq />
  <OwnYouSliceSection />

  <Footer slot="footer" />
</BaseLayout>