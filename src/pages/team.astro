---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import Breadcrumb from "../components/ui/Breadcrumb.astro";
import TeamPhotoSection from "../components/team/TeamPhotoSection.astro";

const title = "Team";
const description =
  "Meet the people behind Sliceal — a mix of strategy, creativity, and technical expertise.";
---

<BaseLayout title={title} description={description}>
  <Header slot="header" />

  <section class="bg-white pt-10 lg:pt-20">
    <div class="container-site flex flex-col items-center gap-6 text-center">
      <Breadcrumb trail={[{ label: "Team" }]} />

      <h1
        class="text-xl leading-xl font-semibold tracking-normal text-black lg:text-display-xl lg:leading-display-xl lg:font-medium lg:tracking-tight"
      >
        Meet the People Behind the Vision
      </h1>

      <p class="max-w-141 text-sm leading-normal font-normal text-gray-600">
        A thoughtful mix of strategy, creativity, and technical expertise. The
        right team to turn ideas into meaningful digital experiences.
      </p>
    </div>
  </section>

  {/* Mobile: 48px gap + 16px side gutters + 60px bottom padding around the
      photo card (Figma node 30576:134041, "Content" padding). Desktop: no
      gap needed — the photo's own bleed/fade meets the sub-copy above. */}
  <TeamPhotoSection class="mt-12 px-4 pb-15 md:mt-0 md:px-0 md:pb-0" />

  <Footer slot="footer" />
</BaseLayout>
