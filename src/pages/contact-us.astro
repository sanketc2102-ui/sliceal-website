---
// TODO(mobile): no mobile/tablet Figma yet — default state below is a
//      placeholder, not a designed layout. Revisit when frames land.

import { Image } from "astro:assets";

import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import Breadcrumb from "../components/ui/Breadcrumb.astro";
import ContactFormSection from "../components/sections/ContactFormSection.astro";
import LocationMapSection from "../components/sections/LocationMapSection.astro";

import heroBg from "../assets/contact-us/hero-bg.png";

const title = "Contact Us";
const description =
  "Meet the people behind Sliceal — a mix of strategy, creativity, and technical expertise.";
---

<BaseLayout title={title} description={description}>
  <Header slot="header" />

  {/* Figma node 26879:341441 — full-bleed photo, 65% black scrim, centered
      pill + headline + subtext. 140px/115px vertical/horizontal padding on
      the 1512 frame; the horizontal gutter is swapped for .container-site so
      the hero lines up with every section under it. */}
  <section class="relative isolate flex items-center justify-center overflow-hidden py-16 lg:py-35">
    <Image
      src={heroBg}
      alt=""
      widths={[768, 1024, 1512, 2048]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 -z-10 size-full object-cover"
    />
    <div class="absolute inset-0 -z-10 bg-black/65" aria-hidden="true"></div>

    <div class="container-site flex flex-col items-center gap-6 text-center">
      <Breadcrumb dark trail={[{ label: "Contact Us" }]} />

      <h1
        class="text-display-lg-mobile leading-tight font-medium tracking-tight text-white lg:text-display-xl lg:leading-display-xl"
      >
        Contact Our Team
      </h1>

      <p class="max-w-141 text-sm leading-normal font-normal text-white lg:text-lg lg:leading-lg">
        Join a team where innovation meets opportunity, and every idea has the
      </p>
    </div>
  </section>

  <ContactFormSection />

  <LocationMapSection />

  <Footer slot="footer" />
</BaseLayout>
