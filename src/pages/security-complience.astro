---
// TODO(mobile): no mobile/tablet Figma yet — default state below is a
//      placeholder, not a designed layout. Revisit when frames land.

import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import Breadcrumb from "../components/ui/Breadcrumb.astro";
import Section from "../components/layout/Section.astro";
import SecurityComplianceOverview from "../components/sections/SecurityComplianceOverview.astro";
import  Faq  from "../components/sections/Faq.astro";
import GlowCta from "../components/sections/GlowCta.astro";

import blobTopRight from "../assets/security-compliance/cta-blob-top-right.png";
import blobLeft from "../assets/security-compliance/cta-blob-left.png";
import blobBottomRight from "../assets/security-compliance/cta-blob-bottom-right.png";

const title = "Security & Compliance";
const description =
  "Meet the people behind Sliceal — a mix of strategy, creativity, and technical expertise.";
---

<BaseLayout title={title} description={description}>
  <Header slot="header" />

  <Section
    class="pb-0 shadow-[var(--shadow-glow)]"
    innerClass="flex flex-col items-center gap-6"
  >
    <div class="flex w-full flex-col items-center gap-6" data-reveal>
      <Breadcrumb trail={[{ label: "Security & Compliance" }]} />

      <h1
        class="text-display-lg-mobile leading-tight font-semibold tracking-tight text-ink text-center lg:text-display-xl lg:leading-display-xl lg:font-medium"
      >
        Security & Compliance
      </h1>
    </div>
  </Section>

  <SecurityComplianceOverview data-reveal />

  <Faq data-reveal />

  <GlowCta
    heading="How we protect your data"
    description="Your security is our top priority. We adhere to the highest industry standards and regulatory frameworks to ensure your data and assets are always protected. Our infrastructure is built with enterprise-grade encryption, continuous monitoring, and rigorous compliance protocols."
    buttons={[
      { label: "View Policies", href: "#" },
      { label: "Contact Security", href: "#" },
    ]}
    data-reveal
    blobs={[
      {
        src: blobTopRight,
        class:
          "absolute -right-30 -bottom-14 w-[45%] max-w-[48rem] rotate-[12deg] opacity-50 xl:-right-15",
      },
      { src: blobLeft, class: "absolute -bottom-6 -left-10 w-[35%] max-w-[33rem] opacity-50" },
      {
        src: blobBottomRight,
        class: "absolute -right-6 -bottom-8 w-[20%] max-w-[20rem] opacity-20",
      },
    ]}
  />

  <Footer slot="footer" />
</BaseLayout>
