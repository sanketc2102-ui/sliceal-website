---
// TODO(mobile): no mobile/tablet Figma yet — default state below is a
//      placeholder, not a designed layout. Revisit when frames land.

import { Image } from "astro:assets";

import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import Breadcrumb from "../components/ui/Breadcrumb.astro";
import SecurityComplianceOverview from "../components/sections/SecurityComplianceOverview.astro";
import  Faq  from "../components/sections/Faq.astro";
import GlowCta from "../components/sections/GlowCta.astro";

import heroBg from "../assets/security-compliance/hero-bg.png";
import blobTopRight from "../assets/security-compliance/cta-blob-top-right.png";
import blobLeft from "../assets/security-compliance/cta-blob-left.png";
import blobBottomRight from "../assets/security-compliance/cta-blob-bottom-right.png";

const title = "Security & Compliance";
const description =
  "Meet the people behind Sliceal — a mix of strategy, creativity, and technical expertise.";
---

<BaseLayout title={title} description={description}>
  <Header slot="header" />

  {/* Figma node 29864:72390 — full-bleed photo, 60% black scrim, centered
      pill + headline. 172px/115px vertical/horizontal padding on the 1512
      frame; the horizontal gutter is swapped for .container-site so the
      hero lines up with every section under it. */}
  <section class="relative isolate flex items-center justify-center overflow-hidden py-16 lg:py-43">
    <Image
      src={heroBg}
      alt=""
      widths={[768, 1024, 1512, 2048]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 -z-10 size-full object-cover"
    />
    <div class="absolute inset-0 -z-10 bg-black/60" aria-hidden="true"></div>

    <div class="container-site flex flex-col items-center gap-6 text-center">
      <Breadcrumb dark trail={[{ label: "Security & Compliance" }]} />

      <h1
        class="text-display-lg-mobile leading-tight font-medium tracking-tight text-white lg:text-display-xl lg:leading-display-xl"
      >
        Security & Compliance
      </h1>
    </div>
  </section>

  <SecurityComplianceOverview />

  <Faq />

  <GlowCta
    heading="How we protect your data"
    description="Your security is our top priority. We adhere to the highest industry standards and regulatory frameworks to ensure your data and assets are always protected. Our infrastructure is built with enterprise-grade encryption, continuous monitoring, and rigorous compliance protocols."
    buttons={[
      { label: "View Policies", href: "#" },
      { label: "Contact Security", href: "#" },
    ]}
    blobs={[
      {
        src: blobTopRight,
        class:
          "absolute -right-30 -bottom-14 w-[45%] max-w-[48rem] rotate-[12deg] opacity-50 xl:-right-15",
      },
      { src: blobLeft, class: "absolute -bottom-6 -left-10 w-[35%] max-w-[33rem] opacity-50" },
      {
        src: blobBottomRight,
        class: "absolute -right-6 -bottom-8 w-[20%] max-w-[20rem] opacity-20",
      },
    ]}
  />

  <Footer slot="footer" />
</BaseLayout>
