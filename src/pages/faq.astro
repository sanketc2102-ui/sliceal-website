---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import  Faq  from "../components/sections/Faq.astro";
import  Breadcrumb  from "../components/ui/Breadcrumb.astro";
import  Section  from "../components/layout/Section.astro";

const title = "Frequently Asked Questions";
const description =
  "Find answers to common questions about Sliceal, investing, tokenised real estate, payments, ownership and more.";
---

<BaseLayout title={title} description={description}>
  <Header slot="header" />

   <Section
      surface="alt"
      flush
      class="border-b border-gray-200 bg-white"
      data-reveal
    >
      <div class="flex flex-col items-center gap-4 py-10 text-center lg:py-14">
        <Breadcrumb trail={[{ label: 'FAQs' }]} />

        <h1 class="text-4xl font-medium leading-tight tracking-tight text-black lg:text-5xl">
          Frequently Asked Questions
        </h1>
      </div>
    </Section>

    <Section
      surface="alt"
      flush
      class="border-b border-gray-200 bg-white"
      data-reveal
    >

      <Faq
      eyebrow="QUESTIONS"
      title="Frequently asked."
      />
    </Section>
    
  <Footer />
</BaseLayout>