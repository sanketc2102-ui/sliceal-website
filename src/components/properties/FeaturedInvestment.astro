const properties = [
  {
    image: burjAlArab,
    location: 'Palm Jumeirah, Dubai',
    title: 'Two Bedroom Apartment in Burj Al Arab',
    roi: '8.2%',
    tokenPrice: 'AED 2.00/Token',
    funded: 'AED 550k',
    total: '650k',
    fundingPercentage: 85,
    area: '1,250 sqm',
    type: 'Apt',
    bedrooms: '2',
    bathrooms: '3',
    status: 'Closes soon',
  },
  {
    image: jbr,
    location: 'Jumeirah, Dubai',
    title: 'One Bedroom Apartment in JBR',
    roi: '9.2%',
    tokenPrice: 'AED 1.90/Token',
    funded: 'AED 240k',
    total: '550k',
    fundingPercentage: 44,
    area: '650 sqm',
    type: 'Apt',
    bedrooms: '1',
    bathrooms: '1',
    status: 'Closes soon',
  },
  {
    image: damacHills,
    location: 'DAMAC Hills, Dubai',
    title: 'Five Bedroom Villa in DAMAC Hills',
    roi: '7.2%',
    tokenPrice: 'AED 2.10/Token',
    funded: 'AED 350k',
    total: '990k',
    fundingPercentage: 35,
