---
import Carousel from "../ui/Carousel.astro";
import Section from "../layout/Section.astro";
import PropertyListingCard from "./PropertyListingCard.astro";
import { properties } from "../../data/properties.js";
import palmJumeirah from "../../assets/properties-imgs/featured-palm-jumeirah.png";
import jlt from "../../assets/properties-imgs/featured-jlt.png";
import businessBay from "../../assets/properties-imgs/featured-business-bay.png";

// Same three listings at every breakpoint, with this section's own photos.
const featuredImages = [palmJumeirah, jlt, businessBay];
const featured = properties
  .slice(0, featuredImages.length)
  .map((property, index) => ({ ...property, image: featuredImages[index] }));
---

<Section surface="alt" {...Astro.props}>
  <div class="flex flex-col gap-6 md:gap-8 lg:gap-10.5">
    <!-- Header -->
    <div class="flex flex-col gap-4 md:gap-6">
      <!-- Eyebrow -->
      <div class="flex justify-center md:justify-start">
        <span
          class="rounded-pill border border-line px-3 py-1.5 text-xs font-bold text-text-brand dark:border-white md:text-sm/5 md:font-semibold md:uppercase md:shadow-pill"
        >
          Properties
        </span>
      </div>

      <!-- Title + CTA -->
      <div
        class="flex flex-col items-center gap-4 md:flex-row md:flex-wrap md:items-center md:justify-between md:gap-x-6"
      >
        <h2
          class="text-center text-display-xs font-semibold tracking-normal text-ink md:text-left md:text-display-sm lg:text-display-lg lg:font-medium lg:tracking-tight"
        >
          Featured Investment Opportunity
        </h2>

        <a
          href="#download"
          class="hidden shrink-0 rounded-xl border border-zinc-300 px-5 py-3 text-base font-semibold leading-6 text-text-brand shadow-xs transition-colors hover:border-border-brand hover:bg-surface-selected md:block"
        >
          Download the App to View All Properties
        </a>
      </div>
    </div>

    <!-- Cards -->
    <Carousel showDots showArrows controlsClass="lg:hidden">
      {
        featured.map((property) => (
          <div class="w-full shrink-0 md:w-[calc(50%-12px)] lg:w-[calc((100%-48px)/3)]">
            <PropertyListingCard property={property} />
          </div>
        ))
      }
    </Carousel>
  </div>
</Section>
