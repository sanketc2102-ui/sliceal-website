---

<!-- <section
  class="overflow-hidden px-4 py-12 shadow-[0px_4px_200px_0px_rgba(232,249,247,0.20)] md:px-20 md:py-20"
> -->

<Section surface="alt" flush class="py-12 xl:py-30">


  <div class="flex flex-col gap-6 md:gap-10">
    <!-- Header -->
    <div class="flex flex-col gap-4 md:gap-6">
      <!-- Eyebrow -->
      <div class="flex justify-center md:justify-start">
        <span
          class="rounded-[40px] border border-gray-200 px-3 py-1.5 text-xs text-indigo-500 md:text-sm"
        >
          PROPERTIES
        </span>
      </div>

      <!-- Title + CTA -->
      <div
        class="flex flex-col items-center gap-4 md:flex-row md:items-center md:justify-between"
      >
        <h2
          class="text-center text-2xl font-normal leading-8 text-black md:text-left md:text-5xl md:leading-[60px]"
        >
          Featured Investment Opportunity
        </h2>

        <a
          href="/properties"
          class="hidden rounded-xl border border-zinc-300 px-5 py-3 text-base font-semibold leading-6 text-indigo-500 md:block"
        >
          View all Properties
        </a>
      </div>
    </div>

    <!-- Cards -->
    <!-- <PropertyCarousel properties={properties} /> -->
     <!-- <Carousel  properties={properties}/> -->
      <Carousel showDots>
  {
    properties.map((property) => (
      <PropertyCard property={property} />
    ))
  }
</Carousel>
      
  </div>
<!-- </section> -->
 </Section>