---
import MediaCard from "../cards/MediaCard.astro";
import AreaIcon from "../../assets/icons/properties/area.svg";
import ApartmentIcon from "../../assets/icons/properties/apartment-type.svg";
import BedroomsIcon from "../../assets/icons/properties/bedrooms.svg";
import BathroomsIcon from "../../assets/icons/properties/bathrooms.svg";
import LocationPinIcon from "../../assets/icons/properties/location-pin.svg";
import TrendArrowIcon from "../../assets/icons/properties/trend-arrow.svg";
import InfoIcon from "../../assets/icons/properties/info.svg";
import RentedIcon from "../../assets/icons/bedroom_parent.svg";
import FundedIcon from "../../assets/icons/green-fire.svg";

const { property } = Astro.props;

const tagTone = {
  neutral: { bg: "bg-brand-50", text: "text-brand-600", Icon: RentedIcon },
  success: { bg: "bg-success-50", text: "text-success-600", Icon: FundedIcon },
};

const stats = [
  { Icon: AreaIcon, label: property.area },
  { Icon: ApartmentIcon, label: property.type },
  { Icon: BedroomsIcon, label: property.bedrooms },
  { Icon: BathroomsIcon, label: property.bathrooms },
];
---

<article class="h-full w-full" data-reveal>
  <MediaCard image={property.image} alt={property.title}>
    <Fragment slot="bottomOverlay">
      <div class="flex gap-2 overflow-hidden">
        {
          stats.map(({ Icon, label }) => (
            <span class="inline-flex h-8 shrink-0 items-center gap-1.5 rounded-2xl border border-white/20 bg-white/20 px-3 text-xs font-medium text-white backdrop-blur-sm">
              <Icon class="size-3.5 shrink-0" aria-hidden="true" />
              {label}
            </span>
          ))
        }
      </div>
    </Fragment>

    <div class="flex flex-col gap-3">
      <div class="flex items-center justify-between gap-2">
        <span class="flex min-w-0 items-center gap-1.5">
          <LocationPinIcon class="size-3.5 shrink-0" aria-hidden="true" />
          <span class="truncate text-sm text-ink-secondary">{property.location}</span>
        </span>

        <span class="flex shrink-0 items-center gap-2">
          {
            property.tags.map((tag) => {
              const tone = tagTone[tag.tone] ?? tagTone.success;
              const TagIcon = tone.Icon;
              return (
                <span class:list={["inline-flex items-center gap-1 rounded-lg px-2 py-1", tone.bg]}>
                  <TagIcon class="size-3 shrink-0" aria-hidden="true" />
                  <span class:list={["whitespace-nowrap text-xs font-bold", tone.text]}>{tag.label}</span>
                </span>
              );
            })
          }
        </span>
      </div>

      <h3 class="text-lg font-bold leading-7 text-ink">{property.title}</h3>
    </div>

    <div class="flex flex-col gap-3">
      <div class="flex items-center justify-between">
        <p class="text-sm text-ink-secondary">{property.priceLabel}</p>
        <p class="text-sm font-semibold text-ink">{property.listedPrice}</p>
      </div>

      <div class="flex items-center justify-between">
        <p class="text-sm text-ink-secondary">Current Valuation</p>
        <span class="flex items-center gap-3">
          <p class="text-sm font-semibold text-ink">{property.currentValuation}</p>
          <span class="inline-flex items-center gap-0.5 rounded-full border border-[#d1fadf] bg-[#f6fef9] px-1.5 py-0.5 text-2xs text-success-600">
            <TrendArrowIcon class="size-3 -rotate-90" aria-hidden="true" />
            {property.valuationChange}
          </span>
        </span>
      </div>

      <div class="flex items-center justify-between">
        <span class="flex items-center gap-1.5">
          <p class="text-sm text-ink-secondary">Projected ROI</p>
          <InfoIcon class="size-5" aria-hidden="true" />
        </span>
        <p class="text-sm font-semibold text-ink">{property.projectedRoi}</p>
      </div>

      <div class="flex items-center justify-between">
        <span class="flex items-center gap-1.5">
          <p class="text-sm text-ink-secondary">Gross Rental Yield</p>
          <InfoIcon class="size-5" aria-hidden="true" />
        </span>
        <p class="text-sm font-semibold text-ink">{property.grossRentalYield}</p>
      </div>
    </div>
  </MediaCard>
</article>
