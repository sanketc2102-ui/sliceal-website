---




const { property } = Astro.props;
---

<article
  class="property-card group w-full shrink-0 overflow-hidden rounded-3xl border border-slate-200/60 bg-white shadow-[0px_1px_2px_-1px_rgba(0,0,0,0.10),0px_1px_3px_0px_rgba(0,0,0,0.10)] sm:w-[384px] md:w-[calc(50%-12px)] lg:w-[384px]"
>
  <!-- Image -->
  <div class="relative h-56 overflow-hidden">
    <img
      src={property.image.src}
      alt={property.title}
      class="absolute inset-0 h-full w-full object-cover transition-transform duration-200 ease-out group-hover:scale-105"
      loading="lazy"
    />

    <!-- Image overlay -->
    <div
      class="absolute inset-0 bg-linear-to-t from-black/30 via-transparent to-black/20"
    ></div>

    <!-- Premium -->
    <div
      class="absolute left-4 top-4 inline-flex h-7 items-center gap-1.5 rounded-full border border-white/20 bg-white/20 px-3 py-1.5 backdrop-blur-sm"
    >
      <span class="size-1.5 rounded-full bg-white/50"></span>
      <span class="text-[10px] font-bold text-white">
        PREMIUM
      </span>
    </div>

    <!-- Bookmark -->
    <button
      type="button"
      aria-label={`Save ${property.title}`}
      class="absolute right-4 top-4 flex size-9 items-center justify-center rounded-full bg-neutral-50 shadow-sm"
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        class="size-5"
        aria-hidden="true"
      >
        <path
          d="M6 4.75A2.75 2.75 0 0 1 8.75 2h6.5A2.75 2.75 0 0 1 18 4.75V21l-6-3.75L6 21V4.75Z"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linejoin="round"
        />
      </svg>
    </button>

    <!-- Image metadata -->
    <div class="absolute bottom-4 left-4 flex gap-2 overflow-hidden">
      <span class="inline-flex h-8 shrink-0 items-center rounded-2xl border border-white/20 bg-white/20 px-3 text-xs text-white backdrop-blur-sm">
        {property.area}
      </span>

      <span class="inline-flex h-8 shrink-0 items-center rounded-2xl border border-white/20 bg-white/20 px-3 text-xs text-white backdrop-blur-sm">
        {property.type}
      </span>

      <span class="inline-flex h-8 shrink-0 items-center rounded-2xl border border-white/20 bg-white/20 px-3 text-xs text-white backdrop-blur-sm">
        {property.bedrooms}
      </span>

      <span class="inline-flex h-8 shrink-0 items-center rounded-2xl border border-white/20 bg-white/20 px-3 text-xs text-white backdrop-blur-sm">
        {property.bathrooms}
      </span>
    </div>
  </div>

  <!-- Content -->
  <div class="flex flex-col gap-6 p-5">
    <div class="flex flex-col gap-5">
      <!-- Location -->
      <div class="flex flex-col gap-3">
        <div class="flex items-center justify-between gap-3">
          <div class="flex min-w-0 items-center gap-1.5">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              class="size-3.5 shrink-0 text-indigo-500"
              aria-hidden="true"
            >
              <path
                d="M20 10.5c0 5.5-8 11-8 11s-8-5.5-8-11a8 8 0 1 1 16 0Z"
                stroke="currentColor"
                stroke-width="1.5"
              />
              <circle
                cx="12"
                cy="10.5"
                r="2.5"
                stroke="currentColor"
                stroke-width="1.5"
              />
            </svg>

            <span class="truncate text-sm leading-5 text-gray-600">
              {property.location}
            </span>
          </div>

          {property.status && (
            <span
              class="shrink-0 rounded-lg bg-yellow-50 px-2 py-1 text-xs font-bold leading-4 text-amber-600"
            >
              {property.status}
            </span>
          )}
        </div>

        <!-- Title -->
        <h3 class="text-lg font-bold leading-7 text-slate-900">
          {property.title}
        </h3>
      </div>

      <!-- ROI / Token -->
      <div class="grid grid-cols-2 gap-3">
        <div class="rounded-2xl border border-slate-100 bg-slate-50 p-3">
          <p class="text-[10px] font-bold text-slate-400">
            PROJECTED ROI
          </p>

          <p class="mt-1 text-base font-bold leading-6 text-emerald-600">
            {property.roi}
          </p>
        </div>

        <div class="rounded-2xl border border-slate-100 bg-slate-50 p-3">
          <p class="text-[10px] font-bold text-slate-400">
            TOKEN PRICE
          </p>

          <p class="mt-1 whitespace-nowrap text-base font-bold leading-6 text-gray-900">
            {property.tokenPrice}
          </p>
        </div>
      </div>

      <!-- Funding -->
      <div class="flex flex-col gap-2">
        <div class="flex items-center justify-between gap-3">
          <span class="text-[10px] font-bold text-slate-400">
            FUNDING PROGRESS
          </span>

          <span class="text-xs leading-4">
            <strong class="font-bold text-slate-900">
              {property.funded}
            </strong>
            <span class="text-slate-400">
              of {property.total}
            </span>
          </span>
        </div>

        <div class="h-1.5 overflow-hidden rounded-full bg-neutral-100">
          <div
            class="h-full rounded-full bg-emerald-500"
            style={`width: ${property.fundingPercentage}%`}
          ></div>
        </div>
      </div>
    </div>

    <!-- Button -->
    <button
      type="button"
      class="h-11 w-full rounded-xl border border-zinc-300 bg-white px-4 py-2.5 text-sm leading-5 text-gray-700"
    >
      View Details
    </button>
  </div>
</article>