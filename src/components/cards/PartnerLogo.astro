---
import { Image } from "astro:assets";

const { src, alt } = Astro.props;
---

<div
  class="
    flex
    h-16
    w-28
    shrink-0
    items-center
    justify-center
    rounded-xl
    border
    border-line
    bg-surface-fixed
    p-3
    shadow-xs

    md:h-24
    md:w-40
    md:rounded-[192px]
    md:border-0
    md:p-0
    md:shadow-float

    lg:h-32
    lg:w-52
  "
>
  <Image
    src={src}
    alt={alt}
    class="h-10 w-16 object-contain md:h-10 md:w-20 lg:h-11 lg:w-24"
  />
</div>