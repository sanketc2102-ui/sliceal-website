---
import { Image } from "astro:assets";

const { src, alt } = Astro.props;
---

<div
  class="
    flex
    h-16
    w-28
    shrink-0
    items-center
    justify-center
    rounded-xl
    border
    border-gray-200
    bg-white
    p-3
    shadow-xs

    lg:h-32
    lg:w-full
    lg:rounded-[192px]
    lg:border-0
    lg:p-0
    lg:shadow-float
  "
>
  <Image
    src={src}
    alt={alt}
    class="h-10 w-16 object-contain lg:h-11 lg:w-24"
  />
</div>