---

// import Image from 'astro/components/Image.astro';
import Card from './Card.astro'

const {
  icon,
  title,
  description,
  value,
  label,
  countable = true,
} = Astro.props;

import { Image } from "astro:assets";

---



<Card
  class="
    flex
    flex-col
    items-start
    gap-6
    p-4

    md:h-[354px]
    md:justify-between
    md:p-4
  "
>
  <div class="flex w-full items-start gap-4 md:flex-col md:gap-6">
    <div
      class="
        flex
        items-start
        rounded-xl
        bg-indigo-50
        p-3
      "
    >
      <Image
        src={icon}
        alt=""
        aria-hidden="true"
        class="size-6"
      />
    </div>

    <div class="flex min-w-0 flex-1 flex-col items-start gap-3 md:w-full">
      <h3
        class="
          w-full
          text-lg
          font-semibold
          leading-7
          text-ink

          md:text-xl
          md:leading-xl
          md:font-semibold
        "
      >
        {title}
      </h3>

      <p
        class="
          w-full
          max-w-prose
          text-xs
          font-normal
          leading-xs
          text-ink-muted

          md:text-sm
          md:leading-5
        "
      >
        {description}
      </p>
    </div>
  </div>

  <div
    class="
      flex
      w-full
      flex-wrap
      items-center
      gap-2
      border-t
      border-line
      pt-4

      md:flex-col
      md:flex-nowrap
      md:items-start
    "
  >
    <div
      class="
        text-2xl
        font-semibold
        leading-8
        text-indigo-600

        md:w-full
      "
      data-count={countable ? true : undefined}
    >
      {value}
    </div>

    <p
      class="
        text-xs
        font-normal
        leading-xs
        text-ink-muted

        md:w-full

        md:leading-xs
      "
    >
      {label}
    </p>
  </div>
</Card>

