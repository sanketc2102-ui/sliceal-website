---
import MediaCard from "../cards/MediaCard.astro";
import CalendarIcon from "../../assets/icons/calendar_month.svg";
import FlameIcon from "../../assets/icons/flame-outline.svg";

const { post } = Astro.props;
---

<article class="w-full" data-blog-card data-category={post.category} data-reveal>
  <MediaCard image={post.image} alt={post.title}>
    <div class="flex flex-col gap-5">
      <div class="flex items-center justify-between gap-3">
        <div class="flex items-center gap-1.5">
          <CalendarIcon class="size-[18px]" aria-hidden="true" />
          <span class="text-sm leading-sm font-semibold text-gray-500">{post.date}</span>
        </div>

        <span class="inline-flex shrink-0 items-center gap-1 rounded-sm bg-yellow-50 px-2 py-1">
          <FlameIcon class="size-3" aria-hidden="true" />
          <span class="text-xs leading-xs font-bold whitespace-nowrap text-warning-600">
            {post.category}
          </span>
        </span>
      </div>

      <div class="flex flex-col gap-3">
        <h3 class="text-lg leading-lg font-bold text-slate-950">{post.title}</h3>
        <p class="text-[13px] leading-sm text-gray-700">{post.excerpt}</p>
      </div>
    </div>

    <button
      type="button"
      class="flex h-11 w-full items-center justify-center rounded-xl border border-gray-300 text-sm leading-sm font-semibold text-gray-700 transition-colors hover:bg-gray-25"
    >
      View Details
    </button>
  </MediaCard>
</article>
