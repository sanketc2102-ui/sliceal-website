---
/**
 * HowYouEarnSection — "How You Earn" 4-card grid on /sell-your-property.
 *
 * Figma: wBTbnZ7DJMzQwgaGC5k0wK
 *   Desktop: node 30732:150581 (Benefits-Section, 1512 frame) — 2x2 equal grid.
 *   Mobile:  node 30732:151563 (Content, 440 frame) — single column, 24px gap.
 *
 * Same card language as cards/IconTextCard.astro's "bordered" variant (used by
 * BenefitsSection on /why-sliceal: border-line, bg-white, shadow-xs, bg-brand-25
 * icon box, text-lg→xl:text-xl title). Not reused directly because that
 * variant's padding (p-6 xl:p-8) is a guessed mobile placeholder — this page
 * has a real mobile frame calling for p-4 xl:p-8.
 */
import Section from "../layout/Section.astro";
import { Image } from "astro:assets";

import creditCardIcon from "../../assets/icons/sell-your-property/credit-card.svg";
import tagIcon from "../../assets/icons/sell-your-property/tag.svg";
import barChart2Icon from "../../assets/icons/sell-your-property/bar-chart-2.svg";
import refreshCwIcon from "../../assets/icons/sell-your-property/refresh-cw.svg";

const earnings = [
  {
    icon: creditCardIcon,
    title: "Receive Funds as Investors Buy",
    description:
      "Capital is released to your wallet as fractions are purchased, providing immediate liquidity.",
  },
  {
    icon: tagIcon,
    title: "Set Your Own Pricing",
    description:
      "Work with our valuation experts to determine the optimal token price for your asset.",
  },
  {
    icon: barChart2Icon,
    title: "Track Earnings in Real-Time",
    description:
      "Monitor your property's performance and investor activity through our secure dashboard.",
  },
  {
    icon: refreshCwIcon,
    title: "Flexible Withdrawal Options",
    description:
      "Choose when and how you receive your capital, with transparent fee structures.",
  },
];
---

<Section
  flush
  surface="alt"
  class="py-10 xl:py-20"
  innerClass="flex flex-col items-center gap-6 xl:gap-12"
>
  <div class="flex flex-col items-center gap-3 text-center">
    <h2 class="text-lg leading-lg font-semibold text-ink xl:text-display-lg xl:leading-display-lg xl:font-medium xl:tracking-tight">
      How You Earn
    </h2>
    <p class="text-sm leading-sm text-ink-muted">
      A transparent and flexible earning model designed for property owners.
    </p>
  </div>

  <ul class="m-0 grid w-full list-none grid-cols-1 gap-6 p-0 xl:grid-cols-2">
    {
      earnings.map(({ icon, title, description }) => (
        <li class="flex flex-col items-start gap-4 rounded-xl border border-line bg-white p-4 shadow-xs xl:p-8">
          <span class="flex shrink-0 rounded-lg bg-brand-25 p-3">
            <Image src={icon} alt="" aria-hidden="true" width={24} height={24} class="size-6" />
          </span>

          <div class="flex flex-col gap-2">
            <h3 class="text-lg leading-lg font-semibold text-ink xl:text-xl xl:leading-xl">
              {title}
            </h3>
            <p class="text-sm leading-sm text-ink-muted">{description}</p>
          </div>
        </li>
      ))
    }
  </ul>
</Section>
