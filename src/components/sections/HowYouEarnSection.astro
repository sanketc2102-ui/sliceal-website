---
/**
 * HowYouEarnSection — "How You Earn" 4-card grid on /sell-your-property.
 *
 * Figma: wBTbnZ7DJMzQwgaGC5k0wK
 *   Desktop: node 30732:150581 (Benefits-Section, 1512 frame) — 2x2 equal grid.
 *   Mobile:  node 30732:151563 (Content, 440 frame) — single column, 24px gap.
 *
 * Same card language as cards/IconTextCard.astro's "bordered" variant (used by
 * BenefitsSection on /why-sliceal: border-line, bg-white, shadow-xs, bg-brand-25
 * icon box, text-lg→lg:text-xl title). Not reused directly because that
 * variant's padding (p-6 lg:p-8) is a guessed mobile placeholder — this page
 * has a real mobile frame calling for p-4 lg:p-8.
 */
import Section from "../layout/Section.astro";
import { Image } from "astro:assets";

import creditCardIcon from "../../assets/icons/sell-your-property/credit-card.svg";
import tagIcon from "../../assets/icons/sell-your-property/tag.svg";
import barChart2Icon from "../../assets/icons/sell-your-property/bar-chart-2.svg";
import refreshCwIcon from "../../assets/icons/sell-your-property/refresh-cw.svg";

const earnings = [
  {
    icon: creditCardIcon,
    title: "Paid in Full on Completion",
    description:
      "Your sale price is settled in a single payment once the offering completes and the DLD title transfer is done - no chasing individual buyers.",
  },
  {
    icon: tagIcon,
    title: "Transparent, Valuation-Backed Pricing",
    description:
      "Your listing price is set with our team, backed by independent valuation and DLD data-credible to investors from day one.",
  },
  {
    icon: barChart2Icon,
    title: "Track Your Listing in Real Time",
    description:
      "Follow your listing's funding progress and investor activity in real time through your seller dashboard.",
  },
  {
    icon: refreshCwIcon,
    title: "Clear Settlement",
    description:
      "The sale proceeds are settled to you after a small platform fee, agreed before you list - no hidden charges.",
  },
];

// Reveal is applied per-card below (same convention as BarriersSection.astro)
// so the 4 earnings cascade in one after another instead of popping as one
// block — the page-supplied data-reveal is consumed here, not forwarded.
const { "data-reveal": _dataReveal, ...rest } = Astro.props;
---

<Section
  flush
  surface="alt"
  class="py-10 lg:py-20"
  innerClass="flex flex-col items-center gap-6 lg:gap-12"
  {...rest}
>
  <div class="flex flex-col items-center gap-3 text-center" data-reveal>
    <h2 class="text-lg leading-lg font-semibold text-ink lg:text-display-lg lg:leading-display-lg lg:font-medium lg:tracking-tight">
      How You Earn
    </h2>
    <p class="text-sm leading-sm text-ink-muted">
      A transparent and flexible earning model designed for property owners.
    </p>
  </div>

  <ul class="m-0 grid w-full list-none grid-cols-1 gap-6 p-0 md:grid-cols-2 lg:grid-cols-2">
    {
      earnings.map(({ icon, title, description }) => (
        <li class="flex flex-col items-start gap-4 rounded-xl border border-line bg-white p-4 shadow-xs lg:p-8" data-reveal>
          <span class="flex shrink-0 rounded-lg bg-brand-25 p-3">
            <Image src={icon} alt="" aria-hidden="true" width={24} height={24} class="size-6" />
          </span>

          <div class="flex flex-col gap-2">
            <h3 class="text-lg leading-lg font-semibold text-ink lg:text-xl lg:leading-xl">
              {title}
            </h3>
            <p class="text-sm leading-sm text-ink-muted">{description}</p>
          </div>
        </li>
      ))
    }
  </ul>
</Section>
