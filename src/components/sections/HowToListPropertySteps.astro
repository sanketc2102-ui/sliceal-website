---
/**
 * HowToListPropertySteps — "How to List Your Property" 4-step band on
 * /sell-your-property.
 *
 * Figma: wBTbnZ7DJMzQwgaGC5k0wK
 *   Desktop: node 30732:150172 (Hero, 1512 frame) — 4 cards fused into one
 *     strip: only the first (16px) and last (12px) corners are rounded.
 *   Mobile:  node 30732:151490 (Content, 440 frame) — 4 standalone cards,
 *     each fully rounded (16px), stacked with an 18px gap.
 *
 * The eyebrow pill and the fused-strip corner treatment (first lg:rounded-l-xl,
 * last lg:rounded-r-lg, middles lg:rounded-none) are the same pattern
 * SecurityComplianceOverview.astro uses — reused verbatim.
 *
 * No tablet artboard exists for the fused strip, so 768–1023px gets a plain
 * 2-up grid of the mobile's standalone rounded cards (matching the
 * md:grid-cols-2 step every 3+-column grid on the site uses) rather than
 * jumping straight from one column to four.
 */
import Section from "../layout/Section.astro";
import { Image } from "astro:assets";

import fileTextIcon from "../../assets/icons/sell-your-property/file-text.svg";
import checkCircleIcon from "../../assets/icons/sell-your-property/check-circle.svg";
import rocketIcon from "../../assets/icons/sell-your-property/rocket.svg";
import walletIcon from "../../assets/icons/sell-your-property/wallet.svg";

const steps = [
  {
    icon: fileTextIcon,
    title: "Submit Property Details",
    description:
      "Provide basic property information and upload your title deed and ownership documents.",
  },
  {
    icon: checkCircleIcon,
    title: "Verification & Valuation",
    description:
      "We verify your ownership, documents,and property against DLD records, with an independent valuation to prepare your listing.Our team verifies your documents and provides a professional valuation report.",
  },
  {
    icon: rocketIcon,
    title: "Property Goes Live",
    description:
      "Your property is published on the Sliceal platform, where verified investors can view it and start investing.",
  },
  {
    icon: walletIcon,
    title: "Get Paid on Completion",
    description:
      "Once your property is fully funded and the DLD title transfer is complete, the sale price is settled directly with you.",
  },
];
---

<Section
  flush
  class="py-10 shadow-[var(--shadow-glow)] lg:py-20"
  innerClass="flex flex-col items-center gap-8 lg:items-start lg:gap-7"
  {...Astro.props}
>
  <div class="flex w-full flex-col items-center gap-6 text-center lg:items-start lg:text-left">
    <p class="rounded-pill border border-line px-3 py-1.5 text-sm leading-sm font-semibold text-brand shadow-pill">
      Regulated · VARA licensed · DLD registered
    </p>

    <h2 class="text-lg leading-lg font-semibold text-ink lg:text-display-lg lg:leading-display-lg lg:font-medium lg:tracking-tight">
      How to List Your Property
    </h2>

    <p class="text-sm leading-sm text-ink-muted lg:text-lg lg:leading-lg">
      A simple, transparent process to get your property in front of global capital.
    </p>
  </div>

  <ol class="m-0 grid w-full list-none grid-cols-1 gap-[1.125rem] p-0 md:grid-cols-2 lg:grid-cols-4 lg:gap-0">
    {
      steps.map(({ icon, title, description }, i) => (
        <li
          class:list={[
            "flex flex-col gap-4 rounded-xl border border-line bg-white p-4 lg:gap-[1.125rem] lg:rounded-none lg:p-[1.875rem]",
            i === 0 && "lg:rounded-l-xl",
            i === steps.length - 1 && "lg:rounded-r-lg",
          ]}
        >
          <div class="flex w-full items-center justify-between">
            <span class="flex shrink-0 rounded-lg bg-brand-50 p-3">
              <Image src={icon} alt="" aria-hidden="true" width={24} height={24} class="size-6" />
            </span>

            <span class="text-xs leading-xs font-bold whitespace-nowrap text-brand">
              STEP {String(i + 1).padStart(2, "0")}
            </span>
          </div>

          <div class="flex flex-col gap-3">
            <h3 class="text-lg leading-lg font-semibold text-[#0c0626] lg:text-display-xs lg:leading-display-xs lg:font-medium">
              {title}
            </h3>
            <p class="text-xs leading-xs text-ink-secondary lg:text-[0.9375rem] lg:leading-normal">
              {description}
            </p>
          </div>
        </li>
      ))
    }
  </ol>
</Section>
