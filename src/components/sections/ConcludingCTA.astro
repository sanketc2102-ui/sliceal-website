---
import Section from "../layout/Section.astro";
---

<Section
  class="shadow-[0px_4px_200px_0px_rgba(232,249,247,0.20)]"
  innerClass="flex flex-col items-center"
>
  <div
    class="
      w-full
      overflow-hidden
      rounded-xl
      bg-linear-to-br from-brand-800 to-brand-600
      p-8
      md:rounded-2xl
      md:p-10
    "
  >
    <div
      class="
        flex
        flex-col
        items-stretch
        gap-6
        md:flex-row
        md:items-center
        md:justify-between
        md:gap-8
      "
    >
      <h2
        class="
          text-center
          font-display
          text-display-xs
          font-normal
          text-white
          md:max-w-[565px]
          md:text-left
          md:text-display-lg
        "
      >
        <span class="text-mint-500">Everyone </span>
        <span>Deserves a slice, We Make Sure </span>
        <span class="text-mint-500">It’s Possible.</span>
      </h2>

      <a
        href="#"
        class="
          flex
          h-12
          w-full
          shrink-0
          items-center
          justify-center
          rounded-lg
          border
          border-gray-300
          bg-white
          px-5
          py-3
          text-md
          font-semibold
          text-gray-700
          shadow-xs
          md:w-44
        "
      >
        Start Investing
      </a>
    </div>
  </div>
</Section>