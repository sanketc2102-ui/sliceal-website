---
/**
 * ConcludingCTA — reusable purple gradient CTA banner.
 *
 * Same gradient-card structure shows up three times in the designs, each
 * with different copy/buttons. Instead of three components, this is one,
 * driven by props. Defaults match the original homepage banner exactly, so
 * <ConcludingCTA /> with no props is unchanged.
 *
 * layout="split" (default) — heading left, one button to the right, on
 *   desktop; matches the "Everyone Deserves a slice" banner. Supports
 *   per-word color highlights via the `heading` array form.
 *
 * layout="centered" — heading + optional subtext centered, buttons row
 *   centered below; matches the "Start your Dubai property portfolio
 *   today" / "Start Your Investment Journey Today" banners.
 *
 * Usage:
 *
 *   Default (unchanged homepage banner):
 *     <ConcludingCTA />
 *
 *   "Start your Dubai property portfolio today":
 *     <ConcludingCTA
 *       layout="centered"
 *       heading="Start your Dubai property portfolio today"
 *       subtext="Build your Dubai property portfolio in under four minutes. Regulated by VARA. Verified by DLD."
 *       buttons={[
 *         { label: "Create Free Account", href: "/start-investing", variant: "primary" },
 *         { label: "Contact Investment Team", href: "/contact", variant: "secondary" },
 *       ]}
 *     />
 *
 *   "Start Your Investment Journey Today":
 *     <ConcludingCTA
 *       layout="centered"
 *       heading="Start Your Investment Journey Today"
 *       subtext="Build your Dubai property portfolio in under four minutes. Regulated by VARA. Verified by DLD."
 *       buttons={[
 *         { label: "Start Investing", href: "/start-investing", variant: "primary" },
 *         { label: "Download the App", href: "#download", variant: "secondary" },
 *       ]}
 *     />
 */
import Section from "../layout/Section.astro";

const {
  layout = "split",
  heading = [
    { text: "Everyone ", highlight: true },
    { text: "Deserves a slice, We Make Sure " },
    { text: "It’s Possible.", highlight: true },
  ],
  subtext,
  buttons = [{ label: "Start Investing", href: "#", variant: "primary" }],
  ...rest
} = Astro.props;

// Normalize `heading` so callers can pass a plain string (centered layout)
// or an array of {text, highlight} segments (split layout, colored words).
const headingSegments =
  typeof heading === "string" ? [{ text: heading }] : heading;

const buttonBase =
  "flex h-12 shrink-0 items-center justify-center rounded-lg px-5 py-3 text-md font-semibold transition-colors";

// Split (homepage) and centered (mobile Figma node 30732:151807) use
// different button treatments — gray/neutral vs brand-colored — so the
// variant styles are keyed per layout rather than shared.
const buttonVariants = {
  split: {
    primary: "border border-gray-300 bg-white text-gray-700 shadow-xs hover:bg-gray-50",
    secondary: "border border-white/40 bg-transparent text-white hover:bg-white/10",
  },
  centered: {
    primary: "border border-brand-600 bg-white text-brand-600 shadow-xs hover:bg-brand-25",
    secondary: "border border-white/25 bg-transparent text-white hover:bg-white/10",
  },
};
---

<Section
  class="shadow-[0px_4px_200px_0px_rgba(232,249,247,0.20)]"
  innerClass="flex flex-col items-center"
  {...rest}
>
  <div
    class:list={[
      "w-full overflow-hidden md:rounded-2xl",
      layout === "centered"
        ? "rounded-3xl bg-linear-to-r from-brand-600 to-brand-800 px-6 py-16 text-center md:p-16"
        : "rounded-xl bg-linear-to-br from-brand-800 to-brand-600 p-8 md:p-10",
    ]}
  >
    {
      layout === "centered" ? (
        <div class="mx-auto flex max-w-[45.5rem] flex-col items-center gap-8 md:gap-5">
          <div class="flex flex-col items-center gap-4 md:contents">
            <h2 class="font-display text-lg font-semibold text-white md:text-display-lg md:font-normal">
              {headingSegments.map(({ text, highlight }) =>
                highlight ? <span class="text-mint-500">{text}</span> : <span>{text}</span>,
              )}
            </h2>

            {subtext && (
              <p class="max-w-[38rem] text-sm text-white/70 md:text-md">
                {subtext}
              </p>
            )}
          </div>

          {buttons.length > 0 && (
            <div class="flex flex-wrap items-center justify-center gap-4 md:mt-2">
              {buttons.map((button) => (
                <a
                  href={button.href}
                  class:list={[buttonBase, buttonVariants.centered[button.variant ?? "primary"]]}
                >
                  {button.label}
                </a>
              ))}
            </div>
          )}
        </div>
      ) : (
        <div class="flex flex-col items-stretch gap-6 md:flex-row md:items-center md:justify-between md:gap-8">
          <h2 class="text-center font-display text-display-xs font-normal text-white md:max-w-[565px] md:text-left md:text-display-lg">
            {headingSegments.map(({ text, highlight }) =>
              highlight ? <span class="text-mint-500">{text}</span> : <span>{text}</span>,
            )}
          </h2>

          <div class="flex w-full shrink-0 flex-col gap-3 sm:flex-row md:w-auto">
            {buttons.map((button) => (
              <a
                href={button.href}
                class:list={[buttonBase, "w-full md:w-44", buttonVariants.split[button.variant ?? "primary"]]}
              >
                {button.label}
              </a>
            ))}
          </div>
        </div>
      )
    }
  </div>
</Section>