---
/**
 * Hero — the first section of the landing page.
 *
 * Built from four Figma frames in wBTbnZ7DJMzQwgaGC5k0wK:
 *   29373:154735  desktop, 1512x982 — text column over a full-bleed photo,
 *                 stat band pinned to the bottom edge
 *   29879:63511   mobile HeroSection, 440x961 — a plain stack:
 *                 HeroContent 320 / photo 339 / logos 120 / stats 182
 *
 * TWO LAYOUTS, ONE DOM. The 440px stack is the unprefixed baseline. At `xl`
 * the photo and the stat band become absolute and the copy turns into the
 * centred left column of the desktop frame.
 *
 * WHY xl AND NOT lg. In the desktop frame the phone sits at roughly 55%-83%
 * of the photo, and the photo starts at 11.75% of the section. Solving for
 * where the phone's left edge lands against the 664px text column (which ends
 * at 744px with the 80px gutter):
 *
 *   1024   0.1175*1024 + 0.55*0.9758*1024 =  670   <- overlaps the copy
 *   1280   0.1175*1280 + 0.55*0.9758*1280 =  838   <- clear
 *
 * So the overlay cannot start before ~1200. `xl` (1280) is the first token
 * breakpoint past that. 768-1279 keeps the stack, which Figma does not draw —
 * see the tablet NEEDS_DECISION in tokens.css §12.
 *
 * THE HEADER. Header.astro is `sticky top-0` and therefore still takes 80px of
 * flow, but the Figma hero frame sits at y=0 with the transparent desktop
 * header drawn over it. `xl:-mt-20` pulls the section back under it. The
 * negative margin is deliberately NOT applied below xl: under 1150px the
 * header is the opaque white mobile bar (its own collapse point) and the copy
 * would slide underneath it.
 *
 * THE GLASS. The stat band has no fill of its own — in Figma it is a
 * background blur over the bottom 42px of the photo (the photo ends at y=868,
 * the band starts at y=826). `backdrop-blur` reproduces that. It only reads
 * where the photo is behind the band, i.e. from xl up; in the mobile frames
 * the photo stops well above the stats and the effect is absent by design.
 */
import { Image } from "astro:assets";
import heroPhoto from "../../assets/hero-app-in-hand.webp";
import Vara from "../../assets/logos/vara.svg";
import Dld from "../../assets/logos/dld.svg";
import Dot from "../../assets/icons/radio-button-checked.svg";

/*
 * `prefix` is the small "AED" that leads the second figure — 20px against the
 * 48px number on desktop, 14px against 32px on mobile. `accent` is the purple
 * trailing glyph.
 */
const stats = [
  { value: "340", accent: "+", label: "Property Tokenized" },
  { prefix: "AED", value: "580", accent: "M", label: "Assets Under Tokenization" },
  { value: "100K", accent: "+", label: "Investors Worldwide" },
  { value: "12.5", accent: "%", label: "Average Gross Return" },
];

/*
 * 16/24 Inter Semibold, 20/12 padding, 12px radius — shared by both CTAs, and
 * exactly what the 440px frame draws. Below 440 the pair no longer fits on one
 * line each ("Explore Properties" needs 137px of the 118px a 360px screen
 * leaves), so the smallest tier steps down to 14/16 padding and steps back up
 * at the artboard width. Still a 44px-tall target at both sizes.
 */
const btnBase =
  "flex items-center justify-center rounded-lg px-4 py-3 text-sm font-semibold min-[440px]:px-5 min-[440px]:text-md";
---

{/*
  THE GROUND IS OFF-WHITE, NOT WHITE. Both hero frames are drawn on #fafafa —
  sampled at rgb(250 250 250) top-left, and the same at 440. That is not
  decoration: the photo is not cut out, it carries its own studio plate, which
  renders at rgb(247 250 251). On #fafafa that plate is 3 levels off and
  vanishes (Figma reads 248/249/251 against 250/250/250). On the pure white
  page it was 8 levels off, so the photo's box showed as a tinted rectangle
  with a hard edge down its left side at x=150 and along the header's bottom —
  which is what made the sticky bar look like the wrong colour. The fix is the
  ground, not the bar.
*/}
<section
  class="relative isolate flex flex-col overflow-hidden bg-surface-alt xl:-mt-20 xl:block xl:min-h-[61.375rem]"
>
  {/*
    Below xl this is the stack; at xl it becomes the section-sized box that the
    photo and the copy column both live in. `inset-0` spans the full 982px
    frame and `justify-center` centres the copy on it — which is exactly what
    the Figma column does with `top: calc(50% - 0.5px)` and a -50% translate.
    The stat band sits below the copy's bottom edge (767 vs 826), so the two
    never meet and the band needs no clearance here.
  */}
  <div class="flex flex-col xl:absolute xl:inset-0 xl:justify-center xl:gap-8">
    <div class="order-1 container-site pt-[3.125rem] pb-8 xl:pt-0 xl:pb-0">
      <div class="flex flex-col gap-5 xl:w-[41.5rem] xl:gap-8">
        {/*
          The badge is the first thing on mobile and the last on desktop, so it
          is ordered rather than duplicated. 18px of extra top margin turns the
          column's 32px gap into the 50px Figma draws above it.
        */}
        <p
          class="order-1 flex w-fit items-center gap-2 rounded-pill border border-gray-100/20 bg-off-white px-3 py-1.5 text-2xs xl:order-4 xl:mt-[1.125rem] xl:bg-transparent xl:font-semibold xl:shadow-pill"
        >
          <Dot class="size-2.5 shrink-0" aria-hidden="true" />
          Licensed by VARA - In partnership with DLD
        </p>

        <h1
          class="order-2 text-display-lg-mobile leading-10 tracking-tight xl:order-1 xl:max-w-[32.5rem] xl:text-display-xl xl:leading-display-xl"
        >
          Own Your <span class="text-brand-purple">Slice</span> of Real Estate.
        </h1>

        {/*
          The two frames carry different copy — the mobile one is a deliberate
          trim, not a truncation, so both strings are kept and swapped. Only one
          is ever in the accessibility tree, since `hidden` removes the other.
          15/22 is not on the type scale; it exists only here.
        */}
        <p class="order-3 text-[0.9375rem]/[1.375rem] xl:hidden">
          Invest in Dubai real estate from AED 2,000. Earn monthly rent and sell
          anytime on a regulated market with DLD-verified properties on the XRP
          Ledger.
        </p>
        <p class="order-3 hidden xl:order-2 xl:block xl:text-lg">
          Start investing in Dubai real estate from just AED 2,000. Earn your
          share of the rent every month, and sell whenever you want on a
          regulated secondary market — all powered by DLD-verified properties
          tokenized on the XRP Ledger.
        </p>

        <div class="order-4 flex gap-3 xl:order-3 xl:gap-4">
          <a
            href="#properties"
            class:list={[
              btnBase,
              "flex-1 border border-brand-purple bg-brand-purple text-white shadow-xs xl:w-56 xl:flex-none",
            ]}
          >
            Explore Properties
          </a>
          <a
            href="/download"
            class:list={[
              btnBase,
              "flex-1 border border-line-strong shadow-xs xl:w-[14.5rem] xl:flex-none",
            ]}
          >
            Download the App
          </a>
        </div>
      </div>
    </div>

    {/*
      Mobile: an in-flow 440x339 band, cropped to the phone the way frame
      29879:63523 does. Desktop: the photo box of the 1512 frame — 97.58% x
      83.86% at (11.75%, 4.52%), which is exactly the image's own 1.792 aspect,
      so nothing is cropped at the artboard width.

      It is anchored from the RIGHT rather than the left, because the box's
      height is pinned to a fixed 823px while its width would keep growing:
      past ~1512 the box gets wider than 1.792:1, object-cover starts scaling
      the phone up, and by 1920 it collides with the header's buttons. Capping
      the width at the 1475px the design draws and letting `right` carry the
      same -9.33% bleed keeps the geometry identical at 1512 and simply slides
      the photo further right on wider screens.

      The photo is not cut out — it carries its own near-white studio
      background (#f8fafa), so its left edge is a faint seam against the white
      page. Figma has that seam too, at x=178 on the artboard, so it is left
      alone up to 1512. From 1512 the width cap slides the edge inward to
      somewhere conspicuous, hence the mask below. The fade only ever covers
      flat background — the hand does not start until ~30% across.
    */}
    <div
      class="relative -z-10 order-2 aspect-[440/339] overflow-hidden sm:aspect-3/2 sm:max-h-[32rem] xl:absolute xl:top-[4.52%] xl:right-[-9.33%] xl:aspect-auto xl:h-[83.86%] xl:max-h-none xl:w-[97.58%] xl:max-w-[92.1875rem]"
    >
      <Image
        src={heroPhoto}
        alt="A hand holding a phone with the Sliceal app open on a tokenized two-bedroom apartment in Palm Jumeirah, Dubai."
        widths={[440, 880, 1320, 1760, 2752]}
        sizes="(min-width: 1280px) 98vw, 100vw"
        loading="eager"
        fetchpriority="high"
        class="size-full object-cover object-[88%_50%] sm:object-[70%_50%] xl:object-center 2xl:[mask-image:linear-gradient(to_right,transparent,#000_10%)]"
      />
    </div>

    {/*
      Frame 29879:63525 on mobile; the one white card of frame 29373:154751 on
      desktop.

      THE GLASS IS THE BAND, NOT THE TILES. In the mobile frame the whole 440x120
      row is the frosted panel and it sits *between* the photo and the stats — it
      does not overlap the phone. Sampling the frame down its left edge: the
      photo's last row is the hand at rgb(119 94 83), two pixels into the band it
      is rgb(202 195 191), then 205 / 212 / 213 / 220 on the way down, against
      rgb(254 254 254) through the middle. That is the hand read through frosted
      glass, fading with distance from the photo's edge.

      Figma produces that with a background blur whose kernel pulls the photo's
      bottom edge down into the band. CSS `backdrop-filter` cannot: it only
      filters what is painted *behind* the element's own box, and the photo stops
      at the band's top edge, so a bare backdrop-filter here frosts nothing. The
      band therefore carries the measured falloff as its own two-stop wash —
      strongest at the top and left where the hand is, gone by the bottom centre
      — with `backdrop-blur` kept on so it behaves like glass over anything that
      does end up behind it. Above xl all of it is dropped and the marks go back
      into the solid white card.
    */}
    <div
      class="order-3 bg-[linear-gradient(to_bottom,rgb(0_0_0/0.085),transparent_92%),linear-gradient(to_right,rgb(0_0_0/0.15)_0%,rgb(0_0_0/0.15)_5%,rgb(0_0_0/0.08)_22%,rgb(0_0_0/0.02)_55%,rgb(0_0_0/0.01)_72%,rgb(0_0_0/0.07)_100%)] backdrop-blur-2xl xl:bg-none xl:backdrop-blur-none"
    >
      <div class="container-site py-5 xl:py-0">
        {/*
          `flex-wrap` rather than letting the tiles shrink: both marks have a
          fixed height, and global.css caps every svg at `max-width: 100%`, so a
          shrinking tile squashes the artwork horizontally instead of scaling
          it. The 440 frame's two tiles measure 161 + 16 + 203 = 380 against the
          408 the gutter leaves, so they fit there but not at 360 — hence the
          smaller step below 440. Under ~330 they wrap and stack.
        */}
        <div
          class="mx-auto flex max-w-full flex-wrap items-center justify-center gap-3 min-[440px]:gap-4 xl:mx-0 xl:w-fit xl:max-w-none xl:flex-nowrap xl:justify-start xl:gap-6 xl:rounded-lg xl:bg-white xl:p-5 xl:shadow-[0_0_2.5px_rgb(0_0_0/0.1)]"
        >
          <div
            class="rounded-lg border border-line bg-white/30 p-4 min-[440px]:p-5 xl:rounded-none xl:border-0 xl:bg-transparent xl:p-0"
          >
            <Vara
              class="h-8 w-[100px] min-[440px]:h-[38px] min-[440px]:w-[119px]"
              role="img"
              aria-label="Virtual Assets Regulatory Authority"
            />
          </div>
          <div
            class="rounded-lg border border-line bg-white/30 p-4 min-[440px]:p-5 xl:rounded-none xl:border-0 xl:bg-transparent xl:p-0"
          >
            <Dld
              class="h-8 w-[136px] min-[440px]:h-[38px] min-[440px]:w-[161px]"
              role="img"
              aria-label="Dubai Land Department"
            />
          </div>
        </div>
      </div>
    </div>
  </div>

  {/*
    Hairlines: `border-t` on the grid draws the top rule, `border-b` on every
    cell draws the row rules and the bottom edge, `border-l` on every cell draws
    the verticals plus the one at x=0 that the Figma frame has. Nothing doubles
    up. The band is transparent so the blurred photo behind it is the fill.
  */}
  <dl
    class="relative m-0 mt-auto grid grid-cols-2 border-t border-line bg-white backdrop-blur-2xl md:grid-cols-4 xl:absolute xl:inset-x-0 xl:bottom-0 xl:mt-0 xl:bg-transparent"
  >
    {
      /* dt precedes dd as the spec requires; `order` puts the figure on top. */
      stats.map(({ prefix, value, accent, label }) => (
        <div class="flex min-h-[5.6875rem] flex-col items-center justify-center gap-1 border-b border-l border-line p-4 text-center xl:min-h-[9.75rem] xl:gap-2.5 xl:px-[1.875rem] xl:py-2.5">
          <dt class="order-2 text-sm leading-tight text-ink-muted xl:text-md xl:leading-md">
            {label}
          </dt>
          {/* m-0 kills the UA stylesheet's 40px margin-inline-start on <dd>. */}
          <dd class="order-1 m-0 text-display-lg-mobile leading-[1.1875] font-normal tracking-tight text-gray-900 xl:text-display-lg xl:leading-display-lg xl:font-medium">
            {prefix && (
              <span class="text-sm font-semibold xl:text-xl">{prefix} </span>
            )}
            {value}
            <span class="text-brand-purple">{accent}</span>
          </dd>
        </div>
      ))
    }
  </dl>
</section>
