---
import { Image, getImage } from "astro:assets";
import heroPhoto from "../../assets/hero-app-in-hand.webp";
import heroPhotoDark from "../../assets/hero-app-in-hand-dark.png";
import Vara from "../../assets/logos/vara.svg";
import VaraDark from "../../assets/logos/vara-dark.svg";
import Dld from "../../assets/logos/dld.svg";
import DldDark from "../../assets/logos/dld-dark.svg";
import Dot from "../../assets/icons/radio-button-checked.svg";
import dirhamSymbol from "../../assets/icons/dirham-symbol.png";

/*
 * The dark-mode hero photo (Figma "Website - v4 Dark", node 31010:153893) is a
 * different source image, not a CSS filter over the light one — its backdrop is
 * genuinely black, where the light asset's is off-white. Astro's <Image> can't
 * pick a source from a media query, so the dark variant is a hand-built srcset
 * on a <picture><source media="(prefers-color-scheme: dark)"> pointed at
 * <Image>'s light output, matching its widths so neither theme downloads both.
 */
const heroPhotoWidths = [440, 880, 1320, 1760, 2752];
const heroPhotoDarkVariants = await Promise.all(
  heroPhotoWidths.map((width) => getImage({ src: heroPhotoDark, width, format: "webp" })),
);
const heroPhotoDarkSrcset = heroPhotoDarkVariants
  .map((img) => `${img.src} ${img.attributes.width}w`)
  .join(", ");

/*
 * `prefix` is the small "AED" that leads the second figure — 20px against the
 * 48px number on desktop, 14px against 32px on mobile. `accent` is the purple
 * trailing glyph.
 */
const stats = [
  { value: "340", accent: "+", label: "Property Tokenized" },
  { prefix: "AED", value: "580", accent: "M", label: "Assets Under Tokenization" },
  { value: "100K", accent: "+", label: "Investors Worldwide" },
  { value: "12.5", accent: "%", label: "Average Gross Return" },
];

/*
 * 16/24 Inter Semibold, 20/12 padding, 12px radius — shared by both CTAs, and
 * exactly what the 440px frame draws. Below 440 the pair no longer fits on one
 * line each ("Explore Properties" needs 137px of the 118px a 360px screen
 * leaves), so the smallest tier steps down to 14/16 padding and steps back up
 * at the artboard width. Still a 44px-tall target at both sizes.
 */
const btnBase =
  "flex items-center justify-center rounded-lg px-4 py-3 text-sm font-semibold min-[440px]:px-5 min-[440px]:text-md";
---


<section
  class="relative isolate flex flex-col overflow-hidden bg-surface-alt dark:bg-black md:block md:aspect-[1024/625] lg:-mt-20 lg:block lg:aspect-auto lg:min-h-[clamp(55rem,100dvh,61.375rem)]"
  {...Astro.props}
>

  <div class="flex flex-col md:absolute md:inset-0 md:justify-center md:gap-8 lg:absolute lg:inset-0 lg:justify-center lg:gap-8">
    <div class="order-1 container-site pt-[3.125rem] pb-8 md:pt-0 md:pb-0 lg:pt-0 lg:pb-0">
      <div class="flex flex-col gap-5 md:w-[31.0625rem] md:gap-8 lg:w-[41.5rem] lg:gap-8">
        {/*
          The badge is the first thing on mobile and the last on desktop, so it
          is ordered rather than duplicated. 18px of extra top margin turns the
          column's 32px gap into the 50px Figma draws above it.
        */}
        <p
          class="order-1 flex w-fit items-center gap-2 rounded-pill border border-gray-100/20 bg-surface-alt px-3 py-1.5 text-2xs md:order-4 md:bg-transparent md:font-semibold md:shadow-pill lg:order-4 lg:mt-[1.125rem] lg:bg-transparent lg:font-semibold lg:shadow-pill"
        >
          <Dot class="size-2.5 shrink-0" aria-hidden="true" />
          Licensed by VARA - In partnership with DLD
        </p>

        <h1
          class="order-2 text-display-lg-mobile leading-10 tracking-tight md:order-1 md:max-w-[32.5rem] lg:order-1 lg:max-w-[32.5rem] lg:text-display-xl lg:leading-display-xl"
        >
          Own Your <span class="text-brand-purple">Slice</span> of Real Estate.
        </h1>

        {/*
          The two frames carry different copy — the mobile one is a deliberate
          trim, not a truncation, so both strings are kept and swapped. Only one
          is ever in the accessibility tree, since `hidden` removes the other.
          15/22 is not on the type scale; it exists only here.
        */}
        <p class="order-3 text-[0.9375rem]/[1.375rem] md:hidden lg:hidden">
          Invest in Dubai real estate from AED 2,000. Earn monthly rent and sell
          anytime on a regulated market with DLD-verified properties on the XRP
          Ledger.
        </p>
        <p class="order-3 hidden text-sm md:order-2 md:block lg:order-2 lg:block lg:text-lg">
          Start investing in Dubai real estate from just AED 2,000. Earn your
          share of the rent every month, and sell whenever you want on a
          regulated secondary market — all powered by DLD-verified properties
          tokenized on the XRP Ledger.
        </p>

        <div class="order-4 flex gap-3 md:order-3 md:gap-4 lg:order-3 lg:gap-4">
          <a
            href="/properties"
            class:list={[
              btnBase,
              "flex-1 border border-brand-purple bg-brand-purple text-white shadow-xs transition-colors hover:border-brand-800 hover:bg-brand-800 md:w-[12.3125rem] md:flex-none lg:w-56 lg:flex-none",
            ]}
          >
            Explore Properties
          </a>
          <a
            href="/download"
            class:list={[
              btnBase,
              "flex-1 border border-line-strong shadow-xs transition-colors hover:bg-surface-sunken md:w-[11.875rem] md:flex-none lg:w-[14.5rem] lg:flex-none",
            ]}
          >
            Download the App
          </a>
        </div>
      </div>
    </div>


    <div
      class="relative -z-10 order-2 aspect-[440/339] overflow-hidden sm:aspect-3/2 sm:max-h-[32rem] md:absolute md:top-0 md:right-0 md:aspect-auto md:h-full md:w-full md:max-h-none md:max-w-none lg:absolute lg:top-[4.52%] lg:right-[-9.33%] lg:aspect-auto lg:h-[83.86%] lg:max-h-none lg:w-[97.58%] lg:max-w-[92.1875rem]"
    >
      <picture class="contents">
        <source
          media="(prefers-color-scheme: dark)"
          type="image/webp"
          srcset={heroPhotoDarkSrcset}
          sizes="(min-width: 1024px) 98vw, 100vw"
        />
        <Image
          src={heroPhoto}
          alt="A hand holding a phone with the Sliceal app open on a tokenized two-bedroom apartment in Palm Jumeirah, Dubai."
          widths={[440, 880, 1320, 1760, 2752]}
          sizes="(min-width: 1024px) 98vw, 100vw"
          loading="eager"
          fetchpriority="high"
          class="size-full object-cover object-[88%_50%] sm:object-[70%_50%] md:object-center lg:object-center 2xl:[mask-image:linear-gradient(to_right,transparent,#000_10%)]"
        />
      </picture>
    </div>


    <div
      class="order-3 bg-[linear-gradient(to_bottom,rgb(0_0_0/0.085),transparent_92%),linear-gradient(to_right,rgb(0_0_0/0.15)_0%,rgb(0_0_0/0.15)_5%,rgb(0_0_0/0.08)_22%,rgb(0_0_0/0.02)_55%,rgb(0_0_0/0.01)_72%,rgb(0_0_0/0.07)_100%)] backdrop-blur-2xl md:bg-none md:backdrop-blur-none lg:bg-none lg:backdrop-blur-none"
    >
      <div class="container-site py-5 md:py-0 lg:py-0">

        <div
          class="mx-auto flex max-w-full flex-wrap items-center justify-center gap-3 min-[440px]:gap-4 md:mx-0 md:w-fit md:max-w-none md:flex-nowrap md:justify-start md:gap-6 md:rounded-lg md:bg-surface md:p-5 md:shadow-[0_0_2.5px_rgb(0_0_0/0.1)] md:dark:border md:dark:border-line-strong lg:mx-0 lg:w-fit lg:max-w-none lg:flex-nowrap lg:justify-start lg:gap-6 lg:rounded-lg lg:bg-surface lg:p-5 lg:shadow-[0_0_2.5px_rgb(0_0_0/0.1)] lg:dark:border lg:dark:border-line-strong"
        >
          <div
            class="rounded-lg border border-line bg-surface/30 p-4 min-[440px]:p-5 md:rounded-none md:border-0 md:bg-transparent md:p-0 lg:rounded-none lg:border-0 lg:bg-transparent lg:p-0"
          >
            <Vara
              class="h-8 w-[100px] dark:hidden min-[440px]:h-[38px] min-[440px]:w-[119px]"
              role="img"
              aria-label="Virtual Assets Regulatory Authority"
            />
            <VaraDark
              class="hidden h-8 w-[100px] dark:block min-[440px]:h-[38px] min-[440px]:w-[119px]"
              role="img"
              aria-label="Virtual Assets Regulatory Authority"
            />
          </div>
          <div
            class="rounded-lg border border-line bg-surface/30 p-4 min-[440px]:p-5 md:rounded-none md:border-0 md:bg-transparent md:p-0 lg:rounded-none lg:border-0 lg:bg-transparent lg:p-0"
          >
            <Dld
              class="h-8 w-[136px] dark:hidden min-[440px]:h-[38px] min-[440px]:w-[161px]"
              role="img"
              aria-label="Dubai Land Department"
            />
            <DldDark
              class="hidden h-8 w-[136px] dark:block min-[440px]:h-[38px] min-[440px]:w-[161px]"
              role="img"
              aria-label="Dubai Land Department"
            />
          </div>
        </div>
      </div>
    </div>
  </div>

  {/*
    Hairlines: `border-t` on the grid draws the top rule, `border-b` on every
    cell draws the row rules and the bottom edge, `border-l` on every cell draws
    the verticals plus the one at x=0 that the Figma frame has. Nothing doubles
    up. The band is transparent so the blurred photo behind it is the fill.
  */}
  <dl
    class="relative m-0 mt-auto grid grid-cols-2 border-t border-line bg-surface backdrop-blur-2xl md:absolute md:inset-x-0 md:bottom-0 md:mt-0 md:grid-cols-4 md:bg-transparent lg:absolute lg:inset-x-0 lg:bottom-0 lg:mt-0 lg:bg-transparent"
  >
    {
      /* dt precedes dd as the spec requires; `order` puts the figure on top. */
      stats.map(({ prefix, value, accent, label }) => (
        <div class="flex min-h-[5.6875rem] flex-col items-center justify-center gap-1 border-b border-l border-line p-4 text-center lg:min-h-[9.75rem] lg:gap-2.5 lg:px-[1.875rem] lg:py-2.5">
          <dt class="order-2 text-sm leading-tight text-ink-muted lg:text-md lg:leading-md dark:text-off-white">
            {label}
          </dt>
          {/* m-0 kills the UA stylesheet's 40px margin-inline-start on <dd>. */}
          <dd class="order-1 m-0 text-display-lg-mobile leading-[1.1875] font-normal tracking-tight text-ink lg:text-display-lg lg:leading-display-lg lg:font-medium">
            {prefix && (
              <Image
                src={dirhamSymbol}
                alt={prefix}
                class="mr-1 inline-block h-[0.7em] w-auto align-baseline"
              />
            )}
            <span data-count>{value}</span>
            <span class="text-brand-purple">{accent}</span>
          </dd>
        </div>
      ))
    }
  </dl>
</section>
