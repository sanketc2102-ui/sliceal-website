---
import { Image } from "astro:assets";
import heroPhoto from "../../assets/hero-app-in-hand.webp";
import Vara from "../../assets/logos/vara.svg";
import Dld from "../../assets/logos/dld.svg";
import Dot from "../../assets/icons/radio-button-checked.svg";

/*
 * `prefix` is the small "AED" that leads the second figure — 20px against the
 * 48px number on desktop, 14px against 32px on mobile. `accent` is the purple
 * trailing glyph.
 */
const stats = [
  { value: "340", accent: "+", label: "Property Tokenized" },
  { prefix: "AED", value: "580", accent: "M", label: "Assets Under Tokenization" },
  { value: "100K", accent: "+", label: "Investors Worldwide" },
  { value: "12.5", accent: "%", label: "Average Gross Return" },
];

/*
 * 16/24 Inter Semibold, 20/12 padding, 12px radius — shared by both CTAs, and
 * exactly what the 440px frame draws. Below 440 the pair no longer fits on one
 * line each ("Explore Properties" needs 137px of the 118px a 360px screen
 * leaves), so the smallest tier steps down to 14/16 padding and steps back up
 * at the artboard width. Still a 44px-tall target at both sizes.
 */
const btnBase =
  "flex items-center justify-center rounded-lg px-4 py-3 text-sm font-semibold min-[440px]:px-5 min-[440px]:text-md";
---


<section
  class="relative isolate flex flex-col overflow-hidden bg-surface-alt lg:-mt-20 lg:block lg:min-h-[61.375rem]"
  {...Astro.props}
>

  <div class="flex flex-col lg:absolute lg:inset-0 lg:justify-center lg:gap-8">
    <div class="order-1 container-site pt-[3.125rem] pb-8 lg:pt-0 lg:pb-0">
      <div class="flex flex-col gap-5 lg:w-[41.5rem] lg:gap-8">
        {/*
          The badge is the first thing on mobile and the last on desktop, so it
          is ordered rather than duplicated. 18px of extra top margin turns the
          column's 32px gap into the 50px Figma draws above it.
        */}
        <p
          class="order-1 flex w-fit items-center gap-2 rounded-pill border border-gray-100/20 bg-off-white px-3 py-1.5 text-2xs lg:order-4 lg:mt-[1.125rem] lg:bg-transparent lg:font-semibold lg:shadow-pill"
        >
          <Dot class="size-2.5 shrink-0" aria-hidden="true" />
          Licensed by VARA - In partnership with DLD
        </p>

        <h1
          class="order-2 text-display-lg-mobile leading-10 tracking-tight lg:order-1 lg:max-w-[32.5rem] lg:text-display-xl lg:leading-display-xl"
        >
          Own Your <span class="text-brand-purple">Slice</span> of Real Estate.
        </h1>

        {/*
          The two frames carry different copy — the mobile one is a deliberate
          trim, not a truncation, so both strings are kept and swapped. Only one
          is ever in the accessibility tree, since `hidden` removes the other.
          15/22 is not on the type scale; it exists only here.
        */}
        <p class="order-3 text-[0.9375rem]/[1.375rem] lg:hidden">
          Invest in Dubai real estate from AED 2,000. Earn monthly rent and sell
          anytime on a regulated market with DLD-verified properties on the XRP
          Ledger.
        </p>
        <p class="order-3 hidden lg:order-2 lg:block lg:text-lg">
          Start investing in Dubai real estate from just AED 2,000. Earn your
          share of the rent every month, and sell whenever you want on a
          regulated secondary market — all powered by DLD-verified properties
          tokenized on the XRP Ledger.
        </p>

        <div class="order-4 flex gap-3 lg:order-3 lg:gap-4">
          <a
            href="/properties"
            class:list={[
              btnBase,
              "flex-1 border border-brand-purple bg-brand-purple text-white shadow-xs transition-colors hover:border-brand-800 hover:bg-brand-800 lg:w-56 lg:flex-none",
            ]}
          >
            Explore Properties
          </a>
          <a
            href="/download"
            class:list={[
              btnBase,
              "flex-1 border border-line-strong shadow-xs transition-colors hover:bg-gray-100 lg:w-[14.5rem] lg:flex-none",
            ]}
          >
            Download the App
          </a>
        </div>
      </div>
    </div>


    <div
      class="relative -z-10 order-2 aspect-[440/339] overflow-hidden sm:aspect-3/2 sm:max-h-[32rem] lg:absolute lg:top-[4.52%] lg:right-[-9.33%] lg:aspect-auto lg:h-[83.86%] lg:max-h-none lg:w-[97.58%] lg:max-w-[92.1875rem]"
    >
      <Image
        src={heroPhoto}
        alt="A hand holding a phone with the Sliceal app open on a tokenized two-bedroom apartment in Palm Jumeirah, Dubai."
        widths={[440, 880, 1320, 1760, 2752]}
        sizes="(min-width: 1024px) 98vw, 100vw"
        loading="eager"
        fetchpriority="high"
        class="size-full object-cover object-[88%_50%] sm:object-[70%_50%] lg:object-center 2xl:[mask-image:linear-gradient(to_right,transparent,#000_10%)]"
      />
    </div>


    <div
      class="order-3 bg-[linear-gradient(to_bottom,rgb(0_0_0/0.085),transparent_92%),linear-gradient(to_right,rgb(0_0_0/0.15)_0%,rgb(0_0_0/0.15)_5%,rgb(0_0_0/0.08)_22%,rgb(0_0_0/0.02)_55%,rgb(0_0_0/0.01)_72%,rgb(0_0_0/0.07)_100%)] backdrop-blur-2xl lg:bg-none lg:backdrop-blur-none"
    >
      <div class="container-site py-5 lg:py-0">

        <div
          class="mx-auto flex max-w-full flex-wrap items-center justify-center gap-3 min-[440px]:gap-4 lg:mx-0 lg:w-fit lg:max-w-none lg:flex-nowrap lg:justify-start lg:gap-6 lg:rounded-lg lg:bg-white lg:p-5 lg:shadow-[0_0_2.5px_rgb(0_0_0/0.1)]"
        >
          <div
            class="rounded-lg border border-line bg-white/30 p-4 min-[440px]:p-5 lg:rounded-none lg:border-0 lg:bg-transparent lg:p-0"
          >
            <Vara
              class="h-8 w-[100px] min-[440px]:h-[38px] min-[440px]:w-[119px]"
              role="img"
              aria-label="Virtual Assets Regulatory Authority"
            />
          </div>
          <div
            class="rounded-lg border border-line bg-white/30 p-4 min-[440px]:p-5 lg:rounded-none lg:border-0 lg:bg-transparent lg:p-0"
          >
            <Dld
              class="h-8 w-[136px] min-[440px]:h-[38px] min-[440px]:w-[161px]"
              role="img"
              aria-label="Dubai Land Department"
            />
          </div>
        </div>
      </div>
    </div>
  </div>

  {/*
    Hairlines: `border-t` on the grid draws the top rule, `border-b` on every
    cell draws the row rules and the bottom edge, `border-l` on every cell draws
    the verticals plus the one at x=0 that the Figma frame has. Nothing doubles
    up. The band is transparent so the blurred photo behind it is the fill.
  */}
  <dl
    class="relative m-0 mt-auto grid grid-cols-2 border-t border-line bg-white backdrop-blur-2xl md:grid-cols-4 lg:absolute lg:inset-x-0 lg:bottom-0 lg:mt-0 lg:bg-transparent"
  >
    {
      /* dt precedes dd as the spec requires; `order` puts the figure on top. */
      stats.map(({ prefix, value, accent, label }) => (
        <div class="flex min-h-[5.6875rem] flex-col items-center justify-center gap-1 border-b border-l border-line p-4 text-center lg:min-h-[9.75rem] lg:gap-2.5 lg:px-[1.875rem] lg:py-2.5">
          <dt class="order-2 text-sm leading-tight text-ink-muted lg:text-md lg:leading-md">
            {label}
          </dt>
          {/* m-0 kills the UA stylesheet's 40px margin-inline-start on <dd>. */}
          <dd class="order-1 m-0 text-display-lg-mobile leading-[1.1875] font-normal tracking-tight text-gray-900 lg:text-display-lg lg:leading-display-lg lg:font-medium">
            {prefix && (
              <span class="text-sm font-semibold lg:text-xl">{prefix} </span>
            )}
            {value}
            <span class="text-brand-purple">{accent}</span>
          </dd>
        </div>
      ))
    }
  </dl>
</section>
