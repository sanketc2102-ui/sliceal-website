---
/**
 * GlowCta — reusable soft-blob CTA banner section.
 *
 * Figma: wBTbnZ7DJMzQwgaGC5k0wK, "section" component — same shape (glow-shadow
 * card, heading, description, action buttons, blurred color blobs behind the
 * copy) reused with different content per page, e.g. node 26790:47232 on
 * /security-complience and node 26790:46803 on the careers page.
 *
 * Blob position/size/rotation is hand-tuned per Figma instance, so callers
 * pass their own `blobs` (image + full position class) instead of this
 * component guessing a layout.
 */
import { Image } from "astro:assets";

import Section from "../layout/Section.astro";

const { heading, description, buttons = [], blobs = [] } = Astro.props;

const btnBase =
  "flex h-12 w-full items-center justify-center rounded-lg border border-brand bg-white px-5 text-md font-semibold text-brand shadow-xs transition-colors hover:bg-brand-25 sm:w-auto";
---

<!-- TODO(mobile): no mobile/tablet Figma yet — default state below is a
     placeholder, not a designed layout. Revisit when frames land. -->
<Section
  bleed
  class="overflow-hidden shadow-[var(--shadow-glow)]"
  innerClass="relative flex flex-col items-center gap-6 text-center xl:gap-8"
>
  {
    blobs.length > 0 && (
      <div slot="bleed" class="pointer-events-none absolute inset-0" aria-hidden="true">
        {blobs.map((blob) => (
          <Image src={blob.src} alt="" class={blob.class} />
        ))}
      </div>
    )
  }

  <h2
    class="max-w-3xl text-display-lg-mobile leading-10 font-medium tracking-tight text-ink xl:text-display-xl xl:leading-display-xl"
  >
    {heading}
  </h2>

  <p class="max-w-2xl text-md leading-md text-ink-muted xl:text-lg xl:leading-lg">
    {description}
  </p>

  {
    buttons.length > 0 && (
      <div class="flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
        {buttons.map((button) => (
          <a href={button.href} class={btnBase}>
            {button.label}
          </a>
        ))}
      </div>
    )
  }
</Section>
