---
/**
 * GlowCta — reusable soft-blob CTA banner section.
 *
 * Figma: wBTbnZ7DJMzQwgaGC5k0wK, "section" component — same shape (glow-shadow
 * card, heading, description, action buttons, blurred color blobs behind the
 * copy) reused with different content per page, e.g. node 26790:47232 on
 * /security-complience and node 26790:46803 on the careers page.
 *
 * Blob position/size/rotation is hand-tuned per Figma instance, so callers
 * pass their own `blobs` (image + full position class) instead of this
 * component guessing a layout.
 */
import { Image } from "astro:assets";

import Section from "../layout/Section.astro";

const { heading, description, buttons = [], blobs = [] } = Astro.props;

const btnBase =
  "flex min-h-11 items-center justify-center rounded-xl border border-brand bg-brand px-3.5 py-2 text-sm leading-sm font-normal text-white shadow-xs transition-colors hover:bg-brand-hover sm:h-12 sm:rounded-lg sm:bg-white sm:px-5 sm:py-0 sm:text-md sm:leading-md sm:font-semibold sm:text-brand sm:hover:bg-brand-25";
---

<Section
  bleed
  class="overflow-hidden shadow-[var(--shadow-glow)]"
  innerClass="relative flex flex-col items-center gap-6 text-center lg:gap-8"
>
  {
    blobs.length > 0 && (
      <div slot="bleed" class="pointer-events-none absolute inset-0 hidden lg:block" aria-hidden="true">
        {blobs.map((blob) => (
          <Image src={blob.src} alt="" class={blob.class} />
        ))}
      </div>
    )
  }

  <h2
    class="max-w-3xl text-lg leading-lg font-semibold tracking-normal text-ink lg:text-display-xl lg:leading-display-xl lg:font-medium lg:tracking-tight"
  >
    {heading}
  </h2>

  <p class="max-w-2xl text-sm leading-sm text-ink-muted lg:text-lg lg:leading-lg">
    {description}
  </p>

  {
    buttons.length > 0 && (
      <div class="flex w-full flex-row flex-wrap items-center justify-center gap-4 sm:w-auto sm:gap-3">
        {buttons.map((button) => (
          <a href={button.href} class={btnBase}>
            {button.label}
          </a>
        ))}
      </div>
    )
  }
</Section>
