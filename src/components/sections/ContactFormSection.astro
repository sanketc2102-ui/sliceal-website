---
/**
 * ContactFormSection — "Contact Information" panel + enquiry form.
 *
 * Figma: wBTbnZ7DJMzQwgaGC5k0wK — desktop 31819:74581, tablet 30908:57902,
 * mobile contact card 30600:138775, mobile form 31836:75357.
 *
 * Mobile renders two separate white cards (panel + form); from md up they
 * merge into one white card with the gray panel on the left.
 *
 * The panel's gray background and decorative circles are flat solid fills in
 * Figma (#F5F5F5 rect, #6755FB circles at 60%/20% opacity) — rebuilt as plain
 * divs. From md up the frame clips square while the gray rect is rounded, so
 * the big circle bleeds past the rect's bottom-right corner; the rounded bg
 * is therefore its own layer inside a square overflow-hidden panel.
 *
 * Every field in the Figma frame shows a filled-in example ("Deepak",
 * "Jangra"…) — replaced here with instructional placeholders, since this is
 * a live form.
 *
 * Subjects: tablet + mobile end with "Become Agent", desktop with "Others";
 * the tablet/mobile set is used. Figma's "Unable to Regsiter" typo is fixed.
 *
 * Submission has no backend yet — the script below only validates and shows
 * an inline confirmation, same pattern as the footer newsletter form.
 */
import PhoneIcon from "../../assets/contact-us/icons/phone-call.svg";
import EmailIcon from "../../assets/contact-us/icons/email.svg";
import LocationIcon from "../../assets/contact-us/icons/location.svg";
import TwitterIcon from "../../assets/contact-us/icons/social-twitter.svg";
import InstagramIcon from "../../assets/contact-us/icons/social-instagram.svg";
import DiscordIcon from "../../assets/contact-us/icons/social-discord.svg";
import PhoneIconDark from "../../assets/contact-us/icons/phone-call-mint.svg";
import EmailIconDark from "../../assets/contact-us/icons/email-mint.svg";
import LocationIconDark from "../../assets/contact-us/icons/location-mint.svg";
import TwitterIconDark from "../../assets/contact-us/icons/social-twitter-mint.svg";
import InstagramIconDark from "../../assets/contact-us/icons/social-instagram-mint.svg";
import DiscordIconDark from "../../assets/contact-us/icons/social-discord-mint.svg";
import TickChecked from "../../assets/contact-us/icons/tick-checked.svg";
import TickUnchecked from "../../assets/contact-us/icons/tick-unchecked.svg";
import ChevronDown from "../../assets/contact-us/icons/chevron-down.svg";

const contactRows = [
  { Icon: PhoneIcon, IconDark: PhoneIconDark, label: "+971 528770054", href: "tel:+971528770054" },
  { Icon: EmailIcon, IconDark: EmailIconDark, label: "Support@sliceal.io", href: "mailto:Support@sliceal.io" },
];

const socialLinks = [
  { label: "Twitter", href: "#", Icon: TwitterIcon, IconDark: TwitterIconDark },
  { label: "Instagram", href: "#", Icon: InstagramIcon, IconDark: InstagramIconDark },
  { label: "Discord", href: "#", Icon: DiscordIcon, IconDark: DiscordIconDark },
];

const subjects = ["General Inquiry", "Payment Issue", "Unable to Register", "Become Agent"];

const countryCodes = ["+971", "+966", "+974", "+965", "+973", "+968", "+91", "+44", "+1"];

const rowText = "text-sm font-semibold text-ink md:text-md md:font-normal";
const fieldLabel = "text-sm font-medium text-gray-700 dark:text-gray-400";
const fieldBox = "rounded-sm border border-line-strong bg-surface shadow-xs";
const fieldInput = `${fieldBox} w-full px-3.5 py-2.5 text-md text-ink outline-none placeholder:text-ink-muted focus:border-brand`;
---

<section id="contact-form" class="section-y" {...Astro.props}>
  <div class="container-site">
    <div
      class="flex flex-col gap-8 drop-shadow-[0px_4px_100px_rgba(232,249,247,0.2)] md:flex-row md:items-center md:gap-8 md:rounded-2xl md:bg-surface md:px-4 md:py-5 lg:gap-[57px] lg:p-[15px] md:dark:border-[15px] md:dark:border-brand-800"
    >
      <!-- Contact Information panel -->
      <div
        class="relative flex min-h-80 w-full flex-col gap-5 overflow-hidden rounded-lg bg-surface px-3 pt-4 pb-4 md:min-h-[587px] md:w-[47.5%] md:shrink-0 md:gap-[60px] md:rounded-none md:bg-transparent md:p-10 lg:min-h-[569px] lg:w-[43%] lg:gap-[50px]"
      >
        <div aria-hidden="true" class="absolute inset-0 hidden rounded-2xl bg-surface-sunken md:block dark:bg-[#23184e]"></div>

        <div class="relative z-10 flex flex-col gap-5 md:gap-[50px]">
          <div class="flex flex-col gap-3">
            <h2 class="text-lg font-semibold text-ink md:text-display-md">Contact Information</h2>
            <p class="text-sm text-ink-muted md:text-md">Say something to start a live chat!</p>
          </div>

          <ul class="m-0 flex list-none flex-col gap-3 p-0 md:gap-[31px] lg:gap-6">
            {
              contactRows.map(({ Icon, IconDark, label, href }) => (
                <li>
                  <a href={href} class={`flex items-center gap-4 transition-opacity hover:opacity-70 md:gap-[25px] ${rowText}`}>
                    <Icon class="size-5 shrink-0 md:size-6 dark:hidden" aria-hidden="true" />
                    <IconDark class="hidden size-5 shrink-0 md:size-6 dark:block" aria-hidden="true" />
                    {label}
                  </a>
                </li>
              ))
            }
            <li class={`flex items-start gap-4 md:gap-[25px] ${rowText}`}>
              <LocationIcon class="size-5 shrink-0 md:size-6 dark:hidden" aria-hidden="true" />
              <LocationIconDark class="hidden size-5 shrink-0 md:size-6 dark:block" aria-hidden="true" />
              <span>
                50th Floor, Conrad Office Tower, World trade Center<span class="md:hidden">,</span>{" "}<br
                  class="hidden md:inline"
                />Dubai, UAE
              </span>
            </li>
          </ul>
        </div>

        <div class="relative z-10 flex items-center gap-[25px]">
          {
            socialLinks.map(({ label, href, Icon, IconDark }) => (
              <a
                href={href}
                aria-label={label}
                class="flex size-[30px] shrink-0 items-center justify-center transition-opacity hover:opacity-80"
              >
                <Icon class="size-[30px] dark:hidden" aria-hidden="true" />
                <IconDark class="hidden size-[30px] dark:block" aria-hidden="true" />
              </a>
            ))
          }
        </div>

        <!--
          Decorative circles — offsets are Figma's left/top converted to
          right/bottom against each tier's panel: mobile 408x320 card, tablet
          414x587, desktop 555x569. The small circle isn't drawn on mobile.
        -->
        <div
          aria-hidden="true"
          class="absolute -right-[134px] -bottom-[149px] size-[269px] rounded-full bg-brand-purple/60 md:-bottom-[71px] lg:-right-[84px] lg:-bottom-[94px]"
        >
        </div>
        <div
          aria-hidden="true"
          class="absolute right-[15px] bottom-[76px] hidden size-[138px] rounded-full bg-brand-purple/20 md:block lg:right-[72px] lg:bottom-[74px]"
        >
        </div>
      </div>

      <!-- Enquiry form -->
      <form
        class="flex w-full flex-col gap-6 rounded-lg bg-surface p-3 md:min-w-0 md:flex-1 md:rounded-none md:bg-transparent md:p-0"
        data-contact-form
      >
        <div class="flex flex-col gap-3 text-center md:hidden">
          <h2 class="text-lg font-semibold text-ink">Send us A Message</h2>
          <p class="text-sm text-ink-muted">Say something to start a live chat!</p>
        </div>

        <div class="flex flex-col gap-[42px] md:gap-8 lg:gap-[42px]">
          <div class="flex flex-col gap-8">
            <div class="flex flex-col gap-4 md:flex-row md:gap-6">
              <div class="flex flex-col gap-1.5 md:min-w-0 md:flex-1">
                <label for="contact-first-name" class={fieldLabel}>First Name</label>
                <input id="contact-first-name" name="firstName" type="text" autocomplete="given-name" placeholder="Enter first name" required class={fieldInput} />
              </div>
              <div class="flex flex-col gap-1.5 md:min-w-0 md:flex-1">
                <label for="contact-last-name" class={fieldLabel}>Last Name</label>
                <input id="contact-last-name" name="lastName" type="text" autocomplete="family-name" placeholder="Enter last name" required class={fieldInput} />
              </div>
            </div>

            <div class="flex flex-col gap-4 md:flex-row md:gap-6">
              <div class="flex flex-col gap-1.5 md:min-w-0 md:flex-1">
                <label for="contact-email" class={fieldLabel}>Email Address</label>
                <input id="contact-email" name="email" type="email" autocomplete="email" placeholder="you@example.com" required class={fieldInput} />
              </div>
              <div class="flex flex-col gap-1.5 md:min-w-0 md:flex-1">
                <label for="contact-phone" class={fieldLabel}>Phone Number</label>
                <div class={`${fieldBox} flex focus-within:border-brand`}>
                  <span class="relative flex shrink-0">
                    <select
                      name="phoneCode"
                      aria-label="Country code"
                      autocomplete="tel-country-code"
                      class="appearance-none bg-transparent py-2.5 pr-11 pl-3.5 text-md text-ink outline-none"
                    >
                      {countryCodes.map((code) => <option value={code}>{code}</option>)}
                    </select>
                    <ChevronDown class="pointer-events-none absolute top-1/2 right-3 size-5 -translate-y-1/2" aria-hidden="true" />
                  </span>
                  <input
                    id="contact-phone"
                    name="phone"
                    type="tel"
                    autocomplete="tel-national"
                    placeholder="Phone number"
                    class="w-full min-w-0 bg-transparent py-2.5 pr-3.5 text-md text-ink outline-none placeholder:text-ink-muted"
                  />
                </div>
              </div>
            </div>

            <fieldset class="m-0 border-0 p-0">
              <legend class={`${fieldLabel} mb-1.5 p-0`}>Select Subject</legend>
              <div class="flex flex-wrap gap-4 lg:gap-[18px]">
                {
                  subjects.map((subject, index) => (
                    <label class={`${fieldBox} inline-flex cursor-pointer items-center gap-3 px-3.5 py-2.5 text-xs text-ink has-checked:border-brand-300 has-checked:font-medium has-checked:text-brand-purple has-focus-visible:ring-2 has-focus-visible:ring-brand has-focus-visible:ring-offset-2`}>
                      <input type="radio" name="subject" value={subject} checked={index === 0} class="peer sr-only" />
                      <TickChecked class="hidden size-[18px] shrink-0 peer-checked:block" aria-hidden="true" />
                      <TickUnchecked class="size-[18px] shrink-0 peer-checked:hidden" aria-hidden="true" />
                      {subject}
                    </label>
                  ))
                }
              </div>
            </fieldset>

            <div class="flex flex-col gap-1.5">
              <label for="contact-message" class={fieldLabel}>Message</label>
              <textarea
                id="contact-message"
                name="message"
                placeholder="Write your message.."
                required
                class={`${fieldInput} h-[111px] resize-y md:h-[93px] lg:h-[111px]`}
              ></textarea>
            </div>
          </div>

          <button
            type="submit"
            class="inline-flex w-full items-center justify-center rounded-lg border border-brand bg-brand px-5 py-3 text-md font-semibold text-white shadow-xs transition-colors hover:bg-brand-hover md:w-auto md:self-end"
          >
            Submit Enquiry
          </button>
        </div>

        <p class="hidden text-sm text-ink-secondary" data-contact-form-message aria-live="polite"></p>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.querySelector("[data-contact-form]");
  const message = document.querySelector("[data-contact-form-message]");

  if (form instanceof HTMLFormElement && message) {
    form.addEventListener("submit", (event) => {
      event.preventDefault();

      message.textContent =
        "Thanks! Your enquiry has been sent — we'll get back to you shortly.";
      message.classList.remove("hidden");

      if (form instanceof HTMLFormElement) form.reset();
    });
  }
</script>
