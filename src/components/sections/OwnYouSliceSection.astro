---
import Section from "../layout/Section.astro";
import { Image } from "astro:assets";

import desktopBackground from "../../assets/own-slice/own-your-slice-bg-img-desktop.png";

import phoneLeft from "../../assets/own-slice/gold-left.png";
import phoneCenter from "../../assets/own-slice/gold-middle.png";
import phoneRight from "../../assets/own-slice/gold-right.png";

import googlePlayIcon from "../../assets/own-slice/Playstore-logo.svg";
import appStoreIcon from "../../assets/own-slice/Apple-logo.svg";
---

<!-- <Section flush class="overflow-hidden" innerClass="!max-w-none !px-0"> -->
  <!-- TODO(mobile): no tablet Figma frame yet — md: layout below is a
       percentage-scaled derivation of the desktop frame, not a designed
       tablet composition. Revisit when a tablet frame lands. -->
  <section
    class="
      relative
      w-full
      overflow-hidden
      bg-linear-to-br
      from-brand-800
      to-brand-400
      dark:bg-none
      dark:bg-surface-dark
      md:pt-[min(8.879%,122px)]
      md:pb-[min(6.914%,95px)]
    "
    {...Astro.props}
  >
    <!-- =========================================================
         DESKTOP BACKGROUND
         ========================================================= -->

    <div
      class="pointer-events-none absolute inset-0 hidden lg:block dark:hidden"
      aria-hidden="true"
    >
      <Image
        src={desktopBackground}
        alt=""
        class="absolute inset-0 h-full w-full object-cover"
      />

      <div
        class="
          absolute
          inset-0
          bg-brand-800/65
          mix-blend-multiply
        "
      ></div>
    </div>

    <div
      class="pointer-events-none absolute inset-0 hidden dark:lg:block"
      aria-hidden="true"
    >
      <Image
        src={desktopBackground}
        alt=""
        class="absolute inset-0 h-full w-full object-cover opacity-20 mix-blend-soft-light"
      />
    </div>


    <!-- =========================================================
         DESKTOP FRAME

         Figma frame:
         1374 × 614
         ========================================================= -->

    <div
      class="
        relative
        mx-auto
        w-full
        md:aspect-[1374/614]
        lg:max-w-[1374px]
      "
    >

      <!-- =======================================================
           COPY
           ======================================================= -->

      <div
        class="
          relative
          z-30
          flex
          w-full
          flex-col
          items-center
          px-4
          pt-12
          pb-10
          text-center
          md:absolute
          md:left-0
          md:top-0
          md:h-full
          md:w-[40%]
          md:justify-center
          md:px-0
          md:pt-0
          md:pb-0
          lg:w-[550px]
          lg:px-0
          lg:pt-0
          lg:pb-0
        "
      >
        <div
          class="
            flex
            w-full
            flex-col
            items-center
            gap-8
          "
        >

          <!-- Heading + description -->

          <div
            class="
              flex
              w-full
              flex-col
              items-center
              gap-3
            "
          >
            <h2
              class="
               w-full
                max-w-[322px]
                font-display
                text-display-sm
                font-normal
                leading-display-sm
                tracking-tight
                text-white
                md:max-w-none
                lg:w-[484px]
                lg:text-display-lg
                lg:leading-display-lg
              "
            >
              <span class="text-mint-500">Own Your</span>
              <span> Slice Download </span>
              <span class="text-mint-500">the App</span>
            </h2>

            <p
              class="
                w-full
                max-w-[390px]
                text-sm
                font-normal
                leading-5
                text-white
                md:max-w-none
                lg:w-[550px]
              "
            >
              Get full control over your portfolio, track live property
              performance, and trade your slices instantly from anywhere.
            </p>
          </div>


          <!-- ===================================================
               STORE BUTTONS
               =================================================== -->

          <div
            class="flex h-10 w-auto items-center justify-center gap-2"
          >

            <!-- Google Play -->

            <a
              href="#"
              aria-label="Get it on Google Play"
              class="
                flex
                h-10
                w-32
                shrink-0
                items-center
                gap-2
                overflow-hidden
                rounded-md
                bg-black
                px-3
                outline
                outline-1
                -outline-offset-1
                outline-neutral-50
                transition-colors
                hover:bg-neutral-800
              "
            >
              <!-- logo -->
            <Image src={googlePlayIcon} alt="" class="h-5 w-5 shrink-0 object-contain" />
            <span class="flex flex-col items-start whitespace-nowrap text-left">
              <span class="text-[8px] font-normal uppercase leading-[10px] text-white">GET IT ON</span>
              <span class="text-[14px] font-medium leading-[14px] text-white">Google Play</span>
            </span>
          </a>


            <!-- App Store -->

            <a
              href="#"
              aria-label="Download on the App Store"
              class="
                flex
                h-10
                w-32
                shrink-0
                items-center
                gap-2
                overflow-hidden
                rounded-md
                bg-black
                px-3
                outline
                outline-1
                -outline-offset-1
                outline-neutral-50
                transition-colors
                hover:bg-neutral-800
              "
            >
              <!-- Apple logo -->

              <Image src={appStoreIcon} alt="" class="h-5 w-5 shrink-0 object-contain" />
              <span class="flex flex-col items-start whitespace-nowrap text-left">
                <span class="text-[8px] font-medium leading-[9px] text-white">Download on the</span>
                <span class="text-[17px] font-medium leading-4 text-white">App Store</span>
              </span>
            </a>

          </div>

        </div>
      </div>


      <!-- =======================================================
           PHONES (md and up)

           Positions/sizes are the desktop Figma frame's px values
           (1374 x 614, node 31754:134600) converted to percentages
           of that frame, so they scale fluidly at every width from
           md up through the lg:max-w-[1374px] cap instead of only
           matching one exact viewport width. Each phone is
           top-anchored, not bottom-anchored — their differing
           heights (564 / 710 / 548) just happen to land their
           bottoms within a few px of each other, which reads as
           "bottom aligned" but isn't.
           ======================================================= -->

<div
  class="
    pointer-events-none
    absolute
    inset-0
    z-20
    hidden
    md:block
  "
  aria-hidden="true"
>
  <!-- LEFT PHONE -->

  <div
    class="
      absolute
      top-[29.48%]
      left-[44.4%]
      z-10
      h-[86.16%]
      w-[19.94%]
    "
  >
    <Image
      src={phoneLeft}
      alt=""
      class="block h-full w-full object-contain"
    />
  </div>


  <!-- CENTER PHONE -->

   <div
    class="
     absolute
      top-[6%]
      left-[59.83%]
      z-30
      h-[115.64%]
      w-[25.18%]
    "
  >
    <Image
      src={phoneCenter}
      alt=""
      class="block h-full w-full object-contain"
    />
  </div>


  <!-- RIGHT PHONE -->

  <div
    class="
      absolute
      top-[29.5%]
      left-[81.5%]
      z-10
      h-[86.16%]
      w-[19.94%]
    "
  >
    <Image
      src={phoneRight}
      alt=""
      class="block h-full w-full object-contain"
    />
  </div>

</div>


      <!-- =======================================================
           MOBILE PHONES
           ======================================================= -->

      <div
        class="
          flex
          h-[267px]
          w-full
          items-end
          justify-center

          md:hidden
        "
      >
        <div class="h-[226px] w-[110px] shrink-0">
          <Image
            src={phoneLeft}
            alt="Sliceal property investment app"
            class="h-full w-full object-contain object-bottom"
          />
        </div>

        <div class="z-10 -ml-[25px] h-[267px] w-[130px] shrink-0">
          <Image
            src={phoneCenter}
            alt="Sliceal portfolio dashboard"
            class="h-full w-full object-contain"
          />
        </div>

        <div class="-ml-[31px] h-[226px] w-[110px] shrink-0">
          <Image
            src={phoneRight}
            alt="Sliceal investment app"
            class="h-full w-full object-contain object-bottom"
          />
        </div>
      </div>

    </div>
  </section>
<!-- </Section> -->