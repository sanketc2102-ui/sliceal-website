---
/**
 * KpiProofBar — the four-figure proof strip that sits directly under the
 * /why-sliceal hero.
 *
 * Figma: wBTbnZ7DJMzQwgaGC5k0wK, node 29864:71277 (KPIProofBar, 1512 frame)
 * and node 31002:51448 (tablet, 1024 frame).
 *
 * Two deliberate deviations from the frame:
 *   1. Figma pads the band 64px on all four sides (1384 content column). The
 *      horizontal gutter follows `.container-site` (80px / 1352) instead, so
 *      the figures line up with the hero above and the partner logos below.
 *      Only the 64px padding-block is kept.
 *   2. The dividers are drawn in Figma as 1px × 48px vector lines. They are
 *      hairlines, not artwork, so they are `w-px` boxes filled with the
 *      border token rather than four copies of the same exported SVG.
 *
 * "0%" on the third figure is verbatim from the frame — worth confirming with
 * the designer, since the label reads like it wants 100%.
 */
import Section from "../layout/Section.astro";

/* tone → the value colour. Figma paints figure 1 brand purple, figure 4
   success green, and the middle two the dark heading grey. */
const stats = [
  { value: "AED 50M+", label: "Total Property Value Tokenized", tone: "text-brand" },
  { value: "14.2%", label: "Projected Annual ROI", tone: "text-gray-900" },
  { value: "0%", label: "DLD-Registered Title Deeds", tone: "text-gray-900" },
  { value: "VARA", label: "Fully Regulated Platform", tone: "text-success-500" },
];

/* 32px bold. There is no desktop 32px step in the type scale — only
   --text-display-lg-mobile — so that token carries the tablet/desktop size
   here, and each tier sets leading explicitly so the mobile value can't
   leak into md:/lg:. */
const valueClass =
  "text-display-xs leading-display-xs font-bold tracking-tight md:text-display-lg-mobile md:leading-display-sm lg:text-display-lg-mobile lg:leading-display-sm";
---

<Section surface="alt" flush class="border-y border-line py-10 md:py-8 lg:py-16" {...Astro.props}>
  {/*
    Two columns below md. From md a single row of four equal-width tracks
    with hairlines between them; lg swaps to fixed 260px tracks spread with
    justify-between. dt/dd are reversed in the flow so the label still
    precedes its figure for a screen reader while the figure renders on top.
  */}
  <dl
    class="m-0 grid grid-cols-2 gap-x-6 gap-y-8 md:flex md:items-center md:gap-x-4 lg:flex lg:items-center lg:justify-between lg:gap-x-0"
  >
    {
      stats.map(({ value, label, tone }, i) => (
        <>
          {i > 0 && (
            <div aria-hidden="true" class="hidden h-12 w-px shrink-0 bg-line md:block lg:block" />
          )}
          <div class="flex flex-col-reverse items-center gap-2 text-center md:grow md:basis-0 md:shrink-0 lg:w-[16.25rem] lg:shrink-0 lg:items-start lg:text-left">
            <dt class="text-sm leading-sm text-ink-secondary">{label}</dt>
            {/* m-0 kills the UA stylesheet's 40px margin-inline-start on <dd>. */}
            <dd class:list={["m-0", valueClass, tone]}>{value}</dd>
          </div>
        </>
      ))
    }
  </dl>
</Section>
