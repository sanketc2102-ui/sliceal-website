---
/**
 * SecurityComplianceOverview — trust pill + headline/subhead, then a 4-card
 * compliance-pillar grid, on /security-complience.
 *
 * Figma: wBTbnZ7DJMzQwgaGC5k0wK, node 29864:72396 (named "Hero", 1512 frame).
 *
 * The frame draws the "Segregated client money" card taller than its three
 * siblings (261px vs 215-238px) — that is Figma's hover/expanded state for
 * that card, not four different card heights. The grid below stretches every
 * card to the row's tallest card instead of sizing each to its own content.
 */
import Section from "../layout/Section.astro";

import DeedVerifiedIcon from "../../assets/icons/security-compliance/deed-verified.svg";
import DeedVerifiedMintIcon from "../../assets/icons/security-compliance/deed-verfication-mint.svg";
import SegregatedFundsIcon from "../../assets/icons/security-compliance/segregated-funds.svg";
import SegregatedFundsMintIcon from "../../assets/icons/security-compliance/segregated-funds-mint.svg";
import OneDeedIcon from "../../assets/icons/security-compliance/one-deed.svg";
import OneDeedMintIcon from "../../assets/icons/security-compliance/one-deed-mint.svg";
import VaraLicensedIcon from "../../assets/icons/security-compliance/vara-licensed.svg";

const pillars = [
  {
    icon: VaraLicensedIcon,
    iconDark: null,
    title: "VARA licensed",
    description:
      "Supervised by Dubai's virtual assets regulator. We're not licensed to advise, lend or offer leverage.",
  },
  {
    icon: DeedVerifiedIcon,
    iconDark: DeedVerifiedMintIcon,
    title: "DLD-verified deed",
    description:
      "Every deed checked against Dubai Land Department records, valued independently, encumbrances cleared.",
  },
  {
    icon: SegregatedFundsIcon,
    iconDark: SegregatedFundsMintIcon,
    title: "Segregated client money",
    description:
      "When you place an order, the amount is locked in your account — not deducted. Funds move only once your tokens are issued; if funding fails, the lock is released.",
  },
  {
    icon: OneDeedIcon,
    iconDark: OneDeedMintIcon,
    title: "One property, one deed",
    description:
      "Every property stays on its own DLD title deed, with fractional ownership recorded against it — never pooled, never commingled.",
  },
];

// Reveal is applied per-card below (same convention as Timeline.astro) so
// the 4 pillars cascade in one after another instead of popping as one
// block — the page-supplied data-reveal is consumed here, not forwarded.
const { "data-reveal": _dataReveal, ...rest } = Astro.props;
---

<Section
  class="bg-surface shadow-[var(--shadow-glow)]"
  innerClass="flex flex-col items-start gap-7"
  {...rest}
>
  <div
    class="flex w-full flex-col items-center gap-6 text-center md:gap-4 lg:gap-6"
    data-reveal
  >
    <p class="rounded-pill border border-line-brand px-3 py-1.5 text-sm leading-sm font-semibold text-text-brand shadow-pill">
      Regulated · VARA licensed · DLD registered
    </p>

    <h2 class="text-display-xs-mobile leading-display-xs font-semibold tracking-tight text-ink md:text-display-sm md:leading-display-sm lg:text-display-lg lg:leading-display-lg lg:font-medium">
      Your ownership is on the title deed. Your money sits in a bank. Neither
      one is on our balance sheet.
    </h2>

    <p class="text-lg leading-lg text-ink-muted md:text-sm md:leading-sm md:max-w-[71.68%] lg:max-w-[48.875rem]">
      Tokenizing a property doesn't move it outside the rules. Here is the
      short version of how it's structured — and the full version is one
      click away.
    </p>
  </div>

  <ul class="m-0 grid w-full list-none grid-cols-1 gap-6 p-0 md:grid-cols-2 lg:grid-cols-4">
    {
      pillars.map(({ icon: Icon, iconDark: IconDark, title, description }, i) => (
        <li
          class:list={[
            "flex flex-col gap-[1.125rem] rounded-xl border border-line bg-surface p-4 lg:rounded-none lg:p-[1.875rem]",
            i === 0 && "lg:rounded-l-xl",
            i === pillars.length - 1 && "lg:rounded-r-lg",
          ]}
          data-reveal
        >
          <Icon aria-hidden="true" class:list={["size-6 shrink-0 text-black", IconDark && "dark:hidden"]} />
          {IconDark && <IconDark aria-hidden="true" class="hidden size-6 shrink-0 dark:block" />}

          <div class="flex flex-col gap-3">
            <h3 class="text-display-xs leading-display-xs font-medium text-ink">
              {title}
            </h3>
            <p class="text-sm leading-normal text-ink-secondary">{description}</p>
          </div>
        </li>
      ))
    }
  </ul>
</Section>
