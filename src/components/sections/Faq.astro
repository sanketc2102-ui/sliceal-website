---
/**
 * FAQSection — "Frequently asked" preview on the homepage.
 *
 * Figma: artboard "Website - v4 light", node 28900-181416 (desktop).
 * No mobile frame was provided for this section, so the mobile layout below
 * follows the project's standard mobile-first patterns (scrollable category
 * chips + a full-width accordion) rather than a specific artboard.
 *
 * id="faqs" matches the "FAQs" link in Header.astro (href="#faqs").
 * The tab + accordion markup itself lives in <FaqAccordion />, which the
 * dedicated FAQs page can reuse as-is with the same or fuller category data
 * from ../../data/faqs.js.
 */
import Section from "../layout/Section.astro";
import FaqAccordion from "../ui/FaqAccordion.astro";
import { faqCategories } from "../../data/faq.js";

const eyebrow =
  "rounded-pill border border-line px-3 py-1.5 text-xs/[0.875rem] text-brand-purple lg:text-sm/5 lg:font-semibold lg:shadow-pill";
---

<Section id="faqs" class="shadow-[var(--shadow-glow)]" {...Astro.props}>
  <div class="flex w-full flex-col gap-7">

    <!-- Heading -->
    <header class="flex w-full flex-col gap-6">
      <p class={`w-fit ${eyebrow}`}>QUESTIONS</p>

      <h2 class="w-full text-2xl font-normal leading-8 text-black lg:text-5xl lg:leading-[60px]">
        Frequently asked.
      </h2>
    </header>

    <hr class="h-px w-full border-0 bg-gray-200" />

    <!-- Tabs + accordion -->
    <FaqAccordion categories={faqCategories} instanceId="home-faqs" />

  </div>
</Section>