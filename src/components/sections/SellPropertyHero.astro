---
/**
 * SellPropertyHero — the "Sell Your Property on Sliceal" hero on
 * /sell-your-property.
 *
 * Figma: wBTbnZ7DJMzQwgaGC5k0wK
 *   Desktop: node 30732:150618 (1512 frame)
 *   Tablet:  node 31002:50803 (1024 frame)
 *   Mobile:  node 30732:151394 (440 frame)
 */
import { Image } from "astro:assets";

import Section from "../layout/Section.astro";

import heroProperty from "../../assets/sell-your-property/hero-property.png";
import Dot from "../../assets/icons/radio-button-checked.svg";
import Vara from "../../assets/logos/vara.svg";
import VaraDark from "../../assets/logos/vara-dark.svg";
import Dld from "../../assets/logos/dld.svg";
import DldDark from "../../assets/logos/dld-dark.svg";

const stats = [
  { label: "GLOBAL REACH", value: "+100k Investors" },
  { label: "LISTING TIME", value: "Under 24 Hours" },
];

/* Figma "Shadow/lg": two stacked drop shadows, no token for it yet — same
   effect WhySlicealHero uses for its card. */
const cardShadow =
  "shadow-[0_4px_6px_-2px_rgb(10_13_18/0.03),0_12px_16px_-4px_rgb(10_13_18/0.08)]";

const btnBase =
  "flex items-center justify-center whitespace-nowrap rounded-lg border px-5 py-3 text-md font-semibold shadow-xs transition-colors";
---

<Section
  flush
  class="pt-[1.875rem] pb-10 md:pt-20 md:pb-25 lg:pt-20 lg:pb-25"
  innerClass="flex flex-col items-center gap-[2.625rem] md:flex-row md:items-center md:justify-between lg:flex-row lg:items-center lg:justify-between"
  {...Astro.props}
>
  <div class="flex w-full flex-col items-center gap-6 text-center md:w-[44%] md:items-start md:gap-8 md:text-left lg:w-[45.375rem] lg:items-start lg:gap-8 lg:text-left">
    {/* Verification badge + partner logos — same lockup WhySlicealHero.astro built for this exact copy. */}
    <div class="flex flex-col items-center gap-8 md:items-start" data-reveal>
      <p class="flex w-fit items-center gap-2 rounded-pill border border-gray-100/20 bg-surface px-3 py-1.5 text-2xs font-semibold shadow-pill">
        <Dot class="size-2.5 shrink-0" aria-hidden="true" />
        Licensed by VARA - In partnership with DLD
      </p>

      <div class="flex flex-wrap items-center justify-center gap-4 sm:flex-nowrap">
        <div class="flex items-center rounded-xl bg-surface p-4 shadow-[0_0_2.5px_rgb(0_0_0/0.1)] sm:p-5">
          <Vara class="h-8 w-[100px] dark:hidden sm:h-[38px] sm:w-[119px]" role="img" aria-label="Virtual Assets Regulatory Authority" />
          <VaraDark class="hidden h-8 w-[100px] dark:block sm:h-[38px] sm:w-[119px]" role="img" aria-label="Virtual Assets Regulatory Authority" />
        </div>
        <div class="flex items-center rounded-xl bg-surface p-4 shadow-[0_0_2.5px_rgb(0_0_0/0.1)] sm:p-5">
          <Dld class="h-8 w-[136px] dark:hidden sm:h-[38px] sm:w-[161px]" role="img" aria-label="Dubai Land Department" />
          <DldDark class="hidden h-8 w-[136px] dark:block sm:h-[38px] sm:w-[161px]" role="img" aria-label="Dubai Land Department" />
        </div>
      </div>
    </div>

    <div class="flex flex-col gap-4">
      <h1
        class="text-xl leading-xl font-semibold text-ink md:text-display-sm md:leading-display-sm lg:text-display-xl lg:leading-display-xl lg:tracking-tight lg:font-medium"
        data-reveal
      >
        Sell Your Property on Sliceal
      </h1>

      <p
        class="text-sm leading-sm text-ink-secondary md:text-ink-muted lg:text-lg lg:leading-lg lg:text-ink-muted"
        data-reveal
      >
        Reach a growing pool of verified investors through fractional ownership. List your
        property in minutes and start raising capital from verified buyers.
      </p>
    </div>

    <div class="flex items-center gap-4" data-reveal>
      <a
        href="#"
        class:list={[btnBase, "border-brand bg-brand text-white hover:bg-brand-hover"]}
      >
        List Your Property
      </a>
      <a
        href="#"
        class:list={[btnBase, "border-gray-300 bg-surface-fixed text-gray-700 hover:bg-gray-50"]}
      >
        How it Works
      </a>
    </div>
  </div>

  <div
    class:list={[
      cardShadow,
      "flex w-full shrink-0 flex-col gap-5 rounded-2xl border border-gray-200 bg-off-white p-4 md:w-[47%] md:min-w-[19rem] lg:w-[32.5rem] lg:p-6",
    ]}
    data-reveal
  >
    <div class="relative h-80 w-full overflow-hidden rounded-lg md:h-[14.5rem] lg:h-80">
      <Image
        src={heroProperty}
        alt="Dubai city skyline at dusk"
        widths={[400, 800, 1200]}
        sizes="(min-width: 1024px) 30rem, (min-width: 768px) 40vw, 100vw"
        quality={70}
        loading="eager"
        class="absolute inset-0 size-full object-cover"
      />
    </div>

    <div class="flex w-full items-start gap-4">
      {
        stats.map(({ label, value }) => (
          <div class="flex flex-1 flex-col gap-1 rounded-sm bg-surface-fixed p-3">
            <p class="text-xs text-ink-muted">{label}</p>
            <p class="text-lg leading-lg font-bold text-black whitespace-nowrap md:whitespace-normal">{value}</p>
          </div>
        ))
      }
    </div>
  </div>
</Section>
