---
/**
 * SellPropertyHero — the "Sell Your Property on Sliceal" hero on
 * /sell-your-property.
 *
 * Figma: wBTbnZ7DJMzQwgaGC5k0wK
 *   Desktop: node 30732:150618 (1512 frame)
 *   Mobile:  node 30732:151394 (440 frame)
 */
import { Image } from "astro:assets";

import Section from "../layout/Section.astro";

import heroProperty from "../../assets/sell-your-property/hero-property.png";

const stats = [
  { label: "GLOBAL REACH", value: "+100k Investors" },
  { label: "LISTING TIME", value: "Under 24 Hours" },
];

/* Figma "Shadow/lg": two stacked drop shadows, no token for it yet — same
   effect WhySlicealHero uses for its card. */
const cardShadow =
  "shadow-[0_4px_6px_-2px_rgb(10_13_18/0.03),0_12px_16px_-4px_rgb(10_13_18/0.08)]";

const btnBase =
  "flex items-center justify-center whitespace-nowrap rounded-lg border px-5 py-3 text-md font-semibold shadow-xs transition-colors";
---

<Section
  flush
  class="pt-[1.875rem] pb-10 xl:pt-20 xl:pb-25"
  innerClass="flex flex-col items-center gap-[2.625rem] xl:flex-row xl:items-center xl:justify-between"
>
  <div class="flex w-full flex-col items-center gap-6 text-center xl:w-[45.375rem] xl:items-start xl:gap-8 xl:text-left">
    <p class="text-sm font-semibold text-ink-muted">
      <span aria-hidden="true">•</span> Dubai Land Department Verified
    </p>

    <div class="flex flex-col gap-4">
      <h1 class="text-xl leading-xl font-semibold text-ink xl:text-display-xl xl:leading-display-xl xl:tracking-tight xl:font-medium">
        Sell Your Property on Sliceal
      </h1>

      <p class="text-sm leading-sm text-ink-secondary xl:text-lg xl:leading-lg xl:text-ink-muted">
        Reach a growing pool of verified investors through fractional ownership. List your
        property in minutes and start raising capital from verified buyers.
      </p>
    </div>

    <div class="flex items-center gap-4">
      <a
        href="#"
        class:list={[btnBase, "border-brand bg-brand text-white hover:bg-brand-hover"]}
      >
        List Your Property
      </a>
      <a
        href="#"
        class:list={[btnBase, "border-line-strong bg-white text-gray-700 hover:bg-gray-100"]}
      >
        How it Works
      </a>
    </div>
  </div>

  <div
    class:list={[
      cardShadow,
      "flex w-full shrink-0 flex-col gap-5 rounded-2xl border border-line bg-off-white p-4 xl:w-[32.5rem] xl:p-6",
    ]}
  >
    <div class="relative h-80 w-full overflow-hidden rounded-lg">
      <Image
        src={heroProperty}
        alt="Dubai city skyline at dusk"
        widths={[400, 800, 1200]}
        sizes="(min-width: 1280px) 30rem, 100vw"
        quality={70}
        loading="eager"
        class="absolute inset-0 size-full object-cover"
      />
    </div>

    <div class="flex w-full items-start gap-4">
      {
        stats.map(({ label, value }) => (
          <div class="flex flex-1 flex-col gap-1 rounded-sm bg-white p-3">
            <p class="text-xs text-ink-muted">{label}</p>
            <p class="text-lg leading-lg font-bold text-ink whitespace-nowrap">{value}</p>
          </div>
        ))
      }
    </div>
  </div>
</Section>
