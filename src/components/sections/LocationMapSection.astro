---
/**
 * LocationMapSection — Dubai map with the "Sliceal HQ" info card overlay.
 *
 * Figma: wBTbnZ7DJMzQwgaGC5k0wK, node 26908:341937 (Hero, 1512x771, desktop);
 * node 30685:46336 (Hero, 440x286, mobile).
 *
 * The map background is the designer's exact Google Maps screenshot from
 * Figma (baked-in zoom/layers/transit controls included) — shipped as a
 * static decorative image, not a live embed, matching how the page hero
 * above already uses a static photo rather than real functionality.
 */
import { Image } from "astro:assets";

import LogoMark from "../../assets/logo-mark.svg";
import mapBg from "../../assets/contact-us/map-bg.png";
---

<section class="section-y">
  <div class="container-site">
    <div
      class="relative -mx-4 flex aspect-[440/286] w-[calc(100%+2rem)] items-start overflow-hidden rounded-none p-4 shadow-glow sm:mx-0 sm:w-full sm:aspect-video sm:rounded-2xl lg:aspect-[1512/771] lg:p-20"
    >
      <Image
        src={mapBg}
        alt=""
        widths={[640, 1024, 1512, 2048]}
        sizes="100vw"
        loading="lazy"
        class="absolute inset-0 -z-10 size-full object-cover"
      />

      <div class="flex w-[198px] flex-col items-start rounded-lg bg-white p-3 sm:w-[413px] sm:rounded-2xl sm:px-[25px] sm:py-6">
        <div class="flex w-full gap-3">
          <LogoMark class="h-[26px] w-[18px] shrink-0 sm:h-[35px] sm:w-[26.44px] lg:h-[45px] lg:w-[34px]" />
          <div class="flex min-w-0 flex-1 flex-col gap-[5px] sm:gap-3">
            <p class="text-xs leading-[18px] font-semibold text-black sm:text-display-sm-mobile sm:leading-8 lg:text-display-sm lg:leading-display-sm">
              The Sliceal HQ
            </p>
            <p class="text-[10px] leading-normal text-gray-500 sm:text-base sm:leading-6">
              50th Floor, Conrad Office Tower, World trade Center<br />Dubai, UAE
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
