---

import Section from "../layout/Section.astro";

const points = [
  {
    title: "A verified asset, not a Promise",
    body: "130 m² in Umm Suqeim, AED 2,600,000. Title deed registered with the DLD, with your share held as a regulated, asset-backed token.",
  },
  {
    title: "One Square Metre = 10,000 Tokens",
    body: "The deed is divided by area, not by opinion: 130 m² becomes 1,300,000 tokens, each one a legal claim on the same asset.",
  },
  {
    title: "AED 2.00 a token",
    body: "Purchase price ÷ token count. AED 500 buys you 250 tokens — and the rent that comes with them, paid monthly.",
  },
  {
    title: "Tradeable, not trapped",
    body: "After a three-month lock-in you can list your tokens on the Sliceal marketplace, priced within ±15% of the latest DLD valuation.",
  },
];

/*
 * `prefix` is the small grey "AED" that leads the second figure on desktop;
 * `accent` is the purple trailing glyph, purple only from xl. `brand` turns
 * the whole figure purple, which the third one is at both sizes.
 */
const metrics = [
  { label: "Tokens", value: "1,300,000", accent: "+" },
  { label: "Price", prefix: "AED", value: "2.00" },
  { label: "AED 2000 buys", value: "1,000", brand: true },
];

const eyebrow =
  "rounded-pill border border-line px-3 py-1.5 text-xs/[0.875rem] text-brand-purple xl:text-sm/5 xl:font-semibold xl:shadow-pill";

const stackCap = "md:mx-auto md:max-w-[36rem] xl:mx-0 xl:max-w-none";
---

<Section surface="alt" flush class="py-12 xl:py-30">
  <div
    class:list={[
      stackCap,
      "flex flex-col gap-6 xl:grid xl:grid-cols-[653fr_599fr] xl:items-start xl:gap-x-[3.125rem] xl:gap-y-8",
    ]}
  >
    <header
      class="flex flex-col items-center gap-4 text-center xl:col-start-1 xl:row-start-1 xl:items-start xl:gap-4.5 xl:text-left"
    >
      <p class={eyebrow}>THE SLICEAL ENGINE</p>

      <h2
        class="text-display-sm-mobile leading-[2.125rem] font-normal tracking-normal text-gray-900 xl:max-w-[33.0625rem] xl:text-display-lg xl:leading-display-lg xl:font-medium xl:tracking-tight xl:text-ink"
      >
        One Apartment. 1.3 Million Digital Slices.
      </h2>
    </header>

    {/*
      The card is white on mobile and transparent on desktop, where only the
      graphic panel carries a fill — sampled off both frames.
    */}
    <div
      class="overflow-hidden rounded-2xl border border-line bg-white xl:col-start-2 xl:row-span-2 xl:row-start-1 xl:ml-auto xl:w-full xl:max-w-[37.4375rem] xl:bg-transparent"
    >
      <div
        class="aspect-[408/220] border-b border-line bg-slate-50 xl:aspect-[598/566]"
        aria-hidden="true"
      >
      </div>

      <dl
        class="m-0 flex flex-col gap-3 p-4 xl:grid xl:grid-cols-3 xl:gap-0 xl:p-0"
      >
        {
          metrics.map(({ label, prefix, value, accent, brand }) => (
            <div class="flex items-start justify-between gap-3 xl:h-[6.8125rem] xl:flex-col xl:justify-center xl:gap-2.5 xl:border-l xl:border-line xl:px-5 xl:py-2.5 xl:first:border-l-0">
              <dt class="text-sm text-ink-muted xl:order-2 xl:text-md xl:leading-md">
                {label}
              </dt>
              {/* m-0 kills the UA stylesheet's 40px margin-inline-start on <dd>. */}
              <dd
                class:list={[
                  "m-0 text-md xl:text-display-xs xl:leading-display-xs xl:font-semibold xl:tracking-normal",
                  brand ? "text-brand-purple" : "text-gray-900 xl:text-ink",
                ]}
              >
                {prefix && (
                  <span class="xl:text-md xl:leading-md xl:font-normal xl:text-ink-muted">
                    {prefix}{" "}
                  </span>
                )}
                {value}
                {accent && <span class="xl:text-brand-purple">{accent}</span>}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>

    {/*
      Four cards on mobile; on desktop they become a rail hung off one hairline,
      with the first one filled and tagged by the 3px purple bar.
    */}
    <ul
      class="flex list-none flex-col gap-2 xl:col-start-1 xl:row-start-2 xl:max-w-[40.8125rem] xl:gap-1.5 xl:border-l xl:border-line"
    >
      {
        points.map(({ title, body }, i) => (
          <li
            class:list={[
              /* Longhand border sides only: `border-0` plus `border-l-[3px]`
                 is a shorthand/longhand ordering gamble in the generated CSS. */
              "rounded-lg border border-line bg-white p-4 xl:rounded-none xl:border-y-0 xl:border-r-0 xl:px-5 xl:py-4",
              /* The xl background lives in both branches on purpose: pairing a
                 shared xl:bg-transparent with a branch xl:bg-gray-200 is a
                 same-variant collision the generated CSS order decides. */
              i === 0
                ? "xl:rounded-r-lg xl:border-l-[3px] xl:border-l-brand-purple xl:bg-gray-200 xl:text-gray-900"
                : "xl:border-l-0 xl:bg-transparent xl:text-gray-500",
            ]}
          >
            <h3 class="text-md font-normal text-gray-900 xl:text-xl xl:leading-xl xl:font-semibold xl:text-inherit">
              {title}
            </h3>
            <p class="mt-2 text-[0.8125rem] leading-xs text-ink-secondary xl:mt-3 xl:text-sm xl:leading-sm xl:text-inherit">
              {body}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</Section>
