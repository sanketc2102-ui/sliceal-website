---
import { getImage } from "astro:assets";

import Section from "../layout/Section.astro";

import panelImage from "../../assets/sliceal-engine/dubai-marina-residences.jpg";
import videoSrc from "../../assets/sliceal-engine/sliceal-engine.mp4";

const posterImage = await getImage({ src: panelImage, width: 598, quality: 70 });

const points = [
  {
    title: "A verified asset, not a Promise",
    body: "130 m² in Umm Suqeim, AED 2,600,000. Title deed registered with the DLD, with your share held as a regulated, asset-backed token.",
  },
  {
    title: "One Square Metre = 10,000 Tokens",
    body: "The deed is divided by area, not by opinion: 130 m² becomes 1,300,000 tokens, each one a legal claim on the same asset.",
  },
  {
    title: "AED 2.00 a token",
    body: "Purchase price ÷ token count. AED 500 buys you 250 tokens — and the rent that comes with them, paid monthly.",
  },
  {
    title: "Tradeable, not trapped",
    body: "After a three-month lock-in you can list your tokens on the Sliceal marketplace, priced within ±15% of the latest DLD valuation.",
  },
];

/*
 * `prefix` is the small grey "AED" that leads the second figure on desktop;
 * `accent` is the purple trailing glyph, purple only from lg. `brand` turns
 * the whole figure purple, which the third one is at both sizes.
 */
const metrics = [
  { label: "Tokens", value: "1,300,000", accent: "+" },
  { label: "Price", prefix: "AED", value: "2.00" },
  { label: "AED 2000 buys", value: "1,000", brand: true },
];

const eyebrow =
  "rounded-pill border border-line px-3 py-1.5 text-xs/[0.875rem] text-brand-purple md:text-sm/5 md:font-semibold md:shadow-pill lg:text-sm/5 lg:font-semibold lg:shadow-pill";

const stackCap = "lg:mx-0 lg:max-w-none";
---

<Section surface="alt" flush class="py-12 md:py-15 lg:py-30" {...Astro.props}>
  <div
    class:list={[
      stackCap,
      "flex flex-col gap-6 md:grid md:grid-cols-2 md:items-start md:gap-x-12.5 md:gap-y-8 lg:grid lg:grid-cols-[653fr_599fr] lg:items-start lg:gap-x-[3.125rem] lg:gap-y-8",
    ]}
  >
    <header
      class="flex flex-col items-center gap-4 text-center md:col-start-1 md:row-start-1 md:items-start md:gap-4.5 md:text-left lg:col-start-1 lg:row-start-1 lg:items-start lg:gap-4.5 lg:text-left"
    >
      <p class={eyebrow}>THE SLICEAL ENGINE</p>

      <h2
        class="text-display-sm-mobile leading-[2.125rem] font-normal tracking-normal text-gray-900 md:text-display-sm md:leading-display-sm md:font-semibold md:tracking-normal lg:max-w-[33.0625rem] lg:text-display-lg lg:leading-display-lg lg:font-medium lg:tracking-tight lg:text-ink"
      >
        One Apartment. 1.3 Million Digital Slices.
      </h2>
    </header>

    {/*
      The card is white on mobile and transparent on desktop, where only the
      graphic panel carries a fill — sampled off both frames.
    */}
    <div
      class="overflow-hidden rounded-2xl border border-line bg-white md:col-start-2 md:row-start-1 md:row-span-2 lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:ml-auto lg:w-full lg:max-w-[37.4375rem] lg:bg-transparent"
    >
      <div
        class="relative aspect-[408/220] border-b border-line bg-slate-50 md:aspect-433/394 md:border-[1.875rem] md:border-white lg:aspect-[598/566] lg:border-x-0 lg:border-t-0 lg:border-b lg:border-line"
      >
        {/*
          The tablet frame insets the video in a white margin instead of
          running it edge-to-edge — a thick white border on this (already
          `relative`) box shrinks the absolutely-positioned video's
          containing block, so `inset-0` insets it automatically with no new
          wrapper element.
        */}
        <video
          data-video-autoplay
          src={videoSrc}
          poster={posterImage.src}
          autoplay
          muted
          playsinline
          loop
          preload="auto"
          class="absolute inset-0 h-full w-full object-cover md:rounded-2xl md:overflow-hidden lg:rounded-none"
        />
      </div>

      <dl
        class="m-0 flex flex-col gap-3 p-4 md:grid md:grid-cols-3 md:gap-0 md:p-0 lg:grid lg:grid-cols-3 lg:gap-0 lg:p-0"
      >
        {
          metrics.map(({ label, prefix, value, accent, brand }, i) => (
            <div
              data-metric
              class:list={[
                "flex items-start justify-between gap-3 opacity-40 transition-opacity duration-500 md:h-27.25 md:flex-col md:justify-center md:gap-2.5 md:border-l md:border-line md:px-5 md:py-2.5 md:first:border-l-0 lg:h-[6.8125rem] lg:flex-col lg:justify-center lg:gap-2.5 lg:border-l lg:border-line lg:px-5 lg:py-2.5 lg:first:border-l-0",
                i === 0 && "opacity-100",
              ]}
            >
              <dt class="text-sm text-ink-muted md:order-2 lg:order-2 lg:text-md lg:leading-md">
                {label}
              </dt>
              {/* m-0 kills the UA stylesheet's 40px margin-inline-start on <dd>. */}
              <dd
                class:list={[
                  "m-0 text-md md:text-display-xs md:leading-display-xs md:font-semibold lg:text-display-xs lg:leading-display-xs lg:font-semibold lg:tracking-normal",
                  brand ? "text-brand-purple" : "text-gray-900 lg:text-ink",
                ]}
              >
                {prefix && (
                  <span class="md:text-md md:leading-md md:font-normal md:text-ink-muted lg:text-md lg:leading-md lg:font-normal lg:text-ink-muted">
                    {prefix}{" "}
                  </span>
                )}
                {value}
                {accent && <span class="md:text-brand-purple lg:text-brand-purple">{accent}</span>}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>

    {/*
      Four cards on mobile; on desktop they become a rail hung off one hairline,
      with the first one filled and tagged by the 3px purple bar.
    */}
    <ul
      class="flex list-none flex-col gap-2 md:col-start-1 md:row-start-2 md:gap-1.5 md:border-l md:border-line lg:col-start-1 lg:row-start-2 lg:max-w-[40.8125rem] lg:gap-1.5 lg:border-l lg:border-line"
    >
      {
        points.map(({ title, body }, i) => (
          <li
            data-point
            class:list={[
              /* Longhand border sides only: `border-0` plus `border-l-[3px]`
                 is a shorthand/longhand ordering gamble in the generated CSS. */
              "rounded-lg border border-line bg-white p-4 md:rounded-none md:border-y-0 md:border-r-0 md:px-5 md:py-4 lg:rounded-none lg:border-y-0 lg:border-r-0 lg:px-5 lg:py-4",
              /* The lg background lives in both branches on purpose: pairing a
                 shared lg:bg-transparent with a branch lg:bg-gray-200 is a
                 same-variant collision the generated CSS order decides. */
              i === 0
                ? "md:rounded-r-lg md:border-l-[3px] md:border-l-brand-purple md:bg-gray-200 md:text-gray-900 lg:rounded-r-lg lg:border-l-[3px] lg:border-l-brand-purple lg:bg-gray-200 lg:text-gray-900"
                : "md:border-l-0 md:bg-transparent md:text-gray-500 lg:border-l-0 lg:bg-transparent lg:text-gray-500",
            ]}
          >
            <h3 class="text-md font-normal text-gray-900 md:text-xl md:leading-xl md:font-semibold md:text-inherit lg:text-xl lg:leading-xl lg:font-semibold lg:text-inherit">
              {title}
            </h3>
            <p class="mt-2 text-[0.8125rem] leading-xs text-ink-secondary md:mt-3 md:text-sm md:leading-sm md:text-inherit lg:mt-3 lg:text-sm lg:leading-sm lg:text-inherit">
              {body}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</Section>

<script>
  import { initEngineVideo } from "../../scripts/engineVideo.js";

  // `astro:page-load` fires after the initial load AND after every
  // subsequent navigation, so this one listener covers both.
  document.addEventListener("astro:page-load", initEngineVideo);

</script>
