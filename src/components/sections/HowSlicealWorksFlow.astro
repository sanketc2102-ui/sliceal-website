---
/**
 * HowSlicealWorksFlow — the four-step "How Sliceal Works" band on the
 * landing page. Desktop/tablet share one card design (bordered white card,
 * "Step N" eyebrow, title, body); mobile's updated frame drops the eyebrow
 * — the title itself is the purple element. No photos, no arrow icon on
 * any tier.
 *
 * Figma: wBTbnZ7DJMzQwgaGC5k0wK
 *   desktop 30717:56034 (1512) — off-white band; the card row is 1720px
 *     wide inside a 1352px column, so the 4th card peeks off the edge —
 *     that overflow is the slider the desktop frame is built around.
 *   tablet  30859:64276 ("tablet" export, 1021) — same 418px card as
 *     desktop, row also overflows its column — same slider treatment.
 *   mobile  32065:153713 ("WorkflowSection", 440) — plain vertical stack,
 *     every card fully visible, no overflow, no slider. Card is a
 *     border-brand-25 (#eeefff) box, p-4, no "Step N" eyebrow — the title
 *     is text-brand-purple directly.
 *
 * Below md the cards render as a static stack. From md up they render
 * inside the shared ui/Carousel so the row can be dragged or paged through,
 * per the explicit ask for a slider on desktop (and matching the tablet
 * frame's identical overflow).
 *
 * Deliberate deviations from the frames:
 *   - Card copy drifts slightly per tier (e.g. step 1's title is "Pick Your
 *     Property" on desktop but "Browse Properties" on tablet + mobile).
 *     Normalised to one copy per step (majority wording) instead of
 *     duplicating text per breakpoint.
 *   - Tablet padding is 20px on 3 cards and 30px on the 4th (Figma slip).
 *     Normalised to 30px everywhere, which also makes the card exactly
 *     418px wide — the same as desktop.
 *   - The carousel's slide gap is the shared Carousel component's fixed
 *     24px track gap, not Figma's 16px — reusing the component as-is beats
 *     forking it over an 8px difference.
 */
import Section from "../layout/Section.astro";
import Carousel from "../ui/Carousel.astro";

const steps = [
  {
    title: "Browse Properties",
    body: "Browse DLD-verified Dubai apartments and villas, each with projected rental yields, title deed details, and an independent valuation — so you invest on facts, not promises.",
  },
  {
    title: "Buy Your Slice",
    body: "Fund from AED 2,000 by bank transfer or wallet top-up. Your tokens are minted on the XRP Ledger and recorded against the DLD title deed — VARA-licensed, legally yours.",
  },
  {
    title: "Earn & Grow",
    body: "Net rental income lands in your wallet on the 5th of every month, in proportion to the tokens you hold. Your property is revalued every 3–6 months by an accredited agency, so appreciation is measured against what you paid.",
  },
  {
    title: "Track & Trade",
    body: "Collect your share of monthly rental income directly to your wallet. After a 3-month lock-in, list your tokens on the Sliceal secondary market anytime — 24/7 liquidity.",
  },
];

const cardInner = "flex flex-col items-center gap-3";
const cardTitle =
  "text-xl leading-xl font-semibold md:text-display-xs md:leading-display-xs md:font-medium";
const cardBody =
  "w-full max-w-[22.375rem] text-sm leading-sm text-ink-muted lg:text-md lg:leading-md";
---

<Section innerClass="flex flex-col gap-6 md:gap-8" class="lg:bg-surface-alt" {...Astro.props}>
  <header
    class="flex flex-col items-center gap-3 text-center md:gap-3.5 lg:gap-6"
  >
    <h2
      class="text-display-sm-mobile leading-8.5 font-medium tracking-normal md:text-display-sm md:leading-display-sm md:font-semibold lg:text-display-2xl lg:leading-display-2xl lg:font-normal lg:tracking-tight"
    >
      How Sliceal Works
    </h2>

    <p class="text-sm leading-sm text-ink-muted md:max-w-148.75 lg:max-w-199.5 lg:text-lg lg:leading-lg">
      Own a share of DLD-verified Dubai real estate in three simple steps — from
      browsing to earning rental income, all on the XRP Ledger.
    </p>
  </header>

  <hr class="w-full" />

  {/* Below md: static vertical stack, every card visible, no slider. */}
  <ol class="m-0 flex list-none flex-col gap-4 p-0 md:hidden">
    {
      steps.map(({ title, body }) => (
        <li class="flex w-full flex-col items-center gap-3 rounded-xl border border-brand-25 bg-surface p-4 text-center">
          <p class:list={[cardTitle, "text-brand-purple dark:text-mint-500"]}>
            {title}
          </p>
          <p class="text-sm leading-sm text-ink-muted">{body}</p>
        </li>
      ))
    }
  </ol>

  {/* md and up: same cards, dragged/paged through the shared carousel — the
      row is wider than the column at both tiers, matching the frames. */}
  <div class="hidden md:block" data-worksflow-carousel>
    <Carousel showArrows>
      {
        steps.map(({ title, body }, i) => (
          <article class="flex w-104.5 shrink-0 flex-col items-center gap-4.5 rounded-xl border border-line bg-surface p-7.5 text-center">
            <p class="text-lg leading-lg tracking-[-0.2px] text-brand-purple dark:text-mint-500">
              Step {i + 1}
            </p>
            <div class={cardInner}>
              <p class:list={[cardTitle, "text-ink"]}>
                {title}
              </p>
              <p class={cardBody}>{body}</p>
            </div>
          </article>
        ))
      }
    </Carousel>
  </div>
</Section>

<script>
  // Trackpad horizontal swipe fires wheel events with deltaX, not pointer
  // drag events, so the shared Carousel's pointer-based drag never sees it.
  // This drives the carousel's own prev/next buttons instead of touching
  // Carousel.astro, so the behavior stays scoped to this section only —
  // clicking a disabled button is a no-op, so first/last-slide clamping
  // comes for free from the carousel's existing bounds logic.
  function initWorksFlowCarouselWheel() {
    const zone = document.querySelector("[data-worksflow-carousel]");

    if (!zone || zone.dataset.wheelInitialized === "true") return;

    zone.dataset.wheelInitialized = "true";

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const viewport = zone.querySelector("[data-carousel-viewport]");
    const prevButton = zone.querySelector("[data-carousel-prev]");
    const nextButton = zone.querySelector("[data-carousel-next]");

    if (!viewport || !prevButton || !nextButton) return;

    let isInView = false;
    let isPaging = false;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          isInView = entry.isIntersecting;
        });
      },
      { threshold: 0.4 },
    );

    observer.observe(viewport);

    viewport.addEventListener(
      "wheel",
      (event) => {
        if (!isInView || isPaging) return;

        // Vertical/diagonal-dominant gestures are page scroll, not paging.
        if (Math.abs(event.deltaY) >= Math.abs(event.deltaX)) return;

        event.preventDefault();

        isPaging = true;
        setTimeout(() => {
          isPaging = false;
        }, 350);

        (event.deltaX > 0 ? nextButton : prevButton).click();
      },
      { passive: false },
    );
  }

  document.addEventListener("astro:page-load", initWorksFlowCarouselWheel);
</script>
