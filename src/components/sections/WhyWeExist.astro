---

import Section from "../layout/Section.astro";

const pillars = [
  {
    number: "01",
    title: "Capital",
    body: "Start building your property portfolio with AED 2,000 in under four minutes.",
  },
  {
    number: "02",
    title: "Liquidity",
    body: "List and sell your tokens on our secondary marketplace 24/7, once the 3-month lock-in ends.",
  },
  {
    number: "03",
    title: "Visibility",
    body: "Ownership records, monthly rental yields, and appraisals sit on-ledger—timestamped and 100% auditable.",
  },
];

const eyebrow =
  "rounded-pill border border-line px-3 py-1.5 text-sm/5 font-semibold text-text-brand shadow-pill";

// Tablet frame (node 30859:64242): headline keeps its 655px design width.
// md+: the <br> sets the Figma two-line break; lg drops the cap so fallback fonts
// wider than SF Pro don't push it to three lines.
const headlineMeasureMd = "md:max-w-[40.9375rem] lg:max-w-none";
---

<Section surface="alt" innerClass="flex flex-col gap-6 lg:gap-7" {...Astro.props}>
  <header class="flex flex-col items-center gap-4 text-center md:gap-6 lg:gap-8">
    <p class={eyebrow}>THE OLD DAY</p>

    <h2
      class:list={[
        headlineMeasureMd,
        "text-display-sm-mobile leading-[2.125rem] font-normal tracking-normal text-ink md:text-display-sm md:font-semibold md:tracking-tight md:text-ink lg:text-display-lg lg:leading-display-lg lg:font-medium lg:tracking-tight lg:text-ink",
      ]}
    >
      Real estate was illiquid, non transparent <br class="hidden md:inline" />and closed.{" "}
      <span class="text-brand-purple">We unlocked it.</span>
    </h2>
  </header>

  {/* global.css already draws hr as the 1px #e9eaeb hairline; lg adds the 2px. */}
  <hr class="md:border-t-2 lg:border-t-2" />

  {/*
    <ol> puts the ordinal in the accessibility tree, so the drawn 01/02/03 is
    aria-hidden rather than read twice. role="list" because VoiceOver drops
    list semantics once list-style is none.
  */}
  <ol
    role="list"
    data-pillars
    class="grid list-none gap-4 md:grid-cols-3 lg:grid-cols-3"
  >
    {
      pillars.map(({ number, title, body }) => (
        <li
          data-pillar
          class="flex flex-wrap items-baseline justify-center gap-x-2 gap-y-2 text-center overflow-clip rounded-xl border border-brand-50 bg-surface px-6 py-7 opacity-0 translate-y-6 transition-all duration-700 ease-out dark:border-line-card md:flex-col md:flex-nowrap md:items-stretch md:justify-start md:gap-4 md:text-left md:p-6 lg:gap-4.5 lg:p-7.5"
        >
          <span class="text-lg font-semibold text-text-brand" aria-hidden="true">
            {number}
          </span>
          {/* Mobile: `contents` lifts title + body into the li's wrap row so the number sits beside the title. */}
          <div class="contents md:flex md:flex-col md:gap-3">
            <h3 class="text-xl font-medium tracking-normal text-ink md:text-display-xs md:font-medium lg:text-display-xs lg:font-medium">
              {title}
            </h3>
            <p class="basis-full text-sm text-ink-secondary md:basis-auto">
              {body}
            </p>
          </div>
        </li>
      ))
    }
  </ol>
</Section>

<script>
  function initPillarReveal() {
    const list = document.querySelector("[data-pillars]");
    if (!list) return;

    const items = Array.from(list.querySelectorAll("[data-pillar]"));
    if (!items.length) return;

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduceMotion) {
      items.forEach((item) => item.classList.remove("opacity-0", "translate-y-6"));
      return;
    }

    const observer = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;

          items.forEach((item, index) => {
            setTimeout(() => {
              item.classList.remove("opacity-0", "translate-y-6");
            }, index * 300);
          });

          obs.unobserve(entry.target);
        });
      },
      { threshold: 0.2 }
    );

    observer.observe(list);
  }

  document.addEventListener("astro:page-load", initPillarReveal);
</script>
