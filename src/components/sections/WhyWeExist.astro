---

import Section from "../layout/Section.astro";

const pillars = [
  {
    number: "01",
    title: "Capital",
    body: "Start building your property portfolio with AED 2,000 in under four minutes.",
  },
  {
    number: "02",
    title: "Liquidity",
    body: "Property tokens clear on our secondary marketplace in seconds after lock-in.",
  },
  {
    number: "03",
    title: "Visibility",
    body: "Ownership records, monthly rental yields, and appraisals sit on-ledger—timestamped and 100% auditable.",
  },
];

const eyebrow =
  "rounded-pill border border-line-brand px-3 py-1.5 text-xs/[0.875rem] text-text-brand md:text-sm/5 md:font-semibold md:shadow-pill lg:text-sm/5 lg:font-semibold lg:shadow-pill";

// Tablet frame (node 30859:64242): headline keeps its 655px design width.
const headlineMeasureMd = "md:max-w-[40.9375rem]";
---

<Section surface="alt" innerClass="flex flex-col gap-6 lg:gap-7" {...Astro.props}>
  <header
    class="flex flex-col items-center gap-4 text-center md:items-start md:gap-6 md:text-left lg:items-start lg:gap-8 lg:text-left"
  >
    <p class={eyebrow}>THE OLD DAY</p>

    <h2
      class:list={[
        headlineMeasureMd,
        "text-display-sm-mobile leading-[2.125rem] font-normal tracking-normal text-ink md:text-display-sm md:font-semibold md:tracking-tight md:text-ink lg:max-w-[40.9375rem] lg:text-display-lg lg:leading-display-lg lg:font-medium lg:tracking-tight lg:text-ink",
      ]}
    >
      Real estate was illiquid, opaque and closed.{" "}
      <span class="text-brand-purple">We unlocked it.</span>
    </h2>
  </header>

  {/* global.css already draws hr as the 1px #e9eaeb hairline; lg adds the 2px. */}
  <hr class="md:border-t-2 lg:border-t-2" />

  {/*
    <ol> puts the ordinal in the accessibility tree, so the drawn 01/02/03 is
    aria-hidden rather than read twice. role="list" because VoiceOver drops
    list semantics once list-style is none.
  */}
  <ol
    role="list"
    data-pillars
    class="grid list-none gap-6 md:grid-cols-3 md:gap-5.5 lg:grid-cols-3 lg:gap-5.5"
  >
    {
      pillars.map(({ number, title, body }) => (
        <li
          data-pillar
          class="flex flex-col gap-3 opacity-0 translate-y-6 transition-all duration-700 ease-out lg:gap-4.5"
        >
          <span class="text-sm font-semibold text-ink-muted" aria-hidden="true">
            {number}
          </span>
          <div class="flex flex-col gap-3">
            <h3 class="text-xl font-semibold tracking-normal text-ink md:text-display-xs md:font-medium lg:text-display-xs lg:font-medium">
              {title}
            </h3>
            <p class="text-sm text-ink-secondary lg:max-w-[22.375rem] lg:text-[0.9375rem] lg:leading-normal">
              {body}
            </p>
          </div>
        </li>
      ))
    }
  </ol>
</Section>

<script>
  function initPillarReveal() {
    const list = document.querySelector("[data-pillars]");
    if (!list) return;

    const items = Array.from(list.querySelectorAll("[data-pillar]"));
    if (!items.length) return;

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduceMotion) {
      items.forEach((item) => item.classList.remove("opacity-0", "translate-y-6"));
      return;
    }

    const observer = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;

          items.forEach((item, index) => {
            setTimeout(() => {
              item.classList.remove("opacity-0", "translate-y-6");
            }, index * 300);
          });

          obs.unobserve(entry.target);
        });
      },
      { threshold: 0.2 }
    );

    observer.observe(list);
  }

  document.addEventListener("astro:page-load", initPillarReveal);
</script>
