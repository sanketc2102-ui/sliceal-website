---
/**
 * Header — the site header, primary navigation, and mobile menu panel.
 *
 * Built mobile-first from three Figma frames in wBTbnZ7DJMzQwgaGC5k0wK:
 *   29879:64371   mobile closed, 440x62 — white band, hairline rule, logo + trigger
 *   29373:156370  desktop, 1512x80 — transparent overlay, logo + nav + two buttons
 *   29403:160818  mobile open, 440x670 — gray-600 scrim + white 20px-radius panel
 *
 * The 440px arrangement is the unprefixed baseline; the desktop row is only
 * ever added on top of it.
 *
 * COLLAPSE POINT — measured from the design, not a generic Tailwind breakpoint.
 * Widths taken from the desktop frame (1432px inner track at 40px gutters):
 *
 *   logo       241  (mark 34 + gap 16 + wordmark 191)
 *   nav        553  (labels 397 + 5 x 8 padding + 4 gaps x 29)
 *   actions    237  (Log In 92 + gap 12 + Start Investing 133)
 *   ---------------
 *   content   1031  at the designed 29px nav gap
 *              987  with the gap tightened to 18px
 *
 * Those label widths are SF Pro metrics, and SF Pro is the WORST case: it is
 * not licensed for the web (tokens.css §5), and the faces that actually render
 * are narrower at 14px — Segoe UI measures x0.905 of the Figma widths, Arial
 * x0.929. So the numbers above are an upper bound on every non-Apple machine.
 *
 * Budgeting a 40px minimum between groups (the header's own --gutter-header,
 * comfortably clear of the 29px nav gap so the three groups still read apart):
 *
 *   full   1031 + 2x40 + 80 gutters = 1191  ->  >= 1200
 *   tight   987 + 2x40 + 80 gutters = 1147  ->  >= 1150
 *
 * Hence:
 *   >= 1200   full Figma spacing, 29px nav gap
 *   >= 1150   desktop row, nav gap tightened to 18px
 *    < 1150   mobile hamburger
 *
 * The arbitrary variants are deliberate: this threshold belongs to this
 * component's content, not to the shared scale, so tokens.css and global.css
 * are left untouched. Re-derive if a nav label is added, removed, or reworded —
 * the labels are the dominant term.
 *
 * Fills BaseLayout's `header` slot and owns its own position and background,
 * as that layout's comment requires.
 *
 * The menu is a <details> so it opens and closes with no JavaScript at all
 * (CLAUDE.md: prefer HTML/CSS over JS). The script below is pure progressive
 * enhancement — Escape, click-outside, scroll lock, and closing on navigation.
 * With JS disabled the menu still opens, closes, and every link works.
 *
 * Props:
 *   class {string} Optional. Extra classes on the <header> element.
 */
import Mark from "../../assets/logo-mark.svg";
import Wordmark from "../../assets/logo-wordmark.svg";
import MenuIcon from "../../assets/icons/menu.svg";
import CloseIcon from "../../assets/icons/menu/close.svg";
import ChevronIcon from "../../assets/icons/menu/chevron-forward.svg";
import IconHome from "../../assets/icons/menu/person_3.svg";
import IconHowItWorks from "../../assets/icons/menu/account-balance.svg";
import IconProperties from "../../assets/icons/menu/account-balance-wallet.svg";
import IconSellProperty from "../../assets/icons/menu/bookmark.svg";
import IconWhySliceal from "../../assets/icons/menu/badge.svg";
import IconFaqs from "../../assets/icons/menu/cart.svg";
import IconContact from "../../assets/icons/menu/settings.svg";

const { class: className = "" } = Astro.props;

const navLinks = [
  { label: "How it Works", href: "/how-it-works" },
  { label: "Properties", href: "/properties" },
  { label: "Sell Your Property", href: "/sell-your-property" },
  { label: "Why Sliceal", href: "/why-sliceal" },
  { label: "FAQs", href: "/faq" },
];

/*
 * The mobile panel carries a second line under each label. The strings below
 * are transcribed verbatim from frame 29403:160818 — they are placeholder copy
 * left over from the banking template the panel was built on ("Your wallet
 * details" under Properties, "View Past Orders" under FAQs) and do not describe
 * what these links actually do. Reproduced as drawn; flagged for the designer.
 * Icon sizes differ per glyph (18 / 22 / 17.32) and come from the frame.
 */
const menuItems = [
  { label: "Home", detail: "View & edit your details", href: "/", Icon: IconHome, iconClass: "size-[18px]" },
  { label: "How it Works", detail: "Manage linked accounts", href: "/how-it-works", Icon: IconHowItWorks, iconClass: "size-[18px]" },
  { label: "Properties", detail: "Your wallet details", href: "/properties", Icon: IconProperties, iconClass: "size-[18px]" },
  { label: "Sell Your Property", detail: "Your bookmarked listings", href: "/sell-your-property", Icon: IconSellProperty, iconClass: "size-[18px]" },
  { label: "Why Sliceal", detail: "Complete Risk Profile", href: "/why-sliceal", Icon: IconWhySliceal, iconClass: "size-[22px]" },
  { label: "FAQs", detail: "View Past Orders", href: "/faq", Icon: IconFaqs, iconClass: "h-[16.67px] w-[17.32px]" },
  { label: "Contact Us", detail: "Biometrics & preferences", href: "/contact-us", Icon: IconContact, iconClass: "size-[18px]" },
];

// 14px / 1.5 / weight 500 — the one type treatment every button and nav label uses.
const labelType = "text-sm font-medium leading-normal";

/*
 * HOVER. Figma draws no hover states (tokens.css §1 NEEDS_DECISION), so these
 * are built from tokens already in the file and kept to one gesture per group:
 *   nav      — a brand hairline that wipes out from the centre, label to brand
 *   buttons  — one step darker + the shadow they already own, 1px lift
 *   logo     — the opacity dip the footer links already use
 * All of it is decorative: nothing here is the only signal that an element is
 * interactive, so touch loses nothing (CLAUDE.md: avoid hover-only). The
 * reduced-motion block in global.css flattens every duration below.
 */
const motion = "transition-colors duration-200 ease-out";
const btnBase = `flex h-11 items-center justify-center rounded-md transition-[background-color,border-color,color,box-shadow,transform] duration-200 ease-out active:translate-y-0 active:shadow-xs`;
const btnSecondary = `${btnBase} border border-black text-ink hover:-translate-y-px hover:bg-gray-100 hover:shadow-md ${labelType}`;
const btnPrimary = `${btnBase} bg-brand-purple py-2.5 pr-2.5 pl-4 text-white hover:-translate-y-px hover:bg-brand-hover hover:shadow-md ${labelType}`;

// Nav label: colour swap plus an underline that scales out from its centre.
// `group` lets the active pill (a sibling span) react to hover on the <a>.
const navLink = `group relative block p-1 text-ink ${motion} hover:text-brand
  after:absolute after:inset-x-1 after:-bottom-px after:h-px after:origin-center
  after:scale-x-0 after:bg-brand after:transition-transform after:duration-200
  after:ease-out after:content-[''] hover:after:scale-x-100`;

/*
 * ACTIVE / CURRENT SECTION.
 *
 * Frame 29373:156370 draws all five labels plain — the website header has no
 * current-page state in Figma. tokens.css does record one, though: Brand/25 is
 * annotated "active nav pill border" (§1) and --shadow-nav "active nav pill"
 * (§10), so the pill below is assembled from those two rather than invented.
 *
 * The frost is real, not a painted tint: on the home page the desktop bar is
 * transparent over the hero photo, so backdrop-blur has something to sample.
 * Everywhere else it sits over #fafafa/white and blurs nothing — which is why
 * the Brand/25 fill is carried at 70% and does the work on its own. (Sampling
 * first is the rule: a Figma "background blur" is usually a flat tint with no
 * source behind it.) The mobile panel is opaque white, so its rows get the
 * tint with no blur at all.
 *
 * The pill is a separate absolutely-positioned span behind the label rather
 * than a background on the <a> itself: being out of flow it never touches the
 * link's own box (layout stays unchanged automatically, no margin-cancelling
 * trick needed), and it gives the pill its own element to carry a
 * `transition:name`. That name is what makes it slide: Astro's ClientRouter
 * (already wired up in BaseLayout) treats same-named elements as one shared
 * element across a navigation, so the browser's View Transition interpolates
 * the old pill's rect into the new one's instead of an instant cut.
 */
const navActiveText = "text-brand after:hidden";
// No backdrop-blur/saturate here: browsers rasterize a named element into a
// flat snapshot for the View Transition, and backdrop-filter has no live
// backdrop to sample inside that snapshot — it was rendering as a blank/washed
// out patch for the slide's whole duration. Per the comment above, the tint
// alone already carries every page this pill appears on (never the
// transparent home-page state), so dropping the filter loses nothing.
const navPill = `pointer-events-none absolute -inset-x-2.5 inset-y-0 -z-10
  rounded-pill bg-brand-25/70 shadow-nav ring-1 ring-brand-25
  group-hover:bg-brand-25`;

/*
 * Exact match for "/", prefix match for everything else (so /properties/burj
 * keeps Properties lit). Compared by INDEX, not href: "Sell Your Property"
 * currently points at /how-it-works, the same route as "How it Works" — an
 * href match would light two pills at once. First match wins until the
 * designer supplies the real /sell route.
 */
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";

// Written inline rather than as a shared helper: the Astro TS plugin does not
// apply frontmatter JSDoc to an arrow parameter, so a helper's `href` reports
// as an implicit any under the project's strict tsconfig. Destructured here,
// it types itself off the array.
const activeIndex = navLinks.findIndex(({ href }) =>
  href === "/" ? path === "/" : path === href || path.startsWith(`${href}/`),
);
const menuActiveIndex = menuItems.findIndex(({ href }) =>
  href === "/" ? path === "/" : path === href || path.startsWith(`${href}/`),
);
---

{/*
  SCROLLED STATE. The desktop frame draws the header transparent over the hero,
  which only works while the page is at rest at the top — scroll and the hero
  photo runs straight under the nav. `data-scrolled` (set by the script below)
  turns the bar into a surface again so it stays legible over whatever passes
  beneath it. Below 1150px the bar is already opaque at every scroll position,
  so only the lift is added there.

  The fill is frosted white rather than a flat one: white/70 over a 24px blur
  and a 150% saturate, the same recipe (one step stronger) as the active nav
  pill above, so the header and the pill read as the same material. Unlike a
  Figma "background blur", this one is real — a sticky bar always has live page
  content running under it for backdrop-filter to sample.

  70% white lands the surface at roughly #fbfbfb over the page's #fafafa
  ground, keeping the slight even step both Figma frames draw while the photo,
  cards, and brand colour underneath stay faintly legible through it. The
  saturate is what stops the blurred hero going grey.

  No @supports fallback: every target browser has backdrop-filter, and where it
  is missing the bar degrades to 70% white over the page — still a surface,
  just a softer one.

  shadow-xs, not shadow-header: the header token is 0.25 alpha, which lands a
  dark 4px smudge on the field below (measured rgb(241 243 244) against 248) —
  a second edge, right where the first one was just removed.
*/}
<header
  data-site-header
  class:list={[
    "sticky top-0 z-50 border-b border-line bg-white",
    "lg:border-b-0 lg:bg-transparent",
    "transition-[background-color,border-color,box-shadow] duration-200",
    "data-scrolled:bg-white/70 data-scrolled:shadow-xs",
    "data-scrolled:backdrop-blur-xl data-scrolled:backdrop-saturate-150",
    // lg:bg-transparent lives in a media query and outranks the base-layer
    // fill above, so the scrolled frost is restated at lg.
    "lg:data-scrolled:border-b lg:data-scrolled:bg-white/70",
    className,
  ]}
>
  <div
    class="container-header flex items-center justify-between gap-4 py-3 lg:h-20 lg:py-0"
  >
    <a
      href="/"
      aria-label="Sliceal — home"
      class="flex shrink-0 items-center gap-4 transition-opacity duration-200 ease-out hover:opacity-80"
    >
      <Mark
        class="h-[35px] w-[26.44px] lg:h-[45px] lg:w-[34px]"
        aria-hidden="true"
      />
      <Wordmark
        class="h-[25px] w-[136.43px] lg:h-[35px] lg:w-[191px]"
        aria-hidden="true"
      />
    </a>

    <nav aria-label="Primary" class="hidden lg:block">
      {/* 18px is the tightened tier; the Figma 29px returns once there is room. */}
      <ul class="flex items-center gap-[18px] min-[1200px]:gap-[29px]">
        {
          navLinks.map(({ label, href }, i) => {
            const isActive = i === activeIndex;
            return (
              <li>
                <a
                  href={href}
                  aria-current={isActive ? "page" : undefined}
                  class:list={[navLink, labelType, isActive && navActiveText]}
                >
                  {isActive && (
                    <span
                      aria-hidden="true"
                      class={navPill}
                      transition:name="nav-active-pill"
                    />
                  )}
                  {label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="hidden lg:flex lg:items-center lg:gap-3">
      <a href="/login" class:list={[btnSecondary, "w-[92px]"]}>
        <span class="p-1">Log In</span>
      </a>
      <a href="/start-investing" class={btnPrimary}>
        <span class="p-1">Start Investing</span>
      </a>
    </div>

    {/*
      <details> is the toggle. `group` lets the summary swap its own icon on
      [open] with no state to track. The 38x38 box is the drawn size; the
      ::before expands the hit area to the 44x44 minimum without changing it.
    */}
    <details data-mobile-menu class="group lg:hidden">
      <summary
        class="relative flex size-[38px] shrink-0 cursor-pointer list-none items-center justify-center rounded-sm bg-gray-100 transition-colors duration-200 ease-out before:absolute before:-inset-[3px] before:content-[''] hover:bg-gray-200 active:bg-gray-300 [&::-webkit-details-marker]:hidden"
      >
        <span class="sr-only">Menu</span>
        <MenuIcon class="size-5 group-open:hidden" aria-hidden="true" />
        <CloseIcon class="hidden size-5 group-open:block" aria-hidden="true" />
      </summary>

      {/* Scrim: gray-600 (#535862), sampled from the frame, below the header. */}
      <div
        data-menu-scrim
        class="fixed inset-x-0 top-[3.875rem] bottom-0 bg-gray-600"
      >
      </div>

      <div
        id="site-menu"
        class="absolute inset-x-4 top-[calc(100%+2px)] max-h-[calc(100dvh-5.25rem)] overflow-y-auto rounded-2xl bg-white p-5 opacity-100 transition-opacity duration-base starting:opacity-0"
      >
        <nav aria-label="Mobile">
          <ul>
            {
              menuItems.map(({ label, detail, href, Icon, iconClass }, i) => (
                <li>
                  <a
                    href={href}
                    aria-current={i === menuActiveIndex ? "page" : undefined}
                    class:list={[
                      "group/row -mx-1.5 flex items-center justify-between gap-3 rounded-lg px-3 py-3 transition-colors duration-200 ease-out hover:bg-gray-100 active:bg-gray-100",
                      // No blur here: the panel is opaque white, so there is
                      // nothing behind the row for a backdrop-filter to sample.
                      i === menuActiveIndex &&
                        "bg-brand-25/70 ring-1 ring-brand-25 hover:bg-brand-25",
                    ]}
                  >
                    <span class="flex items-center gap-3">
                      <span class="flex size-[34px] shrink-0 items-center justify-center rounded-md bg-brand-600">
                        <Icon class={iconClass} aria-hidden="true" />
                      </span>
                      <span class="flex flex-col gap-0.5">
                        <span
                          class:list={[
                            "text-sm font-medium",
                            i === menuActiveIndex ? "text-brand" : "text-gray-900",
                          ]}
                        >
                          {label}
                        </span>
                        <span class="text-xs text-ink-muted">{detail}</span>
                      </span>
                    </span>
                    <ChevronIcon
                      class="size-[18px] shrink-0 transition-transform duration-200 ease-out group-hover/row:translate-x-0.5"
                      aria-hidden="true"
                    />
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="mt-4 flex items-center justify-center gap-3">
          <a href="/login" class:list={[btnSecondary, "flex-1"]}>
            <span class="p-1">Log In</span>
          </a>
          <a href="/start-investing" class:list={[btnPrimary, "flex-1"]}>
            <span class="p-1">Start Investing</span>
          </a>
        </div>

        <div
          class="mt-4 flex items-center justify-between gap-3 border-t border-line pt-[13px] pb-3 text-2xs"
        >
          <p class="text-ink-muted">© 2026 Sliceal. All rights reserved.</p>
          <div class="flex flex-wrap justify-end gap-3 text-brand-purple">
            <a href="/privacy-policy" class="link-underline">Privacy policy</a>
            <a href="/terms-and-conditions" class="link-underline">
              Terms of service
            </a>
          </div>
        </div>
      </div>
    </details>
  </div>
</header>

<style is:global>
  /*
   * Tailwind has no way to target ::view-transition-*() functional
   * pseudo-elements, so this is unavoidably plain CSS — scoped to the pill's
   * own transition name so it can't affect anything else on the page.
   *
   * mix-blend-mode: normal is the fix that actually matters: the UA
   * stylesheet blends ::view-transition-old/new with plus-lighter, which
   * assumes opaque snapshots. The pill's fill is bg-brand-25/70 (translucent),
   * so under plus-lighter the outgoing and incoming snapshots add together
   * mid-crossfade into a washed-out/blank patch instead of smoothly fading.
   *
   * The duration/easing override just matches the slide to the header's own
   * motion tokens instead of the browser's default.
   */
  ::view-transition-group(nav-active-pill),
  ::view-transition-old(nav-active-pill),
  ::view-transition-new(nav-active-pill) {
    animation-duration: var(--transition-duration-base);
    animation-timing-function: var(--ease-out);
  }

  ::view-transition-old(nav-active-pill),
  ::view-transition-new(nav-active-pill) {
    mix-blend-mode: normal;
  }
</style>

<script>
  /*
   * Progressive enhancement only. <details> already opens and closes on its
   * own, so everything here is additive: Escape, click-outside, background
   * scroll lock, closing after navigation, and closing if the viewport grows
   * past the collapse point where the desktop row takes over. Keep the query
   * below in sync with the min-[1180px] variants in the markup.
   */
  /*
   * Scrolled state. There is no HTML/CSS way to do this that is safe across
   * browsers yet (`animation-timeline: scroll()` is Chromium + Safari only), so
   * it is a passive scroll listener rAF-throttled to one class write per frame.
   * Pure enhancement: with JS off the header keeps the transparent desktop
   * treatment the Figma frame draws.
   */
  /*
   * ClientRouter (view transitions) swaps the document on navigation instead
   * of doing a full page load, so this module only ever executes once per
   * session — a top-level `querySelector` call binds to the *first* header/
   * menu and goes stale the moment the next page swaps in a new one.
   *
   * Fix: bind the one-off, per-instance listeners (toggle, in-panel link
   * clicks) inside `initHeader`, which reruns on `astro:page-load` — an
   * event Astro fires after the initial load AND after every subsequent
   * navigation. The listeners that live on `document`/`window` (which persist
   * across navigations) are registered exactly once, at module scope, and
   * re-query the live header/menu each time they fire instead of closing
   * over an element that may already be detached.
   */
  let scrollQueued = false;

  const syncScrolled = () => {
    scrollQueued = false;
    const header = document.querySelector("[data-site-header]");
    if (header) header.toggleAttribute("data-scrolled", window.scrollY > 8);
  };

  window.addEventListener(
    "scroll",
    () => {
      if (scrollQueued) return;
      scrollQueued = true;
      requestAnimationFrame(syncScrolled);
    },
    { passive: true },
  );

  const closeMenu = () => {
    const menu = document.querySelector("[data-mobile-menu]");
    if (menu instanceof HTMLDetailsElement) menu.open = false;
  };

  document.addEventListener("keydown", (event) => {
    const menu = document.querySelector("[data-mobile-menu]");
    if (menu instanceof HTMLDetailsElement && event.key === "Escape" && menu.open) {
      closeMenu();
      menu.querySelector("summary")?.focus();
    }
  });

  document.addEventListener("click", (event) => {
    const menu = document.querySelector("[data-mobile-menu]");
    if (
      menu instanceof HTMLDetailsElement &&
      menu.open &&
      event.target instanceof Node &&
      !menu.contains(event.target)
    ) {
      closeMenu();
    }
  });

  const desktop = window.matchMedia("(width >= 1150px)");
  desktop.addEventListener("change", (event) => {
    if (event.matches) closeMenu();
  });

  const initHeader = () => {
    syncScrolled();

    const menu = document.querySelector("[data-mobile-menu]");
    if (!(menu instanceof HTMLDetailsElement)) return;

    menu.addEventListener("toggle", () => {
      // Set inline rather than via a class so no Tailwind utility has to be
      // kept alive purely for a string that only ever appears in this script.
      document.body.style.overflow = menu.open ? "hidden" : "";
    });

    menu.querySelectorAll("#site-menu a").forEach((link) => {
      link.addEventListener("click", closeMenu);
    });
  };

  document.addEventListener("astro:page-load", initHeader);
</script>