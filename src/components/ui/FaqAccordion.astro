---
/**
 * FaqAccordion — category chip tabs + accordion, reusable across pages.
 *
 * Renders a wrapping row of category chips plus one accordion panel per
 * category, at every breakpoint (Figma node 31918-74915). Only the active
 * category's panel is shown; JS swaps the active state on click. Without
 * JS, the first category's panel still renders and is fully readable — the
 * rest are just a click away from working once JS loads.
 *
 * Each question/answer pair is a native <details>/<summary>, so opening and
 * closing an answer needs no JS at all.
 *
 * Props:
 *   categories {Array<{ id, label, questions: Array<{ question, answer }> }>}
 *   instanceId {string} Optional. Disambiguates ids when this component is
 *              used more than once on the same page. Defaults to "faq".
 */
const { categories, instanceId = "faq" } = Astro.props;

const tabId = (categoryId) => `${instanceId}-tab-${categoryId}`;
const panelId = (categoryId) => `${instanceId}-panel-${categoryId}`;

const activeChipClasses =
  "bg-brand text-white shadow-[0_0_8px_rgba(0,0,0,0.3)] outline outline-2 outline-offset-[-2px] outline-brand-400";
const inactiveChipClasses =
  "bg-surface text-ink-secondary border border-transparent hover:bg-surface-alt hover:text-ink";
---

<div class="faq-accordion flex flex-col gap-8" data-faq-accordion>
  <!-- Chip tabs -->
  <div
    class="flex flex-wrap items-center justify-center gap-2"
    role="tablist"
    aria-label="FAQ categories"
  >
    {
      categories.map((category, index) => (
        <Fragment>
          <button
            type="button"
            id={tabId(category.id)}
            role="tab"
            aria-selected={index === 0 ? "true" : "false"}
            aria-controls={panelId(category.id)}
            tabindex={index === 0 ? 0 : -1}
            data-faq-tab
            data-target={category.id}
            class:list={[
              "shrink-0 rounded-lg px-4 py-2.5 text-sm leading-sm font-semibold whitespace-nowrap transition-colors md:text-base",
              index === 0 ? activeChipClasses : inactiveChipClasses,
            ]}
          >
            {category.label}
          </button>
          {/* Force a line break every 5 chips on desktop, regardless of
              how many would otherwise fit on one row. */}
          {(index + 1) % 5 === 0 && index !== categories.length - 1 && (
            <div class="hidden h-0 basis-full lg:block" aria-hidden="true" />
          )}
        </Fragment>
      ))
    }
  </div>

  <div class="flex flex-col gap-8">
    <!-- Panels -->
    <div class="min-w-0 flex-1" data-faq-panels>
      {
        categories.map((category, index) => (
          <div
            id={panelId(category.id)}
            role="tabpanel"
            aria-labelledby={tabId(category.id)}
            data-faq-panel={category.id}
            class:list={["flex flex-col gap-2 md:gap-2.5 lg:gap-2.5", index !== 0 && "hidden"]}
          >
            {category.questions.map((item) => (
              <details class="group flex flex-col rounded-xl border border-line bg-surface p-4 md:rounded-2xl md:p-5 lg:rounded-2xl lg:p-5">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 [&::-webkit-details-marker]:hidden">
                  <span class="text-sm font-semibold leading-5 text-ink md:text-lg md:leading-normal md:font-medium lg:text-lg lg:leading-normal lg:font-medium">
                    {item.question}
                  </span>

                  <span
                    class="relative flex size-4 shrink-0 items-center justify-center text-brand md:size-6 md:text-ink lg:size-6 lg:text-ink"
                    aria-hidden="true"
                  >
                    <span class="absolute h-0.5 w-2.5 rounded-full bg-current md:w-3.5 lg:w-3.5" />
                    <span class="absolute h-2.5 w-0.5 rounded-full bg-current transition-opacity duration-150 group-open:opacity-0 md:h-3.5 lg:h-3.5" />
                  </span>
                </summary>

                <p class="hidden w-full text-xs leading-xs text-ink-muted group-open:mt-2 group-open:block md:group-open:mt-3.5 md:text-sm md:leading-5 lg:group-open:mt-3.5 lg:text-sm lg:leading-5">
                  {item.answer}
                </p>
              </details>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</div>

<script>
  const ACTIVE_CHIP_CLASSES = [
    "bg-brand",
    "text-white",
    "shadow-[0_0_8px_rgba(0,0,0,0.3)]",
    "outline",
    "outline-2",
    "outline-offset-[-2px]",
    "outline-brand-400",
  ];
  const INACTIVE_CHIP_CLASSES = [
    "bg-surface",
    "text-ink-secondary",
    "border",
    "border-transparent",
    "hover:bg-surface-alt",
    "hover:text-ink",
  ];

  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  // Animates a <details> open/close height with the Web Animations API so
  // reveal feels smooth instead of the native instant snap.
  class AnimatedDetails {
    constructor(details) {
      this.details = details;
      this.summary = details.querySelector(":scope > summary");
      this.animation = null;
      this.isClosing = false;
      this.isExpanding = false;
      this.summary.addEventListener("click", (event) => this.onClick(event));
    }

    onClick(event) {
      event.preventDefault();
      if (this.isClosing || !this.details.open) {
        this.open();
      } else if (this.isExpanding || this.details.open) {
        this.shrink();
      }
    }

    shrink() {
      this.isClosing = true;
      this.details.style.overflow = "hidden";
      const startHeight = `${this.details.offsetHeight}px`;

      // Measure the real closed-box height (includes the container's own
      // padding) instead of just the summary — closing off/on is
      // synchronous so nothing repaints in between.
      this.details.open = false;
      const endHeight = `${this.details.offsetHeight}px`;
      this.details.open = true;

      if (this.animation) this.animation.cancel();
      this.animation = this.details.animate(
        { height: [startHeight, endHeight] },
        { duration: 250, easing: "ease-out" },
      );
      this.animation.onfinish = () => this.onAnimationFinish(false);
      this.animation.oncancel = () => (this.isClosing = false);
    }

    open() {
      this.details.style.overflow = "hidden";
      this.details.style.height = `${this.details.offsetHeight}px`;
      this.details.open = true;
      window.requestAnimationFrame(() => this.expand());
    }

    expand() {
      this.isExpanding = true;
      const startHeight = `${this.details.offsetHeight}px`;

      // Measure the real open-box height (includes padding + the flex gap
      // between summary and answer) rather than summing child heights.
      const pinnedHeight = this.details.style.height;
      this.details.style.height = "auto";
      const endHeight = `${this.details.offsetHeight}px`;
      this.details.style.height = pinnedHeight;

      if (this.animation) this.animation.cancel();
      this.animation = this.details.animate(
        { height: [startHeight, endHeight] },
        { duration: 250, easing: "ease-out" },
      );
      this.animation.onfinish = () => this.onAnimationFinish(true);
      this.animation.oncancel = () => (this.isExpanding = false);
    }

    onAnimationFinish(open) {
      this.details.open = open;
      this.animation = null;
      this.isClosing = false;
      this.isExpanding = false;
      this.details.style.height = "";
      this.details.style.overflow = "";
    }
  }

  const initFaqAccordions = () => {
    document
      .querySelectorAll("[data-faq-accordion]")
      .forEach((accordion) => {
        if (accordion.dataset.faqInitialized === "true") return;
        accordion.dataset.faqInitialized = "true";

        if (!prefersReducedMotion) {
          accordion
            .querySelectorAll("[data-faq-panel] details")
            .forEach((details) => new AnimatedDetails(details));
        }

        const tabs = Array.from(
          accordion.querySelectorAll("[data-faq-tab]"),
        );
        const panels = Array.from(
          accordion.querySelectorAll("[data-faq-panel]"),
        );

        if (!tabs.length || !panels.length) return;

        const activate = (targetId, { focusTab = false } = {}) => {
          tabs.forEach((tab) => {
            const active = tab.dataset.target === targetId;

            tab.setAttribute("aria-selected", active ? "true" : "false");
            tab.tabIndex = active ? 0 : -1;
            tab.classList.remove(...ACTIVE_CHIP_CLASSES, ...INACTIVE_CHIP_CLASSES);
            tab.classList.add(...(active ? ACTIVE_CHIP_CLASSES : INACTIVE_CHIP_CLASSES));

            if (active && focusTab) tab.focus();
          });

          panels.forEach((panel) => {
            panel.classList.toggle(
              "hidden",
              panel.dataset.faqPanel !== targetId,
            );
          });
        };

        tabs.forEach((tab) => {
          tab.addEventListener("click", () => {
            activate(tab.dataset.target);
          });

          tab.addEventListener("keydown", (event) => {
            if (!["ArrowRight", "ArrowLeft", "ArrowDown", "ArrowUp"].includes(event.key)) {
              return;
            }

            event.preventDefault();

            const currentIndex = tabs.indexOf(tab);
            const forward =
              event.key === "ArrowRight" || event.key === "ArrowDown";
            const nextIndex =
              (currentIndex + (forward ? 1 : -1) + tabs.length) % tabs.length;

            activate(tabs[nextIndex].dataset.target, { focusTab: true });
          });
        });
      });
  };

  // ClientRouter swaps the DOM on navigation without a full page load, so a
  // plain top-level call only ever runs once. `astro:page-load` fires after
  // the initial load and after every subsequent navigation.
  document.addEventListener("astro:page-load", initFaqAccordions);
</script>