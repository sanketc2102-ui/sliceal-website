---
const { class: className = "" } = Astro.props;
---

<div class:list={["legal-content", className]}>
  <slot />
</div>

<style>
  .legal-content {
    width: 100%;
    color: rgb(0 0 0 / 60%);
    font-family: "SF Pro", sans-serif;
    font-size: 14px;
    font-weight: 400;
    line-height: 20px;
  }

  .legal-content :global(h2) {
    margin-top: 28px;
    margin-bottom: 8px;
    color: rgb(0 0 0 / 20%);
    font-family: "SF Pro", sans-serif;
    font-size: 18px;
    font-weight: 700;
    line-height: 28px;
  }

  .legal-content :global(h2:first-child) {
    margin-top: 0;
  }

  .legal-content :global(h3) {
    margin-top: 20px;
    margin-bottom: 8px;
    color: rgb(0 0 0 / 20%);
    font-family: "SF Pro", sans-serif;
    font-size: 16px;
    font-weight: 700;
    line-height: 24px;
  }

  .legal-content :global(p) {
    margin-bottom: 12px;
    color: rgb(0 0 0 / 60%);
    font-size: 14px;
    font-weight: 400;
    line-height: 20px;
  }

  .legal-content :global(ul) {
    margin: 0 0 12px;
    padding-left: 20px;
    list-style-type: disc;
  }

  .legal-content :global(ol) {
    margin: 0 0 12px;
    padding-left: 20px;
    list-style-type: decimal;
  }

  .legal-content :global(li) {
    margin-bottom: 4px;
  }

  .legal-content :global(strong) {
    color: rgb(0 0 0 / 60%);
    font-weight: 700;
  }

  .legal-content :global(a) {
    color: rgb(0 0 0 / 60%);
    text-decoration: underline;
  }

  .legal-content :global(hr) {
    margin: 20px 0;
    border: 0;
    border-top: 1px solid rgb(0 0 0 / 10%);
  }
</style>