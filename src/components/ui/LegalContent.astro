---
const { class: className = "" } = Astro.props;
---

<div
  data-legal-content
  class:list={[
    "legal-content",
    "flex",
    "w-full",
    "flex-col",
    className,
  ]}
>
  <slot />
</div>

<script>
  // Figma draws each h2 + its body as a flat row: 20px padding, 14px
  // heading-to-body gap, hairline divider between rows — same at every
  // breakpoint (mobile 30926:59564, tablet 30908:59407, desktop 30508:46896).
  const CARD_CLASSES = [
    "legal-card",
    "flex",
    "flex-col",
    "gap-3.5",
    "border-t",
    "border-line",
    "p-5",
    "first:border-t-0",
  ];
  const BODY_CLASSES = ["legal-card-body", "flex", "flex-col"];

  function wrapIntoCards(root) {
    if (root.dataset.legalCardsApplied === "true") return;

    const nodes = Array.from(root.childNodes);
    const fragment = document.createDocumentFragment();
    let card = null;
    let body = null;

    for (const node of nodes) {
      const isHeading = node.nodeType === 1 && node.tagName === "H2";

      if (isHeading) {
        card = document.createElement("section");
        card.classList.add(...CARD_CLASSES);
        body = document.createElement("div");
        body.classList.add(...BODY_CLASSES);
        card.append(node, body);
        fragment.append(card);
        continue;
      }

      if (body) {
        body.append(node);
      } else {
        fragment.append(node);
      }
    }

    root.replaceChildren(fragment);
    root.dataset.legalCardsApplied = "true";
  }

  function init() {
    document
      .querySelectorAll("[data-legal-content]")
      .forEach(wrapIntoCards);
  }

  init();
  document.addEventListener("astro:page-load", init);
</script>

<style>
  /* Mobile (Figma 30926:59564): 12/18 body, 12px between blocks, 18px
     bullet indent. */
  .legal-content {
    color: var(--color-text-secondary);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-regular);
    line-height: var(--leading-xs);
  }

  .legal-content :global(h2) {
    margin: 28px 0 14px;
    color: var(--color-text-heading);
    font-size: var(--text-lg);
    font-weight: var(--font-weight-bold);
    line-height: var(--leading-normal);
    letter-spacing: normal;
  }

  .legal-content :global(.legal-card > h2) {
    margin: 0;
  }

  /* Markdown headings are written `## **1. Title**` — keep the <strong>
     from repainting them in body grey. */
  .legal-content :global(h2 strong),
  .legal-content :global(h3 strong) {
    color: inherit;
  }

  .legal-content :global(h3) {
    margin: 20px 0 8px;
    color: var(--color-text-heading);
    font-size: var(--text-md);
    font-weight: var(--font-weight-bold);
    line-height: var(--leading-md);
    letter-spacing: normal;
  }

  .legal-content :global(p),
  .legal-content :global(ul),
  .legal-content :global(ol) {
    margin: 0 0 12px;
  }

  .legal-content :global(ul),
  .legal-content :global(ol) {
    padding-left: 18px;
  }

  .legal-content :global(ul) {
    list-style-type: disc;
  }

  .legal-content :global(ol) {
    list-style-type: decimal;
  }

  /* Loose markdown lists wrap each item in a <p>; Figma stacks items flush. */
  .legal-content :global(li > p) {
    margin: 0;
  }

  .legal-content :global(.legal-card-body > *:last-child) {
    margin-bottom: 0;
  }

  .legal-content :global(strong) {
    font-weight: var(--font-weight-bold);
  }

  .legal-content :global(a) {
    text-decoration: underline;
  }

  .legal-content :global(hr) {
    margin: 20px 0;
  }

  /* Tablet + desktop (Figma 30908:59407, 30508:46896): 14/21 body, blocks
     stacked with no gap, 21px bullet indent. Consecutive paragraphs never
     appear in the frame; they keep a 12px gap so they stay distinguishable. */
  @media (width >= 48rem) {
    .legal-content {
      font-size: var(--text-sm);
      line-height: var(--leading-normal);
    }

    .legal-content :global(p),
    .legal-content :global(ul),
    .legal-content :global(ol) {
      margin-bottom: 0;
    }

    .legal-content :global(p + p) {
      margin-top: 12px;
    }

    .legal-content :global(ul),
    .legal-content :global(ol) {
      padding-left: 21px;
    }
  }
</style>
