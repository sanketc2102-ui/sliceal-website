---
/**
 * HowSlicealWorksSection — alternating StepRow layout shared by the
 * standalone /how-it-works page and the homepage's "how you make money"
 * section. Same chrome (heading, subtitle, step card, phone visual, DLD
 * Verified badge) either way — only the heading slot, `breadcrumb`, and
 * `steps` data change per caller.
 *
 * Each step renders either a checkmark `points` list (how-it-works) or a
 * `stats` card row (homepage) under its description — pass whichever the
 * design calls for.
 *
 * Usage:
 *   <HowSlicealWorksSection breadcrumb={[{ label: "How it Works" }]} subtitle="...">
 *     How Sliceal <span class="text-brand-purple">Works</span>
 *   </HowSlicealWorksSection>
 */
import { Image } from "astro:assets";
import Section from "../layout/Section.astro";
import StepRow from "./StepRow.astro";
import Breadcrumb from "../ui/Breadcrumb.astro";

/**
 * @typedef {Object} Step
 * @property {string} [eyebrow]
 * @property {string} [title] plain title, used when `highlight` is absent
 * @property {string} [prefix] text before the purple `highlight`
 * @property {string} [highlight] purple-highlighted portion of the title
 * @property {string} [suffix] text after the purple `highlight`
 * @property {string} description
 * @property {string[]} [points] checkmark list (how-it-works variant)
 * @property {{value: string, suffix?: string, label: string}[]} [stats] stat cards (homepage variant)
 * @property {ImageMetadata} image
 * @property {string} [imageAlt]
 */

const {
  as: HeadingTag = "h1",
  subtitle,
  breadcrumb,
  /** @type {Step[]} */
  steps = [],
  alternate = true,
} = Astro.props;
---

<Section surface="alt" innerClass="flex flex-col gap-16 lg:gap-24">
  <header class="flex w-full flex-col items-center gap-4 text-center">
    {breadcrumb && <Breadcrumb trail={breadcrumb} />}

    <HeadingTag
      class="w-full max-w-[680px] text-center text-2xl leading-8 text-gray-900 lg:text-5xl lg:leading-[60px]"
    >
      <slot />
    </HeadingTag>

    <p
      class="w-full max-w-[680px] text-center text-sm leading-5 text-gray-500 lg:text-lg lg:leading-7"
    >
      {subtitle}
    </p>
  </header>

  <div class="flex w-full flex-col gap-16 lg:gap-24">
    {
      steps.map((step, i) => (
        <StepRow eyebrow={step.eyebrow} reverse={alternate && i % 2 === 1}>
          <div class="contents lg:flex lg:flex-col lg:items-start lg:gap-0">
            <h3 class="max-w-xl text-lg leading-7 text-gray-900 lg:text-3xl lg:leading-9">
              {step.highlight ? (
                <>
                  {step.prefix}
                  <span class="text-brand-purple">{step.highlight}</span>
                  {step.suffix}
                </>
              ) : (
                step.title
              )}
            </h3>

            <p class="max-w-xl text-xs leading-[18px] text-gray-500 lg:mt-[26px] lg:text-base lg:leading-6">
              {step.description}
            </p>

            {step.points && (
              <ul class="flex max-w-xl flex-col gap-2 text-left lg:mt-4">
                {step.points.map((point) => (
                  <li class="flex items-start gap-2 text-sm leading-5 text-gray-600">
                    <svg
                      viewBox="0 0 20 20"
                      fill="none"
                      class="mt-0.5 size-4 shrink-0 text-indigo-500"
                      aria-hidden="true"
                    >
                      <circle cx="10" cy="10" r="9" stroke="currentColor" stroke-width="1.3" />
                      <path
                        d="m6.5 10 2.3 2.3L13.5 7.8"
                        stroke="currentColor"
                        stroke-width="1.3"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                    {point}
                  </li>
                ))}
              </ul>
            )}

            {step.stats && (
              <div class="flex w-full max-w-xl flex-wrap gap-3 lg:mt-[18px]">
                {step.stats.map((stat) => (
                  <div class="flex min-w-[9rem] flex-1 flex-col items-center gap-1 rounded-xl border border-gray-200 bg-white px-3 py-2 shadow-[0_0_3px_rgba(0,0,0,0.1)]">
                    <p class="text-xl font-semibold text-gray-900 lg:text-2xl">
                      {stat.value}
                      <span class="text-brand-purple">{stat.suffix}</span>
                    </p>
                    <p class="text-center text-xs leading-[18px] text-gray-500 lg:text-sm">
                      {stat.label}
                    </p>
                  </div>
                ))}
              </div>
            )}
          </div>

          <Fragment slot="visual">
            <div
              class="
                relative
                h-[396px]
                w-full
                max-w-[360px]
                overflow-hidden
                rounded-[20px]
                border
                border-gray-200
                bg-white
                shadow-lg

                lg:h-[368px]
                lg:w-[500px]
                lg:max-w-none
              "
            >
              <Image
                src={step.image}
                alt={step.imageAlt ?? ""}
                class="
                  absolute
                  left-1/2
                  top-9
                  w-[243px]
                  max-w-none
                  -translate-x-1/2

                  lg:top-8
                  lg:w-[330px]
                "
                loading="lazy"
              />

              <div
                class="
                  absolute
                  right-0
                  top-[324px]
                  flex
                  items-center
                  gap-2
                  rounded-full
                  border
                  border-gray-200
                  bg-white
                  px-3
                  py-1.5
                  shadow-sm

                  lg:hidden
                "
              >
                <svg viewBox="0 0 20 20" fill="none" class="size-3 shrink-0 text-indigo-500" aria-hidden="true">
                  <circle cx="10" cy="10" r="9" stroke="currentColor" stroke-width="1.3" />
                  <path
                    d="m6.5 10 2.3 2.3L13.5 7.8"
                    stroke="currentColor"
                    stroke-width="1.3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
                <span class="text-xs font-medium text-gray-500">DLD Verified</span>
              </div>
            </div>
          </Fragment>
        </StepRow>
      ))
    }
  </div>
</Section>
