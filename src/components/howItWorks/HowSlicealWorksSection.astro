---

import Section from "../layout/Section.astro";
import StepRow from "./StepRow.astro";
import PropertyPreviewCard from "./PropertyPreviewCard.astro";
import Breadcrumb from "../ui/Breadcrumb.astro";

import goldLeft from "../../assets/own-slice/gold-left.png";
import goldMiddle from "../../assets/own-slice/gold-middle.png";
import goldRight from "../../assets/own-slice/gold-right.png";

const portfolioStats = [
  { label: "TOTAL INVESTED", value: "৳175,000" },
  { label: "PORTFOLIO VALUE", value: "৳196,840", delta: "+12.45%" },
  { label: "TOTAL RENTAL INCOME", value: "৳14,350", delta: "+6.68%" },
  { label: "PROJECTED ROI", value: "12.50%" },
];

const steps = [
  {
    eyebrow: "STEP 01",
    title: "Browse Properties",
    description:
      "Browse DLD-verified Dubai apartments and villas, each with projected rental yields, title deed details, and an independent valuation — so you invest on facts, not promises.",
    points: [
      "DLD verified properties only",
      "Projected yields & independent valuation transparently listed",
    ],
    visual: "properties",
  },
  {
    eyebrow: "STEP 02",
    title: "Purchase Tokens",
    description:
      "Fund from AED 2,000 via bank transfer or digital wallet. Your tokens are minted on the XRP Ledger and held in a regulated SPV — VARA-licensed, legally yours.",
    points: [
      "Start with as low as AED 2,000",
      "Tokens minted securely on the XRP Ledger",
    ],
    visual: "property",
  },
  {
    eyebrow: "STEP 03",
    title: "Earn & Grow",
    description:
      "Net rental income lands in your wallet on the 5th of every month, in proportion to the tokens you hold. Your property is revalued every 3–6 months by an accredited agency, so appreciation is measured against what you paid.",
    points: [
      "Rental income distributed monthly",
      "Revalued every 3–6 months by an accredited agency",
    ],
    visual: "portfolio",
  },
  {
    eyebrow: "STEP 04",
    title: "Track & Trade",
    description:
      "Follow rent received and current value in your portfolio dashboard. After a 3-month lock-in, list your tokens on the Sliceal secondary market anytime for 24/7 liquidity.",
    points: [
      "Track rent and value in your portfolio dashboard",
      "Trade on secondary market after 3 months",
    ],
    visual: "dashboard",
  },
];

---

<Section surface="alt" innerClass="flex flex-col gap-16 lg:gap-24">
  <!-- Heading -->
  <header class="flex w-full flex-col items-center gap-4 text-center">
    <Breadcrumb trail={[{ label: "How it Works" }]} />

    <h1
      class="w-full max-w-[680px] text-center text-2xl leading-8 text-gray-900 lg:text-5xl lg:leading-[60px]"
    >
      How Sliceal <span class="text-brand-purple">Works</span>
    </h1>

    <p
      class="w-full max-w-[680px] text-center text-sm leading-5 text-gray-500 lg:text-lg lg:leading-7"
    >
      Own a share of DLD-verified Dubai real estate in three simple steps — from browsing to earning
      rental income, all on the XRP Ledger.
    </p>
  </header>

  <!-- Steps -->
  <div class="flex w-full flex-col gap-16 lg:gap-24">
    {
      steps.map((step, i) => (
        <StepRow eyebrow={step.eyebrow} reverse={i % 2 === 1}>
          <h3 class="max-w-xl text-lg leading-7 text-gray-900 lg:text-3xl lg:leading-9">
            {step.title}
          </h3>

          <p class="max-w-xl text-xs leading-[18px] text-gray-500 lg:text-base lg:leading-6">
            {step.description}
          </p>

          <ul class="flex max-w-xl flex-col gap-2 text-left">
            {step.points.map((point) => (
              <li class="flex items-start gap-2 text-sm leading-5 text-gray-600">
                <svg
                  viewBox="0 0 20 20"
                  fill="none"
                  class="mt-0.5 size-4 shrink-0 text-indigo-500"
                  aria-hidden="true"
                >
                  <circle
                    cx="10"
                    cy="10"
                    r="9"
                    stroke="currentColor"
                    stroke-width="1.3"
                  />
                  <path
                    d="m6.5 10 2.3 2.3L13.5 7.8"
                    stroke="currentColor"
                    stroke-width="1.3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>

                {point}
              </li>
            ))}
          </ul>

          <Fragment slot="visual">
            {
              step.visual === "property" && (
                <PropertyPreviewCard />
              )
            }

            {
              step.visual === "properties" && (
                <div
                  class="
                    relative
                    h-[396px]
                    w-full
                    max-w-[360px]
                    overflow-hidden
                    rounded-[20px]
                    border
                    border-gray-200
                    bg-white
                    shadow-lg

                    lg:h-[368px]
                    lg:w-[500px]
                    lg:max-w-none
                  "
                >
                  <img
                    src={goldLeft.src}
                    alt="Sliceal property browsing app"
                    class="
                      absolute
                      left-1/2
                      top-9
                      w-[243px]
                      max-w-none
                      -translate-x-1/2

                      lg:top-8
                      lg:w-[330px]
                    "
                    loading="lazy"
                  />

                  <div
                    class="
                      absolute
                      right-0
                      top-[324px]
                      flex
                      items-center
                      gap-2
                      rounded-full
                      border
                      border-gray-200
                      bg-white
                      px-3
                      py-1.5
                      shadow-sm

                      lg:hidden
                    "
                  >
                    <svg viewBox="0 0 20 20" fill="none" class="size-3 shrink-0 text-indigo-500" aria-hidden="true">
                      <circle cx="10" cy="10" r="9" stroke="currentColor" stroke-width="1.3" />
                      <path
                        d="m6.5 10 2.3 2.3L13.5 7.8"
                        stroke="currentColor"
                        stroke-width="1.3"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                    <span class="text-xs font-medium text-gray-500">DLD Verified</span>
                  </div>
                </div>
              )
            }

            {
              step.visual === "portfolio" && (
                <div
                  class="
                    relative
                    h-[396px]
                    w-full
                    max-w-[360px]
                    overflow-hidden
                    rounded-[20px]
                    border
                    border-gray-200
                    bg-white
                    shadow-lg

                    lg:h-[368px]
                    lg:w-[500px]
                    lg:max-w-none
                  "
                >
                  <img
                    src={goldMiddle.src}
                    alt="Sliceal investment portfolio"
                    class="
                      absolute
                      left-1/2
                      top-9
                      w-[243px]
                      max-w-none
                      -translate-x-1/2

                      lg:top-8
                      lg:w-[330px]
                    "
                    loading="lazy"
                  />

                  <div
                    class="
                      absolute
                      right-0
                      top-[324px]
                      flex
                      items-center
                      gap-2
                      rounded-full
                      border
                      border-gray-200
                      bg-white
                      px-3
                      py-1.5
                      shadow-sm

                      lg:hidden
                    "
                  >
                    <svg viewBox="0 0 20 20" fill="none" class="size-3 shrink-0 text-indigo-500" aria-hidden="true">
                      <circle cx="10" cy="10" r="9" stroke="currentColor" stroke-width="1.3" />
                      <path
                        d="m6.5 10 2.3 2.3L13.5 7.8"
                        stroke="currentColor"
                        stroke-width="1.3"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                    <span class="text-xs font-medium text-gray-500">DLD Verified</span>
                  </div>
                </div>
              )
            }

            {
              step.visual === "dashboard" && (
                <div
                  class="
                    relative
                    h-[396px]
                    w-full
                    max-w-[360px]
                    overflow-hidden
                    rounded-[20px]
                    border
                    border-gray-200
                    bg-white
                    shadow-lg

                    lg:h-[368px]
                    lg:w-[500px]
                    lg:max-w-none
                  "
                >
                  <img
                    src={goldRight.src}
                    alt="Sliceal investment dashboard"
                    class="
                      absolute
                      left-1/2
                      top-9
                      w-[243px]
                      max-w-none
                      -translate-x-1/2

                      lg:top-8
                      lg:w-[330px]
                    "
                    loading="lazy"
                  />

                  <div
                    class="
                      absolute
                      right-0
                      top-[324px]
                      flex
                      items-center
                      gap-2
                      rounded-full
                      border
                      border-gray-200
                      bg-white
                      px-3
                      py-1.5
                      shadow-sm

                      lg:hidden
                    "
                  >
                    <svg viewBox="0 0 20 20" fill="none" class="size-3 shrink-0 text-indigo-500" aria-hidden="true">
                      <circle cx="10" cy="10" r="9" stroke="currentColor" stroke-width="1.3" />
                      <path
                        d="m6.5 10 2.3 2.3L13.5 7.8"
                        stroke="currentColor"
                        stroke-width="1.3"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                    <span class="text-xs font-medium text-gray-500">DLD Verified</span>
                  </div>
                </div>
              )
            }
          </Fragment>
        </StepRow>
      ))
    }
  </div>
</Section>