---
/**
 * HowSlicealWorksSection — alternating StepRow layout shared by the
 * standalone /how-it-works page and the homepage's "how you make money"
 * section. Same chrome (heading, subtitle, step card, phone visual, DLD
 * Verified badge) either way — only the heading slot, `breadcrumb`, and
 * `steps` data change per caller.
 *
 * Each step renders either a checkmark `points` list (how-it-works) or a
 * `stats` card row (homepage) under its description — pass whichever the
 * design calls for.
 *
 * Usage:
 *   <HowSlicealWorksSection breadcrumb={[{ label: "How it Works" }]} subtitle="...">
 *     How Sliceal <span class="text-brand-purple">Works</span>
 *   </HowSlicealWorksSection>
 */
import { Image } from "astro:assets";
import Section from "../layout/Section.astro";
import StepRow from "./StepRow.astro";
import Breadcrumb from "../ui/Breadcrumb.astro";
import dirhamSymbol from "../../assets/icons/dirham-symbol.png";

/**
 * @typedef {Object} Step
 * @property {string} [eyebrow]
 * @property {string} [title] plain title, used when `highlight` is absent
 * @property {string} [prefix] text before the purple `highlight`
 * @property {string} [highlight] purple-highlighted portion of the title
 * @property {string} [suffix] text after the purple `highlight`
 * @property {string} description
 * @property {string[]} [points] checkmark list (how-it-works variant)
 * @property {{value: string, suffix?: string, label: string}[]} [stats] stat cards (homepage variant)
 * @property {ImageMetadata} image
 * @property {string} [imageAlt]
 */

// Heading, subtitle, each step's text, and each step's image are split
// into separate data-reveal stages (rather than one wrapped header block,
// the convention elsewhere) so they cascade in on scroll: heading, then
// subtitle, then a step's content, then that step's image.
const {
  as: HeadingTag = "h1",
  subtitle,
  breadcrumb,
  /** @type {Step[]} */
  steps = [],
  alternate = true,
  // Mobile only: steps become a swipeable scroll-snap row with dots
  // (homepage, Figma 32065:153740). md+ is the stacked layout either way.
  carousel = false,
  "data-reveal": _dataReveal,
  ...rest
} = Astro.props;
---

<Section surface="alt" innerClass="flex flex-col gap-16 md:gap-[34px] lg:gap-24" {...rest}>
  <header class="flex w-full flex-col items-center gap-4 text-center">
    {breadcrumb && <Breadcrumb trail={breadcrumb} />}

    <HeadingTag
      class="w-full max-w-[680px] text-center text-2xl leading-8 font-semibold text-ink md:text-[30px] md:leading-[38px] lg:text-5xl lg:leading-[60px] lg:font-medium"
      data-reveal
    >
      <slot />
    </HeadingTag>

    <p
      class="w-full max-w-[680px] text-center text-sm leading-5 text-ink-muted lg:text-lg lg:leading-7"
      data-reveal
    >
      {subtitle}
    </p>
  </header>

  <div
    class:list={[
      "flex md:flex-col md:gap-[34px] lg:gap-24",
      carousel
        ? "-mx-4 snap-x snap-mandatory scroll-px-4 gap-4 overflow-x-auto px-4 scrollbar-none md:mx-0 md:w-full md:snap-none md:overflow-visible md:px-0"
        : "w-full flex-col gap-16",
    ]}
    data-steps-track={carousel ? "" : undefined}
  >
    {
      steps.map((step, i) => (
        <StepRow
          eyebrow={step.eyebrow}
          reverse={alternate && i % 2 === 1}
          class={carousel ? "w-full shrink-0 snap-center md:shrink" : ""}
        >
          <div
            class="contents md:flex md:flex-col md:items-start md:gap-0 lg:flex lg:flex-col lg:items-start lg:gap-0"
            data-reveal
          >
            <h3 class="max-w-xl text-lg leading-7 font-semibold text-ink md:text-[30px] md:leading-[38px] lg:text-3xl lg:leading-9 lg:font-medium">
              {step.highlight ? (
                <>
                  {step.prefix}
                  {/* Desktop: always two lines — a prefixed highlight drops to
                      line 2; otherwise the suffix does, leaving its leading
                      punctuation ("Liquidity,") on line 1. */}
                  <span class:list={["text-brand-purple", step.prefix && "lg:block"]}>{step.highlight}</span>
                  {step.suffix && (
                    <>
                      {step.suffix.match(/^[,.:;]?/)[0]}{" "}
                      <span class="lg:block">{step.suffix.replace(/^[,.:;]?\s*/, "")}</span>
                    </>
                  )}
                </>
              ) : (
                step.title
              )}
            </h3>

            <p class="max-w-xl text-xs leading-[18px] text-ink-muted md:mt-[26px] md:text-sm md:leading-5 lg:mt-[26px] lg:text-base lg:leading-6">
              {step.description}
            </p>

            {step.points && (
              <ul class="flex max-w-xl flex-col gap-2 text-left md:mt-[18px] lg:mt-4">
                {step.points.map((point) => (
                  <li class="flex items-start gap-2 text-sm leading-5 text-ink-secondary">
                    <svg
                      viewBox="0 0 20 20"
                      fill="none"
                      class="mt-0.5 size-4 shrink-0 text-indigo-500 dark:text-mint-500"
                      aria-hidden="true"
                    >
                      <circle cx="10" cy="10" r="9" stroke="currentColor" stroke-width="1.3" />
                      <path
                        d="m6.5 10 2.3 2.3L13.5 7.8"
                        stroke="currentColor"
                        stroke-width="1.3"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                    {point}
                  </li>
                ))}
              </ul>
            )}

            {step.stats && (
              <div class="flex w-full max-w-xl flex-wrap gap-3 md:mt-[18px] lg:mt-[18px]">
                {step.stats.map((stat) => (
                  <div class="flex min-w-[9rem] flex-1 flex-col items-left gap-1 rounded-xl border border-line bg-surface px-3 py-2 shadow-[0_0_3px_rgba(0,0,0,0.1)] md:flex-none md:basis-[calc(50%-6px)]">
                    <p class="text-xl font-semibold text-ink md:text-2xl lg:text-2xl">
                      {stat.value.startsWith("AED") ? (
                        <span class="inline-flex items-center gap-1 align-middle">
                          <Image src={dirhamSymbol} alt="AED" class="h-[0.8em] w-auto" />
                          {stat.value.replace(/^AED\s*/, "")}
                        </span>
                      ) : (
                        stat.value
                      )}
                      <span class="text-brand-purple">{stat.suffix}</span>
                    </p>
                    <p class="text-left  text-xs leading-[18px] text-ink-muted md:text-sm md:leading-5 lg:text-sm">
                      {stat.label}
                    </p>
                  </div>
                ))}
              </div>
            )}
          </div>

          <Fragment slot="visual">
            <div
              class="
                relative
                h-[396px]
                w-full
                max-w-[360px]
                overflow-hidden
                rounded-[20px]
                border
                border-line
                bg-surface
                shadow-lg

                md:h-[414px]
                md:max-w-[420px]

                lg:h-[368px]
                lg:w-[500px]
                lg:max-w-none
              "
              data-reveal
            >
              <Image
                src={step.image}
                alt={step.imageAlt ?? ""}
                class="
                  absolute
                  left-1/2
                  top-9
                  w-[243px]
                  max-w-none
                  -translate-x-1/2

                  md:top-8
                  md:h-auto
                  md:w-4/5
                  md:object-contain

                  lg:top-8
                  lg:h-auto
                  lg:w-[330px]
                  lg:object-contain
                "
                loading="lazy"
              />

              <div
                class="
                  absolute
                  right-0
                  top-[324px]
                  flex
                  items-center
                  gap-2
                  rounded-full
                  border
                  border-line
                  bg-surface
                  px-3
                  py-1.5
                  shadow-sm

                  lg:hidden
                "
              >
                <svg viewBox="0 0 20 20" fill="none" class="size-3 shrink-0 text-indigo-500 dark:text-mint-500" aria-hidden="true">
                  <circle cx="10" cy="10" r="9" stroke="currentColor" stroke-width="1.3" />
                  <path
                    d="m6.5 10 2.3 2.3L13.5 7.8"
                    stroke="currentColor"
                    stroke-width="1.3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
                <span class="text-xs font-medium text-ink-muted">DLD Verified</span>
              </div>
            </div>
          </Fragment>
        </StepRow>
      ))
    }
  </div>

  {
    carousel && (
      <div class="-mt-8 flex items-center justify-center gap-1 md:hidden" data-steps-dots>
        {steps.map((_, i) => (
          <button
            type="button"
            class="group flex h-11 items-center"
            aria-label={`Go to step ${i + 1}`}
            aria-current={i === 0 ? "true" : "false"}
            data-steps-dot={i}
          >
            <span class="h-2.5 w-5 rounded-md bg-[var(--color-control-disabled-bg)] transition-all duration-200 group-aria-[current=true]:w-8 group-aria-[current=true]:bg-indigo-500" />
          </button>
        ))}
      </div>
    )
  }
</Section>

<script>
  const initStepCarousels = () => {
    document.querySelectorAll("[data-steps-track]").forEach((track) => {
      const dots = Array.from(track.parentElement?.querySelectorAll("[data-steps-dot]") ?? []);
      const slides = Array.from(track.children);
      if (!dots.length) return;

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const index = slides.indexOf(entry.target);
            dots.forEach((dot, i) => dot.setAttribute("aria-current", String(i === index)));
          });
        },
        { root: track, threshold: 0.6 },
      );
      slides.forEach((slide) => observer.observe(slide));

      dots.forEach((dot, i) =>
        dot.addEventListener("click", () =>
          slides[i].scrollIntoView({ inline: "center", block: "nearest", behavior: "smooth" }),
        ),
      );
    });
  };

  document.addEventListener("astro:page-load", initStepCarousels);
</script>
