---
import { Image } from "astro:assets";

const {
  image,
  badge = "3 YEARS",
  verified = true,
  title = "One Bedroom in Business Bay",
  location = "Business Bay, Dubai",
  investors = "241 Investors Joined",
  stats = [
    { label: "PROJECT ROI", value: "12.2%" },
    { label: "GROSS YIELD", value: "9.2%" },
  ],
} = Astro.props;
---

<div class="w-full max-w-[340px] overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-lg">
  <div class="relative h-32 bg-linear-to-br from-brand-purple/30 to-brand-800/40">
    {image && (
      <Image
        src={image}
        alt={title}
        class="absolute inset-0 h-full w-full object-cover"
      />
    )}

    <span class="absolute left-3 top-3 rounded-full bg-white/90 px-2 py-1 text-[10px] font-bold text-gray-700">
      {badge}
    </span>

    {verified && (
      <span class="absolute right-3 top-3 inline-flex items-center gap-1 rounded-full bg-white/90 px-2 py-1 text-[10px] font-bold text-indigo-600">
        DLD Verified
      </span>
    )}
  </div>

  <div class="flex flex-col gap-3 p-4">
    <div>
      <p class="text-xs leading-4 text-gray-500">{location}</p>
      <h4 class="text-sm font-bold leading-5 text-gray-900">{title}</h4>
    </div>

    <p class="text-[10px] leading-3 text-gray-400">{investors}</p>

    <div class="grid grid-cols-2 gap-2">
      {stats.map((s) => (
        <div class="rounded-lg bg-gray-50 p-2">
          <p class="text-[9px] font-bold leading-3 text-gray-400">{s.label}</p>
          <p class="text-sm font-bold leading-4 text-indigo-600">{s.value}</p>
        </div>
      ))}
    </div>
  </div>
</div>