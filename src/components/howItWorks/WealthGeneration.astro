---

import Section from "../layout/Section.astro";
import MetricCard from "../cards/MetricCard.astro";
import passiveIncomeIcon from "../../assets/icons/howItWorks/coins.svg";
import liquidityIcon from "../../assets/icons/howItWorks/shuffle.svg";
import appreciationIcon from "../../assets/icons/howItWorks/trending-up.svg";

const cards = [
  {
    icon: passiveIncomeIcon,
    title: "Earn consistent passive income",
    description:
      "Build a new income stream from the monthly rent paid by income-generating properties.",
    value: "5.6%",
    label: "Average Rental Yield in 2025",
  },
  {
    icon: appreciationIcon,
    title: "Long-term capital appreciation",
    description:
      "Watch your asset value grow as premium Dubai property prices appreciate over time, building generational wealth.",
    value: "30+",
    label: "Properties listed & funded",
  },
  {
    icon: liquidityIcon,
    title: "Liquidity, when you need it most",
    description:
      "Exit your investments on your own terms. List your tokens on the marketplace after just a 3-month lock-in period.",
    value: "AED 16M+",
    label: "Total distributed liquidity",
  },
];
---


<Section
  surface="alt"
  innerClass="flex flex-col gap-8 md:gap-14"
  {...Astro.props}
>
  <!-- Heading -->
  <header class="flex w-full flex-col items-center gap-3 text-center md:gap-4">
    <div
      class="
        rounded-[40px]
        border
        border-transparent
        dark:border-white
        bg-surface
        px-3.5
        py-1.5
      "
    >
      <span class="text-xs font-bold text-text-brand">
        WEALTH GENERATION
      </span>
    </div>

    <h2
      class="
        w-full
        max-w-[680px]
        text-center
        text-lg
        font-semibold
        text-ink

        md:text-display-sm

        lg:font-medium
      "
    >
      So how do I actually make money?
    </h2>

    <p
      class="
        w-full
        max-w-[680px]
        text-center
        text-sm
        font-normal
        leading-5
        text-ink-muted

        md:text-ink-secondary
      "
    >
      <span class="md:hidden">Three ways you'll be filling your bank</span>
      <span class="hidden md:inline">
        Three ways. Monthly rent, long-term appreciation, and the option to sell.
      </span>
    </p>
  </header>

  <!-- Metrics -->
  <div
    class="
      grid
      w-full
      grid-cols-1
      gap-4

      md:grid-cols-3
      md:gap-4
    "
  >
    {
      cards.map((card) => (
        <MetricCard {...card} />
      ))
    }
  </div>
</Section>  