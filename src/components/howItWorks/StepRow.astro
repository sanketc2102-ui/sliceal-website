---
/**
 * Alternating text/visual row. `reverse` flips sides at `lg`.
 * Content goes in the default slot, the visual in slot="visual".
 */
const { reverse = false, eyebrow, class: className = "" } = Astro.props;
---

<div
  class:list={[
    "flex flex-col items-center gap-10 rounded-[20px] bg-white px-3 pb-3 pt-5 shadow-[0_0_1px_rgba(0,0,0,0.25)]",
    "md:grid md:grid-cols-2 md:items-center md:gap-[60px] md:rounded-none md:bg-transparent md:px-0 md:py-0 md:shadow-none",
    "lg:grid lg:grid-cols-2 lg:items-center lg:gap-16 lg:rounded-none lg:bg-transparent lg:px-0 lg:py-0 lg:shadow-none",
    className,
  ]}
>
  <div
    class:list={[
      "flex flex-col items-center gap-4 text-center md:items-start md:gap-6 md:text-left lg:items-start lg:text-left",
      reverse && "md:order-2 lg:order-2",
    ]}
  >
    {eyebrow && (
      <div class="flex items-center gap-2">
        <span class="text-xs font-bold tracking-wide text-indigo-500 md:text-sm">
          {eyebrow}
        </span>
        <span class="h-px w-3.5 bg-indigo-500 md:w-8 lg:w-8 lg:bg-gray-200" aria-hidden="true"></span>
      </div>
    )}
    <slot />
  </div>

  <div class:list={["flex w-full items-center justify-center", reverse && "md:order-1 lg:order-1"]}>
    <slot name="visual" />
  </div>
</div>