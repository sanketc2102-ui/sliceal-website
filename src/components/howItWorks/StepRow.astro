---
/**
 * Alternating text/visual row. `reverse` flips sides at `lg`.
 * Content goes in the default slot, the visual in slot="visual".
 */
const { reverse = false, eyebrow, class: className = "" } = Astro.props;
---

<div
  class:list={[
    "grid grid-cols-1 items-center gap-8 lg:grid-cols-2 lg:gap-16",
    className,
  ]}
>
  <div class:list={["flex flex-col items-start gap-4", reverse && "lg:order-2"]}>
    {eyebrow && (
      <div class="flex items-center gap-2">
        <span class="text-xs font-bold tracking-wide text-indigo-500">
          {eyebrow}
        </span>
        <span class="h-px w-8 bg-gray-200" aria-hidden="true"></span>
      </div>
    )}
    <slot />
  </div>

  <div class:list={["flex w-full items-center justify-center", reverse && "lg:order-1"]}>
    <slot name="visual" />
  </div>
</div>