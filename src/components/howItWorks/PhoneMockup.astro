---
const { class: className = "" } = Astro.props;
---

<div
  class:list={[
    "relative mx-auto w-[240px] rounded-[2.25rem] border-[6px] border-gray-900 bg-gray-900 shadow-xl lg:w-[260px]",
    className,
  ]}
>
  <span
    class="absolute left-1/2 top-0 z-10 h-5 w-24 -translate-x-1/2 rounded-b-2xl bg-gray-900"
    aria-hidden="true"
  ></span>

  <div class="relative overflow-hidden rounded-[1.75rem] bg-white">
    <slot />
  </div>
</div>